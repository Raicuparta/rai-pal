import { Modal } from "modal.slint";

export component AboutPopup inherits Modal {
    in property <string> app-version;
    in property <string> renderer-name;
    in property <string> platform-name;

    title: "About Rai Pal";

    Text {
        text: "Version: \{root.app-version}";
    }

    Text {
        text: "Rendering backend: \{root.renderer-name}";
    }

    Text {
        text: "Platform: \{root.platform-name}";
    }
}
