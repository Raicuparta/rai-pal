import { Button, Palette } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export component AboutPopup inherits PopupWindow {
    in property <string> app-version;
    in property <string> renderer-name;

    width: Theme.about-popup-width;
    height: Theme.about-popup-height;
    close-policy: PopupClosePolicy.no-auto-close;

    Rectangle {
        background: Palette.background;
        border-width: Theme.border-width;
        border-color: Palette.border;
        border-radius: Theme.radius-8;

        VerticalLayout {
            padding: Theme.space-20;
            spacing: Theme.space-10;

            Text {
                text: "About Rai Pal";
                font-size: Theme.font-20;
                font-weight: Theme.weight-bold;
            }

            Text {
                text: "Version: \{root.app-version}";
            }

            Text {
                text: "Rendering backend: \{root.renderer-name}";
            }

            Rectangle {
                vertical-stretch: 1;
            }

            HorizontalLayout {
                alignment: end;

                Button {
                    text: "Close";

                    clicked => {
                        root.close();
                    }
                }
            }
        }
    }
}
