import { ScrollView } from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";
import { ModActions } from "../actions.slint";
import { Branding } from "../branding.slint";
import { PatronData } from "../patron-data.slint";
import { Theme } from "../theme.slint";
import { Sidebar } from "sidebar.slint";

component ThanksLink inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <brush> icon-color: Theme.foreground;
    in property <bool> icon-round: false;
    in property <string> url;

    preferred-width: link-layout.preferred-width;
    height: Theme.control-height;
    horizontal-stretch: 0;
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-action-default => {
        ModActions.open-url(root.url);
    }

    link-layout := HorizontalLayout {
        padding-left: Theme.space-8;
        padding-right: Theme.space-8;
        spacing: Theme.space-8;
        alignment: start;
        cross-axis-alignment: center;

        if root.icon-round : Rectangle {
            width: Theme.space-20;
            height: Theme.space-20;
            border-radius: Theme.space-10;
            clip: true;

            Image {
                source: root.icon;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }
        }

        if !root.icon-round : Image {
            source: root.icon;
            width: Theme.space-20;
            height: Theme.space-20;
            colorize: root.icon-color;
        }

        Text {
            text: root.label;
            color: touch.has-hover ? Theme.primary.brighter(0.5) : Theme.primary;
            font-size: Theme.font-16;
            font-weight: Theme.weight-bold;
            vertical-alignment: center;
        }

        IconDisplay {
            icon: IconSet.ExternalLink;
            size: Theme.icon-button-icon-size;
            stroke: Theme.dimmed-foreground;
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;

        clicked => {
            ModActions.open-url(root.url);
        }
    }
}

component PatronRow inherits Rectangle {
    in property <PatronData> patron;

    height: Theme.control-height;
    background: transparent;

    HorizontalLayout {
        spacing: Theme.space-8;
        alignment: start;
        cross-axis-alignment: center;

        Rectangle {
            width: Theme.control-height;
            height: Theme.control-height;
            border-radius: Theme.control-height / 2;
            clip: true;
            background: Theme.surface-background;

            if root.patron.has-avatar : Image {
                source: root.patron.avatar;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }

            if !root.patron.has-avatar : Text {
                text: root.patron.initials;
                font-size: Theme.font-12;
                font-weight: Theme.weight-bold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.patron.ranking <= 3 : IconDisplay {
            icon: IconSet.Trophy;
            size: Theme.icon-button-icon-size;
            stroke: root.patron.ranking == 1 ? Theme.highlight : Theme.dimmed-foreground;
        }

        Text {
            text: root.patron.name;
            horizontal-stretch: 1;
            vertical-alignment: center;
            font-weight: root.patron.ranking <= 3 ? Theme.weight-bold : Theme.weight-normal;
            overflow: elide;
        }
    }
}

export component ThanksPage inherits Rectangle {
    in property <[PatronData]> patrons;

    private property <length> content-max-width: 540px;
    private property <string> intro: @tr("thanksPage" => "Hello. I made Rai Pal. I also made other VR mods in the past, and am currently working on a universal VR mod for Unity games. If you like what I do, and would like to see more, please consider donating! You can also support me by buying one of my free mods on itch.io.");

    HorizontalLayout {
        Sidebar {
            VerticalLayout {
                padding-left: Theme.space-12;
                padding-right: Theme.space-12;
                spacing: Theme.space-6;
                alignment: start;

                Text {
                    text: @tr("thanksPage" => "Patreon Leaderboard");
                    font-weight: Theme.weight-bold;
                }

                Text {
                    text: @tr("thanksPage" => "Ranked by total lifetime donation amount.");
                    font-size: Theme.font-12;
                    opacity: 0.5;
                    wrap: word-wrap;
                }

                Text {
                    text: @tr("thanksPage" => "If you don't see yourself here, it's because your Patreon profile is private.");
                    font-size: Theme.font-12;
                    opacity: 0.5;
                    wrap: word-wrap;
                }

                for patron in root.patrons : PatronRow {
                    patron: patron;
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;

            ScrollView {
                VerticalLayout {
                    padding: Theme.space-20;
                    spacing: Theme.space-16;
                    alignment: start;

                    HorizontalLayout {
                        alignment: center;

                        Rectangle {
                            horizontal-stretch: 1;
                            max-width: root.content-max-width;

                            HorizontalLayout {
                                spacing: Theme.space-16;
                                alignment: start;

                                Rectangle {
                                    width: 120px;
                                    border-radius: Theme.radius-8;
                                    background: Theme.background;

                                    VerticalLayout {
                                        padding: Theme.space-12;
                                        spacing: Theme.space-8;
                                        alignment: start;
                                        cross-axis-alignment: center;

                                        Rectangle {
                                            width: 72px;
                                            height: 72px;
                                            border-radius: 36px;
                                            clip: true;

                                            Image {
                                                source: @image-url("../images/raicuparta.png");
                                                width: 100%;
                                                height: 100%;
                                                image-fit: cover;
                                            }
                                        }

                                        Text {
                                            text: "Raicuparta";
                                            font-size: Theme.font-16;
                                            font-weight: Theme.weight-semibold;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: Theme.space-12;
                                    alignment: start;

                                    Rectangle {
                                        height: intro-layout.preferred-height;
                                        vertical-stretch: 0;
                                        background: Theme.surface-background;
                                        border-width: Theme.border-width;
                                        border-color: Theme.border;
                                        border-radius: Theme.radius-8;

                                        intro-layout := VerticalLayout {
                                            padding: Theme.space-16;

                                            Text {
                                                text: root.intro;
                                                font-size: Theme.font-16;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: Theme.space-2;
                                        alignment: start;

                                        ThanksLink {
                                            label: "raicuparta.com";
                                            icon: @image-url("../images/raicuparta.png");
                                            icon-round: true;
                                            url: "https://raicuparta.com";
                                        }

                                        ThanksLink {
                                            label: @tr("thanksPage" => "Star Rai Pal on GitHub");
                                            icon: @image-url("../icons/brands/github.svg");
                                            icon-color: Branding.brand-color("GitHub");
                                            url: "https://github.com/raicuparta/rai-pal";
                                        }

                                        ThanksLink {
                                            label: "Patreon";
                                            icon: @image-url("../icons/brands/patreon.svg");
                                            icon-color: Branding.brand-color("Patreon");
                                            url: "https://www.patreon.com/raivr";
                                        }

                                        ThanksLink {
                                            label: "Paypal";
                                            icon: @image-url("../icons/brands/paypal.svg");
                                            icon-color: Branding.brand-color("Paypal");
                                            url: "https://paypal.me/raicuparta/5usd";
                                        }

                                        ThanksLink {
                                            label: "Itch.io";
                                            icon: @image-url("../icons/providers/itch.svg");
                                            icon-color: Branding.provider-color("Itch");
                                            url: "https://raicuparta.itch.io/";
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
