import { Button, Palette, ScrollView } from "std-widgets.slint";
import { ProviderActionItem } from "../provider-action-item.slint";
import { Tr } from "../translations.slint";

export component GameSidebar inherits Rectangle {
    in property <string> provider-id;
    in property <bool> can-run-game;
    in property <bool> has-exe-path;
    in property <bool> show-wine-folders;
    in property <[ProviderActionItem]> provider-actions;

    callback back;
    callback run-game;
    callback run-provider-action(value: string);
    callback open-game-folder;
    callback open-game-mods-folder;
    callback open-game-data-folder;
    callback open-wine-prefix-folder;
    callback open-wine-binary-folder;
    callback refresh-game;
    callback debug-data;

    width: 260px;
    background: Palette.alternate-background;

    ScrollView {
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            alignment: start;

            Button {
                text: @tr("subPage" => "Back");

                clicked => {
                    root.back();
                }
            }

            if root.can-run-game : Button {
                text: @tr("gameModal" => "Start Game");
                primary: true;

                clicked => {
                    root.run-game();
                }
            }

            if root.provider-actions.length > 0 : VerticalLayout {
                alignment: start;
                spacing: 2px;

                Text {
                    text: root.provider-id;
                    font-weight: 700;
                }

                for action in root.provider-actions : Button {
                    text: Tr.provider-command(action.value);

                    clicked => {
                        root.run-provider-action(action.value);
                    }
                }
            }

            if root.has-exe-path : VerticalLayout {
                alignment: start;
                spacing: 2px;

                Text {
                    text: @tr("gameModal" => "Folders");
                    font-weight: 700;
                }

                Button {
                    text: @tr("gameModal" => "Game Files");

                    clicked => {
                        root.open-game-folder();
                    }
                }

                Button {
                    text: @tr("gameModal" => "Installed Mods");

                    clicked => {
                        root.open-game-mods-folder();
                    }
                }

                Button {
                    text: @tr("gameModal" => "Game App Data");

                    clicked => {
                        root.open-game-data-folder();
                    }
                }

                if root.show-wine-folders : Button {
                    text: @tr("gameModal" => "Wine Prefix");

                    clicked => {
                        root.open-wine-prefix-folder();
                    }
                }

                if root.show-wine-folders : Button {
                    text: @tr("gameModal" => "Wine Binary");

                    clicked => {
                        root.open-wine-binary-folder();
                    }
                }
            }

            VerticalLayout {
                alignment: start;
                spacing: 2px;

                Text {
                    text: "Data";
                    font-weight: 700;
                }

                if root.has-exe-path : Button {
                    text: @tr("gameModal" => "Refresh game");

                    clicked => {
                        root.refresh-game();
                    }
                }

                Button {
                    text: @tr("debugData" => "Debug data");

                    clicked => {
                        root.debug-data();
                    }
                }
            }
        }
    }
}
