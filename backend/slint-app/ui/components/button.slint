import { Icon, IconDisplay, IconSet } from "@lucide";
import { ActionState } from "../action-state.slint";
import { Theme } from "../theme.slint";

global ButtonOutlines {
    out property <brush> on-light-fill: Theme.dark ? @linear-gradient(180deg, #FFFFFF14 90.67%, #00000024 100%) : @linear-gradient(180deg, #0000000F 90.58%, #00000029 100%);
    out property <brush> on-dark-fill: Theme.dark ? @linear-gradient(180deg, #FFFFFF17 0%, #00000012 8.33%) : @linear-gradient(180deg, #FFFFFF14 90.67%, #00000066 100%);
}

export component Button inherits Rectangle {
    in property <brush> tint: Theme.surface-background;
    in property <string> text: "";
    in property <string> tooltip: "";
    in property <Icon> icon;
    in property <length> text-size: Theme.font-14;
    in property <length> horizontal-padding: Theme.space-12;
    in property <length> content-spacing: Theme.space-6;
    in property <bool> enabled: true;
    in property <ActionState> state: ActionState.idle;
    out property <bool> hovered: touch-area.has-hover;

    private property <bool> icon-only: root.text == "";
    private property <bool> long-loading: false;
    private property <angle> spinner-angle: mod(animation-tick(), 1s) / 1s * 360deg;
    private property <bool> interactive: root.enabled && root.state != ActionState.loading;
    private property <bool> has-status: root.state == ActionState.success || root.state == ActionState.error;
    private property <bool> shows-spinner: root.state == ActionState.loading && root.long-loading;
    private property <Icon> display-icon: root.state == ActionState.success ? IconSet.CircleCheck : root.state == ActionState.error ? IconSet.CircleX : root.shows-spinner ? IconSet.LoaderCircle : root.icon;

    private property <brush> base-color: root.state == ActionState.success ? Theme.status-success : root.state == ActionState.error ? Theme.status-error : root.tint;
    private property <bool> needs-dark-ink: root.base-color.to-oklch().lightness > 0.62;
    private property <brush> ink: root.needs-dark-ink ? #1a1b1e : #ffffff;
    private property <brush> hover-fill: root.needs-dark-ink ? root.base-color.darker(0.08) : root.base-color.brighter(0.2);
    private property <brush> pressed-fill: root.needs-dark-ink ? root.base-color.darker(0.16) : root.base-color.brighter(0.4);
    private property <brush> fill: !root.enabled ? transparent : touch-area.pressed ? root.pressed-fill : touch-area.has-hover ? root.hover-fill : root.base-color;
    private property <brush> outline: root.enabled ? (root.needs-dark-ink ? ButtonOutlines.on-light-fill : ButtonOutlines.on-dark-fill) : transparent;
    private property <brush> ink-color: root.enabled ? root.ink : root.ink.transparentize(0.75);

    callback clicked;

    height: Theme.control-height;
    min-width: root.icon-only ? 0px : 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.radius-8;
    border-width: Theme.border-width;
    border-color: root.outline;
    background: root.fill;
    forward-focus: focus-scope;

    accessible-role: button;
    accessible-enabled: root.interactive;
    accessible-label: root.text;
    accessible-action-default => {
        if root.interactive {
            root.clicked();
        }
    }

    changed state => {
        root.long-loading = false;
    }

    loading-timer := Timer {
        interval: 500ms;
        running: root.state == ActionState.loading && !root.long-loading;

        triggered => {
            root.long-loading = true;
        }
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: root.icon-only ? 0px : root.horizontal-padding;
        padding-right: root.icon-only ? 0px : root.horizontal-padding;
        spacing: root.content-spacing;
        alignment: center;
        cross-axis-alignment: center;

        if root.icon-only || root.has-status || root.shows-spinner : IconDisplay {
            icon: root.display-icon;
            size: Theme.icon-button-icon-size;
            stroke: root.ink-color;
            transform-rotation: root.shows-spinner ? root.spinner-angle : 0deg;
        }

        if root.text != "" : Text {
            text: root.text;
            font-size: root.text-size;
            color: root.ink-color;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch-area := TouchArea {
        enabled: root.interactive;

        clicked => {
            root.clicked();
        }
    }

    focus-scope := FocusScope {
        width: 0;
        height: 0;
        enabled: root.enabled;

        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                if root.interactive {
                    root.clicked();
                }
                return accept;
            }

            return reject;
        }
    }

    if root.tooltip != "" : Tooltip {
        text: @markdown("\{root.tooltip}");
    }
}
