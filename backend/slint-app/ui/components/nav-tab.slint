import { Theme } from "../theme.slint";
import { SvgIcon } from "svg-icon.slint";

export component NavTab inherits Rectangle {
    in property <string> title;
    in property <image> icon;
    in property <brush> icon-color: Theme.foreground;
    in property <bool> selected;

    callback clicked;

    preferred-width: layout.preferred-width;
    preferred-height: layout.preferred-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    background: touch-area.pressed ? Theme.pressed-background : touch-area.has-hover ? Theme.hover-background : transparent;

    layout := HorizontalLayout {
        padding-left: Theme.space-16;
        padding-right: Theme.space-16;
        padding-top: Theme.space-10;
        padding-bottom: Theme.space-10;
        spacing: Theme.space-10;
        cross-axis-alignment: center;

        SvgIcon {
            source: root.icon;
            size: 24px;
            color: root.icon-color;
        }

        Text {
            text: root.title;
            color: Theme.foreground;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    if root.selected : Rectangle {
        y: parent.height - self.height;
        height: 2px;
        background: Theme.primary;
    }

    touch-area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}
