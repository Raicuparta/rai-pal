import { Icon, IconDisplay } from "@lucide";
import { Theme } from "../theme.slint";

export component NavTab inherits Rectangle {
    in property <string> title;
    in property <Icon> icon;
    in property <brush> icon-color: Theme.foreground;
    in property <bool> selected;

    callback clicked;

    preferred-width: layout.preferred-width;
    preferred-height: layout.preferred-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    background: touch-area.pressed ? Theme.pressed-background : touch-area.has-hover ? Theme.hover-background : transparent;
    border-radius: Theme.radius-4;

    layout := HorizontalLayout {
        padding-left: Theme.space-16;
        padding-right: Theme.space-16;
        padding-top: Theme.space-10;
        padding-bottom: Theme.space-10;
        spacing: Theme.space-10;
        cross-axis-alignment: center;

        IconDisplay {
            icon: root.icon;
            size: Theme.nav-tab-icon-size;
            stroke: root.icon-color;
            stroke-width: 2;
        }

        Text {
            text: root.title;
            color: Theme.foreground;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    if root.selected : Rectangle {
        y: parent.height - self.height;
        height: Theme.active-tab-indicator-height;
        background: Theme.primary;
    }

    touch-area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}
