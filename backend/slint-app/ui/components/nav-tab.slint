import { Theme } from "../theme.slint";

export component NavTab inherits Rectangle {
    in property <string> title;
    in property <bool> selected;

    callback clicked;

    preferred-width: layout.preferred-width;
    preferred-height: layout.preferred-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    background: touch-area.pressed ? Theme.pressed-background : touch-area.has-hover ? Theme.hover-background : transparent;
    border-radius: Theme.radius-4;

    layout := HorizontalLayout {
        padding-left: Theme.space-12;
        padding-right: Theme.space-12;
        padding-top: Theme.space-8;
        padding-bottom: Theme.space-8;

        Text {
            text: root.title;
            color: root.selected ? Theme.foreground : Theme.dimmed-foreground;
            font-weight: root.selected ? Theme.weight-semibold : Theme.weight-normal;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    if root.selected : Rectangle {
        y: parent.height - self.height;
        height: Theme.active-tab-indicator-height;
        background: Theme.primary;
    }

    touch-area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}
