import { IconDisplay, IconSet } from "@lucide";
import { ModsTabItemData } from "../mods-tab-data.slint";
import { Theme } from "../theme.slint";
import { ModsTabRowView } from "mods-tab-row.slint";

export component ModsTabFamilyRowView inherits Rectangle {
    in property <ModsTabItemData> item;

    property <bool> expanded: false;

    vertical-stretch: 0;

    VerticalLayout {
        alignment: start;
        spacing: Theme.space-2;

        header := Rectangle {
            height: max(Theme.game-mod-row-height, header-content.preferred-height);
            background: header-touch.has-hover ? Theme.hover-background : transparent;

            header-content := HorizontalLayout {
                padding: Theme.space-6;
                spacing: Theme.space-8;
                cross-axis-alignment: center;

                IconDisplay {
                    icon: root.expanded ? IconSet.ChevronDown : IconSet.ChevronRight;
                    size: Theme.space-16;
                    stroke: Theme.dimmed-foreground;
                    stroke-width: 2;
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: start;
                    spacing: Theme.space-2;

                    Text {
                        text: root.item.family-title;
                        font-size: Theme.font-16;
                        font-weight: Theme.weight-bold;
                        overflow: elide;
                    }

                    if root.item.family-description != "" : Text {
                        text: root.item.family-description;
                        font-size: Theme.font-12;
                        opacity: 0.75;
                        wrap: word-wrap;
                    }
                }
            }

            header-touch := TouchArea {
                clicked => {
                    root.expanded = !root.expanded;
                }
            }
        }

        if root.expanded : VerticalLayout {
            alignment: start;
            spacing: 0px;

            for mod-row in root.item.mods : ModsTabRowView {
                mod-data: mod-row;
                indented: true;
            }
        }
    }
}
