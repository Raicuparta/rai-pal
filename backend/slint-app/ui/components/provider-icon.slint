import { IconDisplay, IconSet } from "@lucide";
import { Branding } from "../branding.slint";
import { Theme } from "../theme.slint";

export component ProviderIcon inherits Rectangle {
    in property <string> provider-id;
    in property <length> icon-size: Theme.space-16;

    width: root.icon-size;
    height: root.icon-size;

    if provider-id == "Amazon" : IconDisplay {
        icon: IconSet.ShoppingCart;
        size: root.icon-size;
        stroke: Branding.provider-color(provider-id);
        stroke-width: 1.5;
    }

    if provider-id == "Steam" : Image {
        source: @image-url("../icons/providers/steam.svg");
        colorize: Branding.provider-color(provider-id);
        width: 100%;
        height: 100%;
    }

    if provider-id == "Epic" : Image {
        source: @image-url("../icons/providers/epic.svg");
        colorize: Branding.provider-color(provider-id);
        width: 100%;
        height: 100%;
    }

    if provider-id == "Gog" : Image {
        source: @image-url("../icons/providers/gog.svg");
        colorize: Branding.provider-color(provider-id);
        width: 100%;
        height: 100%;
    }

    if provider-id == "Itch" : Image {
        source: @image-url("../icons/providers/itch.svg");
        colorize: Branding.provider-color(provider-id);
        width: 100%;
        height: 100%;
    }

    if provider-id == "Xbox" : Image {
        source: @image-url("../icons/providers/xbox.svg");
        colorize: Branding.provider-color(provider-id);
        width: 100%;
        height: 100%;
    }

    if provider-id == "Manual" : IconDisplay {
        icon: IconSet.Gamepad2;
        size: root.icon-size;
        stroke: Branding.provider-color(provider-id);
        stroke-width: 1.5;
    }
}
