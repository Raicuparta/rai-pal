import { Button } from "button.slint";
import { AddGamePhase } from "../app-types.slint";
import { Fonts, Theme } from "../theme.slint";
import { Modal } from "modal.slint";

component SavedDirectoryRow inherits Rectangle {
    in property <string> path;

    callback removed;

    HorizontalLayout {
        spacing: Theme.space-6;
        cross-axis-alignment: center;

        Rectangle {
            horizontal-stretch: 1;
            border-radius: Theme.radius-4;
            background: Theme.surface-background;

            Text {
                text: root.path;
                font-family: Fonts.monospace-family;
                font-size: Theme.font-12;
                vertical-alignment: center;
                x: Theme.space-8;
                width: parent.width - Theme.space-16;
                overflow: elide;
            }
        }

        Button {
            text: @tr("manualGames" => "Remove");

            clicked => {
                root.removed();
            }
        }
    }
}

export component AddGamePopup inherits Modal {
    in property <AddGamePhase> phase: idle;
    in property <string> selected-path;
    in property <int> scanned-dirs;
    in property <int> executables-found;
    in property <string> current-path;
    in property <int> games-count;
    in property <string> duration-text;
    in property <[string]> directories;

    callback select-executable;
    callback select-directory;
    callback cancel-scan;
    callback confirm-directory;
    callback remove-directory(path: string);

    title: @tr("manualGames" => "Manually Added Games");

    Text {
        text: @tr("manualGames" => "Note: you can also add your non-Steam games to Steam, and they will still be detected by Rai Pal.");
        font-size: Theme.font-12;
        opacity: 0.7;
        wrap: word-wrap;
    }

    if root.phase == AddGamePhase.idle : VerticalLayout {
        spacing: Theme.space-10;

        Button {
            text: @tr("manualGames" => "Select game executable");
            tint: Theme.primary;
            height: Theme.control-height;

            clicked => {
                root.select-executable();
            }
        }

        Button {
            text: @tr("manualGames" => "Select game directory. Can be slow!");
            height: Theme.control-height;

            clicked => {
                root.select-directory();
            }
        }

        Text {
            text: @tr("manualGames" => "You can also just drop game executable files or entire folders anywhere on Rai Pal's window to add them to the library, even without opening this dialog.");
            font-size: Theme.font-12;
            opacity: 0.7;
            wrap: word-wrap;
        }
    }

    if root.phase == AddGamePhase.scanning : VerticalLayout {
        spacing: Theme.space-10;
        alignment: start;

        Text {
            text: @tr("manualGames" => "Scanning {0}...", root.selected-path);
            font-weight: Theme.weight-bold;
            wrap: word-wrap;
        }

        Text {
            text: @tr("manualGames" => "Scanned {0} directories, found {1} executables", root.scanned-dirs, root.executables-found);
        }

        Text {
            text: root.current-path;
            font-family: Fonts.monospace-family;
            font-size: Theme.font-12;
            opacity: 0.7;
            overflow: elide;
        }

        Button {
            text: @tr("manualGames" => "Cancel");
            height: Theme.control-height;

            clicked => {
                root.cancel-scan();
            }
        }
    }

    if root.phase == AddGamePhase.confirming : VerticalLayout {
        spacing: Theme.space-10;
        alignment: start;

        Text {
            text: @tr("manualGames" => "Found {0} executables in {1} seconds. Add this folder to Rai Pal?", root.games-count, root.duration-text);
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: Theme.space-8;

            Button {
                text: @tr("manualGames" => "Add folder");
                tint: Theme.primary;

                clicked => {
                    root.confirm-directory();
                }
            }

            Button {
                text: @tr("manualGames" => "Cancel");

                clicked => {
                    root.cancel-scan();
                }
            }
        }
    }

    if root.phase == AddGamePhase.idle && root.directories.length > 0 : VerticalLayout {
        spacing: Theme.space-8;

        Rectangle {
            height: Theme.border-width;
            background: Theme.border;
        }

        Text {
            text: @tr("manualGames" => "These directories will be scanned recursively every time Rai Pal refreshes its data. Large folders may make things significantly slower.");
            font-size: Theme.font-12;
            opacity: 0.7;
            wrap: word-wrap;
        }

        for directory in root.directories : SavedDirectoryRow {
            path: directory;

            removed => {
                root.remove-directory(directory);
            }
        }
    }
}
