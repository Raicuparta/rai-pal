import { IconDisplay, IconSet } from "@lucide";
import { CheckBox } from "std-widgets.slint";
import { FilterGroupData, FilterValueData } from "../filter-data.slint";
import { Tr } from "../translations.slint";
import { Theme } from "../theme.slint";
import { IconButton } from "icon-button.slint";

global FilterMetrics {
    out property <length> row-height: 26px;
    out property <length> only-button-width: 40px;
    out property <length> only-button-height: 22px;
    out property <length> locked-indicator-size: 6px;
}

component FilterValueRow inherits Rectangle {
    in property <FilterValueData> item;

    callback toggled(checked: bool);
    callback lock-toggled;
    callback only;

    property <bool> hovered: row-touch.has-hover || checkbox-touch.has-hover || only-button.hovered || lock-button.hovered;

    height: FilterMetrics.row-height;
    background: hovered ? Theme.hover-background : transparent;

    row-touch := TouchArea { }

    HorizontalLayout {
        padding-left: Theme.space-20 + Theme.space-4;
        padding-right: Theme.space-8;
        spacing: Theme.space-4;
        cross-axis-alignment: center;

        checkbox-area := Rectangle {
            horizontal-stretch: 1;
            height: 100%;

            check-box := CheckBox {
                x: 0;
                y: (parent.height - self.height) / 2;
                text: root.item.label-key == "" ? root.item.label : Tr.filter-value(root.item.label-key);
                checked: root.item.enabled;
                enabled: !root.item.locked;
            }

            checkbox-touch := TouchArea {
                width: root.item.note-label-key == "" ? parent.width : check-box.preferred-width;
                height: parent.height;

                clicked => {
                    if !root.item.locked {
                        root.toggled(!root.item.enabled);
                    }
                }
            }

            if root.item.note-label-key != "" : Rectangle {
                x: check-box.preferred-width + Theme.space-4;
                y: (parent.height - self.height) / 2;
                width: Theme.icon-button-icon-size;
                height: Theme.icon-button-icon-size;

                IconDisplay {
                    icon: IconSet.CircleHelp;
                    size: Theme.icon-button-icon-size;
                    stroke: Theme.dimmed-foreground;
                }

                Tooltip {
                    text: @markdown("\{Tr.filter-value-note(root.item.note-label-key)}");
                }
            }
        }

        only-button := IconButton {
            width: FilterMetrics.only-button-width;
            height: FilterMetrics.only-button-height;
            label: "Only";
            tooltip: @tr("filterMenu" => "Only show this value");
            visible: !root.item.locked;
            active: !root.item.locked;
            opacity: root.hovered ? 1 : 0;
            icon-color: root.item.locked ? Theme.dimmed-foreground : Theme.foreground;

            clicked => {
                root.only();
            }
        }

        lock-button := IconButton {
            icon: root.item.locked ? IconSet.Lock : IconSet.LockOpen;
            tooltip: root.item.locked ? @tr("filterMenu" => "Unlock filter value") : @tr("filterMenu" => "Lock filter value");
            visible: (root.item.locked || root.hovered) && !root.item.enabled;
            active: !root.item.enabled;
            selected: root.item.locked;

            clicked => {
                root.lock-toggled();
            }
        }
    }
}

export component FilterGroupView inherits Rectangle {
    in property <FilterGroupData> group;

    callback toggled(value: string, checked: bool);
    callback lock-toggled(value: string);
    callback only(value: string);
    callback reset;
    callback expanded-changed(expanded: bool);

    VerticalLayout {
        alignment: start;
        spacing: Theme.border-width;

        header := Rectangle {
            property <bool> hovered: header-touch.has-hover || reset-button.hovered;

            height: FilterMetrics.row-height;
            background: hovered ? Theme.hover-background : transparent;

            header-touch := TouchArea {
                clicked => {
                    root.expanded-changed(!root.group.expanded);
                }
            }

            HorizontalLayout {
                padding-left: Theme.space-8;
                padding-right: Theme.space-8;
                spacing: Theme.space-4;
                cross-axis-alignment: center;

                Rectangle {
                    width: Theme.icon-button-size;
                    height: Theme.icon-button-size;

                    IconDisplay {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon: root.group.expanded ? IconSet.ChevronDown : IconSet.ChevronRight;
                        size: Theme.icon-button-icon-size;
                        stroke: Theme.dimmed-foreground;
                    }
                }

                Text {
                    text: root.group.label-key == "" ? root.group.label : Tr.filter-property(root.group.label-key);
                    font-weight: Theme.weight-bold;
                    overflow: elide;
                }

                if root.group.has-locked : Rectangle {
                    width: FilterMetrics.locked-indicator-size;
                    height: FilterMetrics.locked-indicator-size;
                    border-radius: FilterMetrics.locked-indicator-size / 2;
                    background: Theme.highlight;
                }

                reset-button := IconButton {
                    icon: IconSet.RotateCcw;
                    tooltip: @tr("filterMenu" => "Reset");
                    active: root.group.has-changes;
                    icon-color: root.group.has-changes ? Theme.primary : Theme.foreground;

                    clicked => {
                        root.reset();
                    }
                }
            }
        }

        if root.group.expanded : VerticalLayout {
            alignment: start;
            spacing: 0px;

            for value in root.group.values : FilterValueRow {
                item: value;

                toggled(checked) => {
                    root.toggled(value.value, checked);
                }

                lock-toggled => {
                    root.lock-toggled(value.value);
                }

                only => {
                    root.only(value.value);
                }
            }
        }
    }
}
