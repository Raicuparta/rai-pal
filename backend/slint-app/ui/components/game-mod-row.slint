import { IconSet } from "@lucide";
import { Button } from "std-widgets.slint";
import { ModActions } from "../actions.slint";
import { GameModRowData } from "../game-mod-row-data.slint";
import { Theme } from "../theme.slint";
import { IconButton } from "icon-button.slint";
import { ModSummaryView } from "mod-summary.slint";

export component GameModRowView inherits Rectangle {
    in property <GameModRowData> game-mod;

    property <bool> interactive: !game-mod.incompatible;
    property <bool> has-dropdown-actions: game-mod.can-edit-config || game-mod.can-open-mod-folder || game-mod.can-download-config || game-mod.can-reinstall || game-mod.can-uninstall;

    vertical-stretch: 0;
    height: max(Theme.game-mod-row-height, content.preferred-height);
    background: interactive && row-touch.has-hover ? Theme.hover-background : transparent;

    context-menu := ContextMenuArea {
        Menu {
            if game-mod.can-edit-config : MenuItem {
                title: @tr("gameModRow" => "Edit Mod Config");

                activated => {
                    ModActions.configure(game-mod.mod-id);
                }
            }

            if game-mod.can-edit-config : MenuItem {
                title: @tr("gameModRow" => "Open folder containing this mod's config files");

                activated => {
                    ModActions.configure-folder(game-mod.mod-id);
                }
            }

            if game-mod.can-edit-config : MenuSeparator { }

            if game-mod.can-open-mod-folder : MenuItem {
                title: @tr("gameModRow" => "Open Mod Folder");

                activated => {
                    ModActions.open-folder(game-mod.mod-id);
                }
            }

            if game-mod.can-download-config : MenuItem {
                title: @tr("gameModRow" => "Download Recommended Config");

                activated => {
                    ModActions.download-config(game-mod.mod-id);
                }
            }

            if game-mod.can-download-config : MenuSeparator { }

            if game-mod.can-reinstall : MenuItem {
                title: @tr("gameModRow" => "Reinstall");

                activated => {
                    ModActions.reinstall(game-mod.mod-id);
                }
            }

            if game-mod.can-uninstall : MenuItem {
                title: @tr("gameModRow" => "Uninstall");
                enabled: !game-mod.has-installed-dependants;

                activated => {
                    ModActions.uninstall(game-mod.mod-id);
                }
            }
        }

        row-touch := TouchArea { }

        content := HorizontalLayout {
            padding: Theme.space-6;
            spacing: Theme.space-8;
            cross-axis-alignment: center;

            ModSummaryView {
                horizontal-stretch: 1;
                title: game-mod.title;
                description: game-mod.description;
                version-text: game-mod.version-text;
                release-date: game-mod.release-date;
                author: game-mod.author;
                engine-text: game-mod.engine-text;
                deprecated: game-mod.deprecated;
                has-remote-config: game-mod.has-remote-config;
                show-status: game-mod.show-status;
                installed: game-mod.installed;
                outdated: game-mod.outdated;
            }

            if game-mod.can-show-actions : HorizontalLayout {
                alignment: end;
                spacing: Theme.space-4;

                if game-mod.can-install : Button {
                    text: @tr("gameModRow" => "Install");
                    height: Theme.action-button-height;

                    clicked => {
                        ModActions.request-install(
                            game-mod.mod-id,
                            @tr("gameModRow" => "Attention: be careful when installing mods on multiplayer games! Anticheat can detect some mods and get you banned, even if the mods seem harmless."),
                            @tr("gameModRow" => "Install"),
                            "install-mod-confirm",
                        );
                    }
                }

                if game-mod.can-update : Button {
                    text: @tr("gameModRow" => "Update");
                    height: Theme.action-button-height;

                    clicked => {
                        ModActions.update(game-mod.mod-id);
                    }
                }

                if game-mod.can-run : Button {
                    text: @tr("gameModRow" => "Run");
                    height: Theme.action-button-height;

                    clicked => {
                        ModActions.run(game-mod.mod-id);
                    }
                }

                actions-button := IconButton {
                    visible: root.has-dropdown-actions;
                    icon: IconSet.Ellipsis;

                    clicked => {
                        context-menu.show({
                            x: actions-button.absolute-position.x - root.absolute-position.x,
                            y: actions-button.absolute-position.y - root.absolute-position.y + actions-button.height,
                        });
                    }
                }
            }
        }
    }
}
