import { IconDisplay, IconSet } from "@lucide";
import { Button, Palette } from "std-widgets.slint";
import { GameModRowData } from "../game-mod-row-data.slint";
import { IconButton } from "icon-button.slint";

export component GameModRowView inherits Rectangle {
    in property <GameModRowData> game-mod;

    callback install(mod-id: string);
    callback uninstall(mod-id: string);
    callback update(mod-id: string);
    callback reinstall(mod-id: string);
    callback run(mod-id: string);
    callback open-folder(mod-id: string);
    callback download-config(mod-id: string);
    callback configure(mod-id: string);
    callback configure-folder(mod-id: string);

    property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    property <bool> interactive: game-mod.section != "incompatible";
    property <bool> has-details: game-mod.version-text != "" || game-mod.release-date != "" || game-mod.author != "" || game-mod.engine-text != "";
    property <bool> has-dropdown-actions: game-mod.can-edit-config || game-mod.can-open-mod-folder || game-mod.can-download-config || game-mod.can-reinstall || game-mod.can-uninstall;

    function status-orange() -> brush {
        return dark ? #ffa94d : #e8590c;
    }

    function status-green() -> brush {
        return dark ? #69db7c : #2b8a3e;
    }

    function deprecated-background() -> brush {
        return dark ? #3d2b12 : #fff9db;
    }

    function deprecated-foreground() -> brush {
        return dark ? #ffd43b : #e67700;
    }

    vertical-stretch: 0;
    height: max(56px, content.preferred-height);
    background: interactive && row-touch.has-hover ? Palette.alternate-background : transparent;

    context-menu := ContextMenuArea {
        width: 100%;
        height: 100%;

        Menu {
            if game-mod.can-edit-config : MenuItem {
                title: @tr("gameModRow" => "Edit Mod Config");

                activated => {
                    root.configure(game-mod.mod-id);
                }
            }

            if game-mod.can-edit-config : MenuItem {
                title: @tr("gameModRow" => "Open folder containing this mod's config files");

                activated => {
                    root.configure-folder(game-mod.mod-id);
                }
            }

            if game-mod.can-edit-config : MenuSeparator { }

            if game-mod.can-open-mod-folder : MenuItem {
                title: @tr("gameModRow" => "Open Mod Folder");

                activated => {
                    root.open-folder(game-mod.mod-id);
                }
            }

            if game-mod.can-download-config : MenuItem {
                title: @tr("gameModRow" => "Download Recommended Config");

                activated => {
                    root.download-config(game-mod.mod-id);
                }
            }

            if game-mod.can-download-config : MenuSeparator { }

            if game-mod.can-reinstall : MenuItem {
                title: @tr("gameModRow" => "Reinstall");

                activated => {
                    root.reinstall(game-mod.mod-id);
                }
            }

            if game-mod.can-uninstall : MenuItem {
                title: @tr("gameModRow" => "Uninstall");
                enabled: !game-mod.has-installed-dependants;

                activated => {
                    root.uninstall(game-mod.mod-id);
                }
            }
        }

        row-touch := TouchArea { }

        content := HorizontalLayout {
            padding: 6px;
            spacing: 8px;
            cross-axis-alignment: center;

            if game-mod.show-status && game-mod.outdated : IconDisplay {
                icon: IconSet.CircleAlert;
                size: 15px;
                stroke: status-orange();
                stroke-width: 2;
            }

            if game-mod.show-status && game-mod.installed && !game-mod.outdated : IconDisplay {
                icon: IconSet.CircleCheck;
                size: 15px;
                stroke: status-green();
                stroke-width: 2;
            }

            if game-mod.show-status && !game-mod.installed && !game-mod.outdated : IconDisplay {
                icon: IconSet.CircleMinus;
                size: 15px;
                stroke: Palette.alternate-foreground;
                stroke-width: 2;
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;

                HorizontalLayout {
                    spacing: 6px;
                    cross-axis-alignment: center;

                    Text {
                        text: game-mod.title;
                        font-weight: 600;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    if game-mod.has-remote-config : IconDisplay {
                        icon: IconSet.Settings;
                        size: 14px;
                        stroke: Palette.foreground;
                        stroke-width: 2;
                        opacity: 0.75;
                    }

                    if game-mod.deprecated : Rectangle {
                        width: deprecated-content.preferred-width + 8px;
                        height: 18px;
                        border-radius: 3px;
                        background: deprecated-background();

                        deprecated-content := HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            spacing: 3px;
                            alignment: center;

                            IconDisplay {
                                icon: IconSet.TriangleAlert;
                                size: 11px;
                                stroke: deprecated-foreground();
                                stroke-width: 2;
                            }

                            Text {
                                text: @tr("modsPage" => "Deprecated");
                                font-size: 10px;
                                font-weight: 700;
                                color: deprecated-foreground();
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                if root.has-details : HorizontalLayout {
                    opacity: 0.4;
                    spacing: 10px;
                    cross-axis-alignment: center;

                    if game-mod.version-text != "" : Text {
                        text: game-mod.version-text;
                        font-size: 11px;
                        color: Palette.foreground;
                    }

                    if game-mod.release-date != "" : HorizontalLayout {
                        spacing: 2px;
                        cross-axis-alignment: center;

                        IconDisplay {
                            icon: IconSet.Calendar;
                            size: 10px;
                            stroke: Palette.foreground;
                            stroke-width: 2;
                        }

                        Text {
                            text: game-mod.release-date;
                            font-size: 11px;
                            color: Palette.foreground;
                        }
                    }

                    if game-mod.author != "" : HorizontalLayout {
                        spacing: 2px;
                        cross-axis-alignment: center;

                        IconDisplay {
                            icon: IconSet.UserRound;
                            size: 10px;
                            stroke: Palette.foreground;
                            stroke-width: 2;
                        }

                        Text {
                            text: game-mod.author;
                            font-size: 11px;
                            color: Palette.foreground;
                        }
                    }

                    if game-mod.engine-text != "" : HorizontalLayout {
                        spacing: 2px;
                        cross-axis-alignment: center;

                        IconDisplay {
                            icon: IconSet.Cpu;
                            size: 10px;
                            stroke: Palette.foreground;
                            stroke-width: 2;
                        }

                        Text {
                            text: game-mod.engine-text;
                            font-size: 11px;
                            color: Palette.foreground;
                        }
                    }
                }

                if game-mod.description != "" : Text {
                    text: game-mod.description;
                    font-size: 12px;
                    opacity: 0.75;
                    wrap: word-wrap;
                    color: Palette.foreground;
                }
            }

            if game-mod.can-show-actions : HorizontalLayout {
                alignment: end;
                spacing: 4px;

                if game-mod.can-install : Button {
                    text: @tr("gameModRow" => "Install");
                    height: 28px;

                    clicked => {
                        root.install(game-mod.mod-id);
                    }
                }

                if game-mod.can-update : Button {
                    text: @tr("gameModRow" => "Update");
                    height: 28px;

                    clicked => {
                        root.update(game-mod.mod-id);
                    }
                }

                if game-mod.can-run : Button {
                    text: @tr("gameModRow" => "Run");
                    height: 28px;

                    clicked => {
                        root.run(game-mod.mod-id);
                    }
                }

                actions-button := IconButton {
                    visible: root.has-dropdown-actions;
                    icon: IconSet.Ellipsis;

                    clicked => {
                        context-menu.show({
                            x: actions-button.absolute-position.x - root.absolute-position.x,
                            y: actions-button.absolute-position.y - root.absolute-position.y + actions-button.height,
                        });
                    }
                }
            }
        }
    }
}
