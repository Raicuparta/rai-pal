import { LineEdit, ComboBox, Button } from "std-widgets.slint";
import { FilterGroupData } from "../filter-data.slint";
import { Theme } from "../theme.slint";
import { FilterGroupView } from "filter-group.slint";
import { Sidebar } from "sidebar.slint";

export component GamesSidebar inherits Sidebar {
    in-out property <string> search-text: "";
    in-out property <int> sort-index: 0;
    in-out property <bool> sort-descending: false;
    in property <[FilterGroupData]> filter-groups;
    in property <bool> filters-have-changes;

    callback search-changed(text: string);
    callback sort-changed(index: int);
    callback sort-direction-changed(descending: bool);
    callback filter-toggled(group: string, value: string, checked: bool);
    callback filter-lock-toggled(group: string, value: string);
    callback filter-only(group: string, value: string);
    callback filter-reset(group: string);
    callback filters-reset;
    callback filter-expanded-changed(group: string, expanded: bool);

    LineEdit {
        vertical-stretch: 0;
        height: Theme.control-height;
        text <=> root.search-text;
        placeholder-text: @tr("filterMenu" => "Search...");

        edited(text) => {
            root.search-changed(text);
        }
    }

    HorizontalLayout {
        vertical-stretch: 0;
        height: Theme.control-height;
        spacing: Theme.space-4;

        ComboBox {
            vertical-stretch: 0;
            height: Theme.control-height;
            model: [
                @tr("gamesTableColumn" => "Name"),
                @tr("gamesTableColumn" => "Engine"),
                @tr("gamesTableColumn" => "Date"),
            ];
            current-index <=> root.sort-index;
            horizontal-stretch: 1;

            selected(value) => {
                root.sort-changed(root.sort-index);
            }
        }

        Button {
            text: root.sort-descending ? "↓" : "↑";
            width: Theme.control-height + Theme.space-8;

            clicked => {
                root.sort-direction-changed(!root.sort-descending);
            }
        }
    }

    HorizontalLayout {
        vertical-stretch: 0;
        spacing: Theme.space-4;
        alignment: start;
        cross-axis-alignment: center;

        Button {
            text: @tr("filterMenu" => "Reset");
            height: Theme.icon-button-size;
            enabled: root.filters-have-changes;

            clicked => {
                root.filters-reset();
            }
        }

        Text {
            text: @tr("filterMenu" => "Filters");
            font-size: Theme.font-16;
            font-weight: Theme.weight-bold;
            vertical-alignment: center;
        }
    }

    VerticalLayout {
        alignment: start;
        spacing: Theme.space-8;

        for group in root.filter-groups : FilterGroupView {
            group: group;

            toggled(value, checked) => {
                root.filter-toggled(group.key, value, checked);
            }

            lock-toggled(value) => {
                root.filter-lock-toggled(group.key, value);
            }

            only(value) => {
                root.filter-only(group.key, value);
            }

            reset => {
                root.filter-reset(group.key);
            }

            expanded-changed(expanded) => {
                root.filter-expanded-changed(group.key, expanded);
            }
        }
    }
}
