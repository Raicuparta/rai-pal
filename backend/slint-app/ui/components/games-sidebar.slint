import { LineEdit, ComboBox } from "std-widgets.slint";
import { IconSet } from "@lucide";
import { FilterGroupData } from "../filter-data.slint";
import { Theme } from "../theme.slint";
import { FilterGroupView } from "filter-group.slint";
import { IconButton } from "icon-button.slint";
import { LabeledDivider } from "labeled-divider.slint";
import { RefreshButton } from "refresh-button.slint";
import { Sidebar, SidebarSection } from "sidebar.slint";

export component GamesSidebar inherits Sidebar {
    in property <bool> refreshing;
    in property <string> refresh-task-names;
    in-out property <string> search-text: "";
    in-out property <int> sort-index: 0;
    in property <[FilterGroupData]> filter-groups;
    in property <bool> filters-have-changes;
    in property <bool> filters-have-expanded;

    callback refresh-all;
    callback search-changed(text: string);
    callback sort-changed(index: int);
    callback filter-toggled(group: string, value: string, checked: bool);
    callback filter-lock-toggled(group: string, value: string);
    callback filter-only(group: string, value: string);
    callback filter-reset(group: string);
    callback filters-reset;
    callback filters-collapse-all;
    callback filter-expanded-changed(group: string, expanded: bool);

    SidebarSection {
        RefreshButton {
            refreshing: root.refreshing;
            task-names: root.refresh-task-names;

            clicked => {
                root.refresh-all();
            }
        }
    }

    SidebarSection {
        LineEdit {
            vertical-stretch: 0;
            height: Theme.control-height;
            text <=> root.search-text;
            placeholder-text: @tr("filterMenu" => "Search...");

            edited(text) => {
                root.search-changed(text);
            }
        }
    }

    SidebarSection {
        ComboBox {
            vertical-stretch: 0;
            height: Theme.control-height;
            model: [
                "↓ " + @tr("gamesSort" => "Name A-Z"),
                "↑ " + @tr("gamesSort" => "Name Z-A"),
                "↓ " + @tr("gamesSort" => "Engine A-Z"),
                "↑ " + @tr("gamesSort" => "Engine Z-A"),
                "↓ " + @tr("gamesSort" => "Date Ascending"),
                "↑ " + @tr("gamesSort" => "Date Descending"),
            ];
            current-index <=> root.sort-index;
            horizontal-stretch: 1;

            selected(value) => {
                root.sort-changed(root.sort-index);
            }
        }
    }

    HorizontalLayout {
        vertical-stretch: 0;
        height: Theme.icon-button-size;
        padding-left: Theme.space-8;
        padding-right: Theme.space-8;
        spacing: Theme.space-4;
        cross-axis-alignment: center;

        IconButton {
            icon: IconSet.ChevronUp;
            active: root.filters-have-expanded;

            clicked => {
                root.filters-collapse-all();
            }
        }

        LabeledDivider {
            label: @tr("filterMenu" => "Filters");
            horizontal-stretch: 1;
        }

        IconButton {
            icon: IconSet.RotateCcw;
            active: root.filters-have-changes;
            icon-color: root.filters-have-changes ? Theme.primary : Theme.foreground;

            clicked => {
                root.filters-reset();
            }
        }
    }

    VerticalLayout {
        alignment: start;
        spacing: Theme.space-8;

        for group in root.filter-groups : FilterGroupView {
            group: group;

            toggled(value, checked) => {
                root.filter-toggled(group.key, value, checked);
            }

            lock-toggled(value) => {
                root.filter-lock-toggled(group.key, value);
            }

            only(value) => {
                root.filter-only(group.key, value);
            }

            reset => {
                root.filter-reset(group.key);
            }

            expanded-changed(expanded) => {
                root.filter-expanded-changed(group.key, expanded);
            }
        }
    }
}
