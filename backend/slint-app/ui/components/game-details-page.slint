import { Button, Palette, ScrollView } from "std-widgets.slint";
import { GameRowData } from "../game-row-data.slint";
import { GameModRowData } from "../game-mod-row-data.slint";
import { PotentialModRowData } from "../potential-mod-row-data.slint";
import { GameRowView } from "game-row.slint";
import { ModsSection } from "mods-section.slint";
import { PotentialModsSection } from "potential-mods-section.slint";

export component GameDetailsPage inherits Rectangle {
    in property <GameRowData> game-row;
    in property <[GameModRowData]> game-mods-installed;
    in property <[GameModRowData]> game-mods-available;
    in property <[GameModRowData]> game-mods-hidden;
    in property <[GameModRowData]> game-mods-incompatible;
    in property <[PotentialModRowData]> potential-mods;
    in property <bool> has-any-mods;
    in property <bool> has-installed-mods;
    in property <bool> has-available-mods;
    in property <bool> has-hidden-mods;
    in property <bool> has-incompatible-mods;

    callback back;
    callback install-mod(mod-id: string);
    callback uninstall-mod(mod-id: string);
    callback update-mod(mod-id: string);
    callback reinstall-mod(mod-id: string);
    callback run-mod(mod-id: string);
    callback open-mod-folder(mod-id: string);
    callback download-mod-config(mod-id: string);
    callback configure-mod(mod-id: string);
    callback configure-mod-folder(mod-id: string);
    callback uninstall-all-mods;

    ScrollView {
        VerticalLayout {
            alignment: start;
            padding: 16px;
            spacing: 8px;

            GameRowView {
                vertical-stretch: 0;
                game-row: root.game-row;
                row-index: 0;

                selected(index) => {
                    root.back();
                }
            }

            if !root.has-any-mods : Text {
                text: @tr("gameModal" => "Nothing! None of the available mods are of any use for this game. Try something else.");
                opacity: 0.75;
                wrap: word-wrap;
            }

            if !root.game-row.installed && root.has-any-mods : PotentialModsSection {
                label: @tr("gameModal" => "Potentially compatible mods");
                description: @tr("gameModal" => "Install this game to see more detailed information about which mods are compatible");
                mods: root.potential-mods;
            }

            if root.game-row.installed : VerticalLayout {
                alignment: start;
                vertical-stretch: 0;
                spacing: 8px;

                if root.has-installed-mods : VerticalLayout {
                    alignment: start;
                    vertical-stretch: 0;
                    spacing: 4px;

                    ModsSection {
                        label: @tr("gameModal" => "Installed Mods");
                        mods: root.game-mods-installed;

                        install(mod-id) => {
                            root.install-mod(mod-id);
                        }

                        uninstall(mod-id) => {
                            root.uninstall-mod(mod-id);
                        }

                        update(mod-id) => {
                            root.update-mod(mod-id);
                        }

                        reinstall(mod-id) => {
                            root.reinstall-mod(mod-id);
                        }

                        run(mod-id) => {
                            root.run-mod(mod-id);
                        }

                        open-folder(mod-id) => {
                            root.open-mod-folder(mod-id);
                        }

                        download-config(mod-id) => {
                            root.download-mod-config(mod-id);
                        }

                        configure(mod-id) => {
                            root.configure-mod(mod-id);
                        }

                        configure-folder(mod-id) => {
                            root.configure-mod-folder(mod-id);
                        }
                    }

                    Button {
                        vertical-stretch: 0;
                        text: @tr("gameModal" => "Uninstall all mods");

                        clicked => {
                            root.uninstall-all-mods();
                        }
                    }
                }

                if root.has-available-mods : ModsSection {
                    label: @tr("gameModal" => "Available Mods");
                    mods: root.game-mods-available;

                    install(mod-id) => {
                        root.install-mod(mod-id);
                    }

                    uninstall(mod-id) => {
                        root.uninstall-mod(mod-id);
                    }

                    update(mod-id) => {
                        root.update-mod(mod-id);
                    }

                    reinstall(mod-id) => {
                        root.reinstall-mod(mod-id);
                    }

                    run(mod-id) => {
                        root.run-mod(mod-id);
                    }

                    open-folder(mod-id) => {
                        root.open-mod-folder(mod-id);
                    }

                    download-config(mod-id) => {
                        root.download-mod-config(mod-id);
                    }

                    configure(mod-id) => {
                        root.configure-mod(mod-id);
                    }

                    configure-folder(mod-id) => {
                        root.configure-mod-folder(mod-id);
                    }
                }

                if root.has-hidden-mods : ModsSection {
                    label: @tr("gameModal" => "Other things");
                    description: @tr("gameModal" => "These are mostly dependencies and other stuff that you don't usually need to mess with directly.");
                    mods: root.game-mods-hidden;

                    install(mod-id) => {
                        root.install-mod(mod-id);
                    }

                    uninstall(mod-id) => {
                        root.uninstall-mod(mod-id);
                    }

                    update(mod-id) => {
                        root.update-mod(mod-id);
                    }

                    reinstall(mod-id) => {
                        root.reinstall-mod(mod-id);
                    }

                    run(mod-id) => {
                        root.run-mod(mod-id);
                    }

                    open-folder(mod-id) => {
                        root.open-mod-folder(mod-id);
                    }

                    download-config(mod-id) => {
                        root.download-mod-config(mod-id);
                    }

                    configure(mod-id) => {
                        root.configure-mod(mod-id);
                    }

                    configure-folder(mod-id) => {
                        root.configure-mod-folder(mod-id);
                    }
                }

                if root.has-incompatible-mods : VerticalLayout {
                    alignment: start;
                    vertical-stretch: 0;
                    spacing: 6px;

                    Rectangle {
                        height: 1px;
                        background: Palette.border;
                        vertical-stretch: 0;
                    }

                    ModsSection {
                        label: @tr("gameModal" => "Incompatible Mods");
                        description: @tr("gameModal" => "The mods listed here can't be installed because they aren't compatible with this game's engine version.");
                        mods: root.game-mods-incompatible;

                        install(mod-id) => {
                            root.install-mod(mod-id);
                        }

                        uninstall(mod-id) => {
                            root.uninstall-mod(mod-id);
                        }

                        update(mod-id) => {
                            root.update-mod(mod-id);
                        }

                        reinstall(mod-id) => {
                            root.reinstall-mod(mod-id);
                        }

                        run(mod-id) => {
                            root.run-mod(mod-id);
                        }

                        open-folder(mod-id) => {
                            root.open-mod-folder(mod-id);
                        }

                        download-config(mod-id) => {
                            root.download-mod-config(mod-id);
                        }

                        configure(mod-id) => {
                            root.configure-mod(mod-id);
                        }

                        configure-folder(mod-id) => {
                            root.configure-mod-folder(mod-id);
                        }
                    }
                }
            }
        }
    }
}
