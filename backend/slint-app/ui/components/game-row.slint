import { IconDisplay, IconSet } from "@lucide";
import { Branding } from "../branding.slint";
import { GameRowData } from "../game-row-data.slint";
import { Theme } from "../theme.slint";
import { ProviderIcon } from "provider-icon.slint";

export component GameRowView inherits Rectangle {
    in property <GameRowData> game-row;
    in property <int> row-index;
    in property <bool> show-thumbnail: true;

    callback selected(index: int);

    height: Theme.game-row-height;
    background: touch-area.has-hover ? Theme.row-hover : Theme.background;
    property <brush> row-foreground: game-row.installed ? Theme.foreground : Theme.dimmed-foreground;

    HorizontalLayout {
        Rectangle {
            width: Theme.provider-strip-width;
            background: Branding.provider-background(game-row.provider-id);
            opacity: game-row.installed ? 1 : 0.5;

            VerticalLayout {
                alignment: center;
                cross-axis-alignment: center;
                spacing: Theme.space-2;

                ProviderIcon {
                    provider-id: game-row.provider-id;
                    icon-size: Theme.space-16;
                }

                if game-row.installed : IconDisplay {
                    icon: IconSet.Monitor;
                    size: Theme.icon-button-icon-size;
                    stroke: Theme.dark ? white : Theme.foreground;
                }

                if !game-row.installed : IconDisplay {
                    icon: IconSet.Cloud;
                    size: Theme.icon-button-icon-size;
                    stroke: Theme.foreground;
                }
            }
        }

        if root.show-thumbnail : Rectangle {
            width: Theme.thumbnail-column-width;
            clip: true;
            background: Branding.provider-background(game-row.provider-id);
            opacity: game-row.installed ? 1 : 0.5;

            Image {
                source: @image-url("../images/fallback-thumbnail.png");
                width: Theme.thumbnail-size;
                height: Theme.thumbnail-size;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            if game-row.has-thumbnail : Image {
                source: game-row.thumbnail;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }
        }

        FlexboxLayout {
            horizontal-stretch: 1;
            padding: Theme.space-8;
            spacing: Theme.space-3;
            flex-wrap: wrap;
            alignment: start;

            Text {
                text: game-row.title;
                color: row-foreground;
                font-weight: Theme.weight-bold;
                wrap: word-wrap;
            }

            for tag in game-row.tags : Rectangle {
                width: tag-text.preferred-width + Theme.space-6;
                height: tag-text.preferred-height + Theme.space-4;
                background: Theme.tag-background;
                border-radius: Theme.radius-3;

                tag-text := Text {
                    text: tag;
                    font-size: Theme.font-8;
                    font-weight: Theme.weight-light;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            width: Theme.engine-column-width;
            background: Branding.engine-background(game-row.engine-brand);
            clip: true;

            VerticalLayout {
                alignment: center;
                padding-left: Theme.space-8;
                padding-right: Theme.space-8;

                Text {
                    text: game-row.engine-brand == "" ? "-" : game-row.engine-brand;
                    color: Branding.engine-foreground(game-row.engine-brand);
                    font-weight: Theme.weight-bold;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                if game-row.engine-version != "" : Text {
                    text: game-row.engine-version;
                    horizontal-alignment: center;
                    color: Branding.engine-foreground(game-row.engine-brand);
                    font-family: "monospace";
                    font-size: Theme.font-12;
                    overflow: elide;
                }

                if game-row.engine-details != "" : Text {
                    text: game-row.engine-details;
                    horizontal-alignment: center;
                    color: Branding.engine-foreground(game-row.engine-brand);
                    font-size: Theme.font-10;
                    opacity: 0.5;
                    overflow: elide;
                }
            }
        }

        VerticalLayout {
            width: Theme.date-column-width;
            alignment: center;
            opacity: 0.75;

            Text {
                text: game-row.release-day;
                font-size: Theme.font-12;
                horizontal-alignment: center;
            }

            Text {
                text: game-row.release-month;
                font-size: Theme.font-12;
                horizontal-alignment: center;
                overflow: elide;
            }

            Text {
                text: game-row.release-year;
                font-size: Theme.font-12;
                horizontal-alignment: center;
            }
        }
    }

    Rectangle {
        y: parent.height - self.height;
        height: Theme.row-divider-height;
        background: Theme.row-divider;
    }

    touch-area := TouchArea {
        clicked => {
            root.selected(root.row-index);
        }
    }
}
