import { Palette } from "std-widgets.slint";

export component EngineIcon inherits Rectangle {
    in property <string> engine-brand;
    in property <brush> icon-color: Palette.foreground;
    in property <length> icon-size: 14px;

    width: root.icon-size;
    height: root.icon-size;

    if engine-brand == "Unity" : Image {
        source: @image-url("../icons/engines/unity.svg");
        colorize: icon-color;
        width: 100%;
        height: 100%;
    }

    if engine-brand == "Unreal" : Image {
        source: @image-url("../icons/engines/unreal.svg");
        colorize: icon-color;
        width: 100%;
        height: 100%;
    }

    if engine-brand == "Godot" : Image {
        source: @image-url("../icons/engines/godot.svg");
        colorize: icon-color;
        width: 100%;
        height: 100%;
    }

    if engine-brand == "GameMaker" : Image {
        source: @image-url("../icons/engines/gamemaker.svg");
        colorize: icon-color;
        width: 100%;
        height: 100%;
    }
}
