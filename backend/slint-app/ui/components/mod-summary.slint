import { Icon, IconDisplay, IconSet } from "@lucide";
import { Theme } from "../theme.slint";

component MetaItem inherits HorizontalLayout {
    in property <Icon> icon;
    in property <string> text;

    spacing: Theme.space-2;
    horizontal-stretch: 0;
    cross-axis-alignment: center;

    IconDisplay {
        icon: root.icon;
        size: Theme.font-10;
        stroke: Theme.foreground;
        stroke-width: 2;
    }

    Text {
        text: root.text;
        font-size: Theme.font-11;
        color: Theme.foreground;
    }
}

export component ModSummaryView inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    in property <string> version-text;
    in property <string> release-date;
    in property <string> author;
    in property <string> engine-text;
    in property <bool> deprecated: false;
    in property <bool> has-remote-config: false;
    in property <bool> show-status: false;
    in property <bool> installed: false;
    in property <bool> outdated: false;

    property <bool> has-details: version-text != "" || release-date != "" || author != "" || engine-text != "";

    spacing: Theme.space-8;
    cross-axis-alignment: center;

    if show-status && outdated : IconDisplay {
        icon: IconSet.CircleAlert;
        size: Theme.icon-status-size;
        stroke: Theme.status-warning;
        stroke-width: 2;
    }

    if show-status && installed && !outdated : IconDisplay {
        icon: IconSet.CircleCheck;
        size: Theme.icon-status-size;
        stroke: Theme.status-success;
        stroke-width: 2;
    }

    if show-status && !installed && !outdated : IconDisplay {
        icon: IconSet.CircleMinus;
        size: Theme.icon-status-size;
        stroke: Theme.dimmed-foreground;
        stroke-width: 2;
    }

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: start;
        spacing: Theme.space-2;

        HorizontalLayout {
            spacing: Theme.space-6;
            cross-axis-alignment: center;

            Text {
                text: root.title;
                font-weight: Theme.weight-semibold;
                overflow: elide;
                horizontal-stretch: 1;
            }

            if root.has-remote-config : IconDisplay {
                icon: IconSet.Settings;
                size: Theme.icon-button-icon-size;
                stroke: Theme.foreground;
                stroke-width: 2;
                opacity: 0.75;
            }

            if root.deprecated : Rectangle {
                width: deprecated-content.preferred-width + Theme.space-8;
                height: Theme.deprecated-badge-height;
                border-radius: Theme.radius-3;
                background: Theme.deprecated-background;

                deprecated-content := HorizontalLayout {
                    padding-left: Theme.space-4;
                    padding-right: Theme.space-4;
                    spacing: Theme.space-3;
                    alignment: center;

                    IconDisplay {
                        icon: IconSet.TriangleAlert;
                        size: Theme.font-11;
                        stroke: Theme.deprecated-foreground;
                        stroke-width: 2;
                    }

                    Text {
                        text: @tr("modsPage" => "Deprecated");
                        font-size: Theme.font-10;
                        font-weight: Theme.weight-bold;
                        color: Theme.deprecated-foreground;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.has-details : HorizontalLayout {
            opacity: 0.4;
            spacing: Theme.space-10;
            alignment: start;
            cross-axis-alignment: center;

            if root.version-text != "" : Text {
                text: root.version-text;
                font-size: Theme.font-11;
                color: Theme.foreground;
                horizontal-stretch: 0;
            }

            if root.release-date != "" : MetaItem {
                icon: IconSet.Calendar;
                text: root.release-date;
            }

            if root.author != "" : MetaItem {
                icon: IconSet.UserRound;
                text: root.author;
            }

            if root.engine-text != "" : MetaItem {
                icon: IconSet.Cpu;
                text: root.engine-text;
            }
        }

        if root.description != "" : Text {
            text: root.description;
            font-size: Theme.font-12;
            opacity: 0.75;
            wrap: word-wrap;
            color: Theme.foreground;
        }
    }
}
