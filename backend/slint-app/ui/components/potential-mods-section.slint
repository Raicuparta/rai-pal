import { PotentialModRowData } from "../potential-mod-row-data.slint";
import { Theme } from "../theme.slint";
import { SectionHeader } from "section-header.slint";

component PotentialModRowView inherits Rectangle {
    in property <PotentialModRowData> potential-mod;

    vertical-stretch: 0;
    height: max(Theme.potential-mod-row-height, content.preferred-height);

    content := VerticalLayout {
        padding: Theme.space-6;
        alignment: start;
        spacing: Theme.space-2;

        Text {
            text: potential-mod.title;
            font-weight: Theme.weight-semibold;
            overflow: elide;
        }

        if potential-mod.description != "" : Text {
            text: potential-mod.description;
            font-size: Theme.font-12;
            opacity: 0.75;
            wrap: word-wrap;
            color: Theme.foreground;
        }
    }
}

export component PotentialModsSection inherits VerticalLayout {
    in property <string> label;
    in property <string> description;
    in property <[PotentialModRowData]> mods;

    vertical-stretch: 0;
    alignment: start;
    spacing: Theme.space-2;

    SectionHeader {
        label: root.label;
        description: root.description;
    }

    for row in root.mods : PotentialModRowView {
        potential-mod: row;
    }
}
