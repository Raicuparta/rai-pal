import { Palette } from "std-widgets.slint";
import { PotentialModRowData } from "../potential-mod-row-data.slint";

component PotentialModRowView inherits Rectangle {
    in property <PotentialModRowData> potential-mod;

    vertical-stretch: 0;
    height: max(44px, content.preferred-height);

    content := VerticalLayout {
        padding: 6px;
        alignment: start;
        spacing: 2px;

        Text {
            text: potential-mod.title;
            font-weight: 600;
            overflow: elide;
        }

        if potential-mod.description != "" : Text {
            text: potential-mod.description;
            font-size: 12px;
            opacity: 0.75;
            wrap: word-wrap;
            color: Palette.foreground;
        }
    }
}

export component PotentialModsSection inherits VerticalLayout {
    in property <string> label;
    in property <string> description;
    in property <[PotentialModRowData]> mods;

    vertical-stretch: 0;
    alignment: start;
    spacing: 2px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;

        Text {
            text: root.label;
            font-weight: 700;
            horizontal-stretch: 1;
        }
    }

    if root.description != "" : HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;

        Text {
            text: root.description;
            opacity: 0.5;
            font-size: 12px;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }

    for row in root.mods : PotentialModRowView {
        potential-mod: row;
    }
}
