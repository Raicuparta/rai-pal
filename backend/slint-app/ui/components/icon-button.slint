import { Theme } from "../theme.slint";
import { BaseButton } from "base-button.slint";

export component IconButton inherits BaseButton {
    in property <string> label: "";
    in property <bool> active: true;
    in property <bool> selected: false;

    text: root.label;
    icon-only: root.label == "";
    show-icon: root.label == "";
    icon-size: Theme.icon-button-icon-size;
    text-size: Theme.font-12;
    horizontal-padding: Theme.space-4;
    content-spacing: Theme.space-2;
    enabled: root.active;
    icon-color: root.selected ? Theme.highlight : Theme.foreground;
    use-custom-icon-color: true;
    width: Theme.icon-button-size;
    height: Theme.icon-button-size;
}
