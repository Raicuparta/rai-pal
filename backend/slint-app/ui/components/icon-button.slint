import { Icon, IconDisplay } from "@lucide";
import { Palette } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export component IconButton inherits Rectangle {
    in property <Icon> icon;
    in property <bool> active: true;
    in property <bool> selected: false;

    callback clicked;

    out property <bool> hovered: touch.has-hover;

    width: Theme.icon-button-size;
    height: Theme.icon-button-size;
    border-radius: Theme.radius-4;
    opacity: active ? (selected ? 1 : 0.8) : 0.3;
    background: active && touch.has-hover ? Palette.control-background : transparent;

    touch := TouchArea {
        clicked => {
            if root.active {
                root.clicked();
            }
        }
    }

    IconDisplay {
        icon: root.icon;
        size: Theme.icon-button-icon-size;
        stroke: root.selected ? Theme.highlight : Palette.foreground;
        stroke-width: 2;
    }
}
