import { Icon, IconDisplay } from "@lucide";
import { Theme } from "../theme.slint";

export component IconButton inherits Rectangle {
    in property <Icon> icon;
    in property <bool> active: true;
    in property <bool> selected: false;
    in property <brush> button-background: transparent;
    in property <brush> hover-background: Theme.hover-background;
    in property <brush> icon-color: Theme.foreground;

    callback clicked;

    out property <bool> hovered: touch.has-hover;

    width: Theme.icon-button-size;
    height: Theme.icon-button-size;
    border-radius: Theme.radius-4;
    opacity: active ? (selected ? 1 : 0.8) : 0.3;
    background: active && touch.has-hover ? root.hover-background : root.button-background;

    touch := TouchArea {
        clicked => {
            if root.active {
                root.clicked();
            }
        }
    }

    IconDisplay {
        icon: root.icon;
        size: Theme.icon-button-icon-size;
        stroke: root.selected ? Theme.highlight : root.icon-color;
        stroke-width: 2;
    }
}
