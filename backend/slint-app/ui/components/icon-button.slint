import { Icon, IconDisplay } from "@lucide";
import { Theme } from "../theme.slint";

export component IconButton inherits Rectangle {
    in property <Icon> icon;
    in property <string> label: "";
    in property <bool> active: true;
    in property <bool> selected: false;
    in property <brush> active-background: Theme.foreground.transparentize(0.92);
    in property <brush> hover-background: Theme.foreground.transparentize(0.85);
    in property <brush> icon-color: Theme.foreground;

    callback clicked;

    out property <bool> hovered: touch.has-hover;

    width: Theme.icon-button-size;
    height: Theme.icon-button-size;
    border-radius: Theme.radius-4;
    opacity: root.active ? (root.selected ? 1 : 0.8) : 0.3;
    background: root.active ? (root.hovered ? root.hover-background : root.active-background) : transparent;

    touch := TouchArea {
        clicked => {
            if root.active {
                root.clicked();
            }
        }
    }

    if root.label == "" : IconDisplay {
        icon: root.icon;
        size: Theme.icon-button-icon-size;
        stroke: root.selected ? Theme.highlight : root.icon-color;
    }

    if root.label != "" : Text {
        text: root.label;
        font-size: Theme.font-12;
        color: root.icon-color;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
