import { Icon, IconDisplay } from "@lucide";
import { Palette } from "std-widgets.slint";

export component IconButton inherits Rectangle {
    in property <Icon> icon;
    in property <bool> active: true;
    in property <bool> selected: false;

    callback clicked;

    out property <bool> hovered: touch.has-hover;

    width: 22px;
    height: 22px;
    border-radius: 4px;
    opacity: active ? (selected ? 1 : 0.8) : 0.3;
    background: active && touch.has-hover ? Palette.control-background : transparent;

    touch := TouchArea {
        clicked => {
            if root.active {
                root.clicked();
            }
        }
    }

    IconDisplay {
        icon: root.icon;
        size: 14px;
        stroke: root.selected ? #fcc419 : Palette.foreground;
        stroke-width: 2;
    }
}
