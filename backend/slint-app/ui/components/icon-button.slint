import { BaseButton } from "base-button.slint";
import { SvgIcon } from "svg-icon.slint";

export component IconButton inherits BaseButton {
    in property <image> icon;
    in property <length> icon-size: 14px;

    width: 18px;
    height: 18px;
    border-radius: 9px;

    accessible-label: root.tooltip;

    if root.icon.width > 0 : SvgIcon {
        source: root.icon;
        size: root.icon-size;
        color: root.ink-color;
    }
}
