export struct FilterValueData {
    value: string,
    label-key: string,
    label: string,
    enabled: bool,
    locked: bool,
}

export struct FilterGroupData {
    key: string,
    label-key: string,
    label: string,
    values: [FilterValueData],
    has-changes: bool,
    has-locked: bool,
    expanded: bool,
}
