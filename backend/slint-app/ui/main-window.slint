import { Palette } from "std-widgets.slint";
import { GameRowData } from "game-row-data.slint";
import { FilterGroupData } from "filter-data.slint";
import { GameModRowData } from "game-mod-row-data.slint";
import { PotentialModRowData } from "potential-mod-row-data.slint";
import { ModsTabItemData } from "mods-tab-data.slint";
import { PatronData } from "patron-data.slint";
import { ProviderActionItem } from "provider-action-item.slint";
import { GamesSidebar } from "components/games-sidebar.slint";
import { GameSidebar } from "components/game-sidebar.slint";
import { GameDetailsPopup } from "components/game-details-popup.slint";
import { GamesPage } from "components/games-page.slint";
import { GameDetailsPage } from "components/game-details-page.slint";
import { NavTab } from "components/nav-tab.slint";
import { AppMenu } from "components/app-menu.slint";
import { UserMenu } from "components/user-menu.slint";
import { AboutPopup } from "components/about-popup.slint";
import { ModsPage } from "components/mods-page.slint";
import { ThanksPage } from "components/thanks-page.slint";
import { UrlModSourcesPopup } from "components/url-mod-sources-popup.slint";
import { ConfirmModSourcePopup } from "components/confirm-mod-source-popup.slint";
import { SteamCachePopup } from "components/steam-cache-popup.slint";
import { SteamShortcutPopup } from "components/steam-shortcut-popup.slint";
import { AddGamePopup } from "components/add-game-popup.slint";
import { ConfirmationPopup } from "components/confirmation-popup.slint";
import { NotificationsOverlay } from "components/notifications.slint";
import { UrlModSourceData } from "url-mod-source-data.slint";
import { NotificationData } from "notification-data.slint";
import { Theme } from "theme.slint";
import { ModActions } from "actions.slint";
import { AppColorScheme, AppTab, AddGamePhase } from "app-types.slint";

export { AppColorScheme, AppTab, AddGamePhase, ModActions }

export component MainWindow inherits Window {
    title: "Rai Pal";
    preferred-width: Theme.window-preferred-width;
    preferred-height: Theme.window-preferred-height;
    min-width: Theme.window-min-width;
    min-height: Theme.window-min-height;

    in property <[GameRowData]> game-rows;
    in property <[GameModRowData]> game-mods-installed;
    in property <[GameModRowData]> game-mods-available;
    in property <[GameModRowData]> game-mods-hidden;
    in property <[GameModRowData]> game-mods-incompatible;
    in property <[PotentialModRowData]> potential-mods;
    in property <[ModsTabItemData]> mods-tab-items;
    in property <[PatronData]> patrons;
    in property <bool> has-any-mods: false;
    in property <bool> has-installed-mods: false;
    in property <bool> has-available-mods: false;
    in property <bool> has-hidden-mods: false;
    in property <bool> has-incompatible-mods: false;
    in property <[FilterGroupData]> filter-groups;
    in property <bool> filters-have-changes;
    in-out property <string> selected-language: "";
    in-out property <AppColorScheme> selected-color-scheme: auto;
    in property <string> detected-language-name: "";
    in-out property <string> search-text: "";
    in-out property <int> sort-index: 0;
    in-out property <bool> sort-descending: false;
    in-out property <string> details-json: "";
    in property <string> app-version: "";
    in property <string> renderer-name: "";
    in property <bool> user-logged-in: false;
    in property <bool> user-busy: false;
    in property <string> user-name: "";
    in property <string> user-initials: "";
    in property <bool> user-has-avatar: false;
    in property <image> user-avatar;
    in property <[NotificationData]> notifications;
    in-out property <bool> refreshing: false;
    in property <string> refresh-task-names: "";
    in property <UrlModSourceData> default-url-mod-source;
    in property <[UrlModSourceData]> url-mod-sources;
    in property <bool> url-mod-sources-toggling: false;
    in property <string> url-mod-sources-error: "";
    in-out property <string> new-url-mod-source: "";
    in-out property <bool> url-mod-sources-open: false;
    in property <bool> confirm-mod-source-loading: false;
    in property <string> confirm-mod-source-url: "";
    in property <string> confirm-mod-source-error: "";
    in property <[string]> confirm-mod-source-mods;
    in property <bool> confirm-mod-source-saving: false;
    in-out property <bool> confirm-mod-source-open: false;
    in-out property <bool> steam-cache-open: false;
    in-out property <bool> steam-cache-running: false;
    in-out property <bool> steam-cache-success: false;
    in-out property <string> steam-cache-error: "";
    in-out property <bool> steam-shortcut-open: false;
    in-out property <bool> steam-shortcut-running: false;
    in-out property <bool> steam-shortcut-success: false;
    in-out property <string> steam-shortcut-error: "";
    in-out property <bool> confirmation-open: false;
    in property <string> confirmation-text: "";
    in property <string> confirmation-confirm-label: "";
    in property <bool> confirmation-can-skip: false;
    in-out property <bool> confirmation-dont-ask-again: false;
    in-out property <bool> add-game-open: false;
    in-out property <AddGamePhase> scan-phase: idle;
    in property <string> scan-selected-path: "";
    in property <int> scan-scanned-dirs: 0;
    in property <int> scan-executables-found: 0;
    in property <string> scan-current-path: "";
    in property <int> scan-games-count: 0;
    in property <string> scan-duration-text: "";
    in-out property <string> add-game-directory: "";
    in property <[string]> manual-directories;

    in-out property <AppTab> current-tab: games;
    in-out property <bool> game-selected: false;
    in-out property <GameRowData> selected-game-row;
    in-out property <string> selected-game-json: "";
    in property <string> selected-provider-id: "";
    in property <bool> selected-can-run-game: false;
    in property <bool> selected-has-exe-path: false;
    in property <bool> selected-show-wine-folders: false;
    in property <[ProviderActionItem]> selected-provider-actions;

    callback request-game(index: int);
    callback refresh-all;
    callback request-url-mod-sources;
    callback set-url-mod-source-enabled(url: string, enabled: bool);
    callback remove-url-mod-source(url: string);
    callback add-url-mod-source(url: string);
    callback confirm-url-mod-source;
    callback cancel-url-mod-source;
    callback reset-steam-cache;
    callback add-steam-shortcut;
    callback request-add-game;
    callback add-game-closed;
    callback select-game-executable;
    callback select-game-directory;
    callback cancel-game-scan;
    callback confirm-game-directory;
    callback remove-game-directory(path: string);
    callback remove-game(confirmation-text: string, confirm-label: string);
    callback log-in;
    callback log-out;
    callback dismiss-notification(id: int);
    callback confirmation-response(confirmed: bool);
    callback visible-range-changed(first: int, last: int);
    callback search-changed(text: string);
    callback sort-changed(index: int);
    callback sort-direction-changed(descending: bool);
    callback filter-toggled(group: string, value: string, checked: bool);
    callback filter-lock-toggled(group: string, value: string);
    callback filter-only(group: string, value: string);
    callback filter-reset(group: string);
    callback filters-reset;
    callback filter-expanded-changed(group: string, expanded: bool);
    callback tab-changed(tab: AppTab);
    callback language-changed(value: string);
    callback color-scheme-changed(value: AppColorScheme);
    callback select-game(index: int);
    callback back;
    callback run-game;
    callback run-provider-action(value: string);
    callback open-game-folder;
    callback open-game-mods-folder;
    callback open-game-data-folder;
    callback open-wine-prefix-folder;
    callback open-wine-binary-folder;
    callback refresh-game;
    function apply-color-scheme() {
        if root.selected-color-scheme == AppColorScheme.dark {
            Palette.color-scheme = ColorScheme.dark;
        } else if root.selected-color-scheme == AppColorScheme.light {
            Palette.color-scheme = ColorScheme.light;
        } else {
            Palette.color-scheme = ColorScheme.unknown;
        }
    }

    init => {
        root.apply-color-scheme();
    }

    changed selected-color-scheme => {
        root.apply-color-scheme();
    }

    VerticalLayout {
        Rectangle {
            height: Theme.navbar-height;
            background: Palette.alternate-background;

            HorizontalLayout {
                padding-left: Theme.space-8;
                padding-right: Theme.space-8;
                spacing: Theme.space-2;
                cross-axis-alignment: center;

                NavTab {
                    title: @tr("tab" => "Games");
                    selected: root.current-tab == AppTab.games;

                    clicked => {
                        root.current-tab = AppTab.games;
                        root.tab-changed(AppTab.games);
                    }
                }

                NavTab {
                    title: @tr("tab" => "Mods");
                    selected: root.current-tab == AppTab.mods;

                    clicked => {
                        root.current-tab = AppTab.mods;
                        root.tab-changed(AppTab.mods);
                    }
                }

                NavTab {
                    title: @tr("tab" => "Thanks");
                    selected: root.current-tab == AppTab.thanks;

                    clicked => {
                        root.current-tab = AppTab.thanks;
                        root.tab-changed(AppTab.thanks);
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                UserMenu {
                    logged-in: root.user-logged-in;
                    busy: root.user-busy;
                    user-name: root.user-name;
                    user-initials: root.user-initials;
                    has-avatar: root.user-has-avatar;
                    avatar: root.user-avatar;

                    log-in => {
                        root.log-in();
                    }

                    log-out => {
                        root.log-out();
                    }
                }

                AppMenu {
                    selected-language: root.selected-language;
                    selected-color-scheme: root.selected-color-scheme;
                    detected-language-name: root.detected-language-name;

                    about-clicked => {
                        about-popup.show();
                    }

                    steam-cache-clicked => {
                        root.steam-cache-success = false;
                        root.steam-cache-error = "";
                        root.steam-cache-open = true;
                    }

                    steam-shortcut-clicked => {
                        root.steam-shortcut-success = false;
                        root.steam-shortcut-error = "";
                        root.steam-shortcut-open = true;
                    }

                    add-game-clicked => {
                        root.request-add-game();
                    }

                    language-changed(value) => {
                        root.language-changed(value);
                    }

                    color-scheme-changed(value) => {
                        root.selected-color-scheme = value;
                        root.color-scheme-changed(value);
                    }
                }
            }

            Rectangle {
                y: parent.height - self.height;
                width: 100%;
                height: Theme.border-width;
                background: Palette.border;
            }
        }

        Rectangle {
            Rectangle {
                visible: root.current-tab == AppTab.games;

                HorizontalLayout {
                    visible: root.game-selected;

                    GameSidebar {
                        visible: root.game-selected;
                        provider-id: root.selected-provider-id;
                        can-run-game: root.selected-can-run-game;
                        has-exe-path: root.selected-has-exe-path;
                        show-wine-folders: root.selected-show-wine-folders;
                        provider-actions: root.selected-provider-actions;

                        back => {
                            root.back();
                        }

                        run-game => {
                            root.run-game();
                        }

                        run-provider-action(value) => {
                            root.run-provider-action(value);
                        }

                        open-game-folder => {
                            root.open-game-folder();
                        }

                        open-game-mods-folder => {
                            root.open-game-mods-folder();
                        }

                        open-game-data-folder => {
                            root.open-game-data-folder();
                        }

                        open-wine-prefix-folder => {
                            root.open-wine-prefix-folder();
                        }

                        open-wine-binary-folder => {
                            root.open-wine-binary-folder();
                        }

                        refresh-game => {
                            root.refresh-game();
                        }

                        debug-data => {
                            root.details-json = root.selected-game-json;
                            details-popup.show();
                        }

                        remove-game(confirmation-text, confirm-label) => {
                            root.remove-game(confirmation-text, confirm-label);
                        }
                    }

                    GameDetailsPage {
                        visible: root.game-selected;
                        game-row: root.selected-game-row;
                        game-mods-installed: root.game-mods-installed;
                        game-mods-available: root.game-mods-available;
                        game-mods-hidden: root.game-mods-hidden;
                        game-mods-incompatible: root.game-mods-incompatible;
                        potential-mods: root.potential-mods;
                        has-any-mods: root.has-any-mods;
                        has-installed-mods: root.has-installed-mods;
                        has-available-mods: root.has-available-mods;
                        has-hidden-mods: root.has-hidden-mods;
                        has-incompatible-mods: root.has-incompatible-mods;

                        back => {
                            root.back();
                        }

                    }
                }

                HorizontalLayout {
                    visible: !root.game-selected;

                    GamesSidebar {
                        visible: !root.game-selected;
                        search-text <=> root.search-text;
                        sort-index <=> root.sort-index;
                        sort-descending <=> root.sort-descending;
                        filter-groups: root.filter-groups;
                        filters-have-changes: root.filters-have-changes;
                        refreshing: root.refreshing;
                        refresh-task-names: root.refresh-task-names;

                        refresh-all => {
                            root.refresh-all();
                        }

                        search-changed(text) => {
                            root.search-changed(text);
                        }

                        sort-changed(index) => {
                            root.sort-changed(index);
                        }

                        sort-direction-changed(descending) => {
                            root.sort-direction-changed(descending);
                        }

                        filter-toggled(group, value, checked) => {
                            root.filter-toggled(group, value, checked);
                        }

                        filter-lock-toggled(group, value) => {
                            root.filter-lock-toggled(group, value);
                        }

                        filter-only(group, value) => {
                            root.filter-only(group, value);
                        }

                        filter-reset(group) => {
                            root.filter-reset(group);
                        }

                        filters-reset => {
                            root.filters-reset();
                        }

                        filter-expanded-changed(group, expanded) => {
                            root.filter-expanded-changed(group, expanded);
                        }
                    }

                    GamesPage {
                        visible: !root.game-selected;
                        game-rows: root.game-rows;

                        request-game(index) => {
                            root.request-game(index);
                        }

                        visible-range-changed(first, last) => {
                            root.visible-range-changed(first, last);
                        }

                        select-game(index) => {
                            root.select-game(index);
                        }
                    }
                }
            }

            Rectangle {
                visible: root.current-tab == AppTab.mods;

                ModsPage {
                    items: root.mods-tab-items;
                    refreshing: root.refreshing;
                    refresh-task-names: root.refresh-task-names;

                    refresh-all => {
                        root.refresh-all();
                    }

                    open-url-mod-sources => {
                        root.request-url-mod-sources();
                    }
                }
            }

            Rectangle {
                visible: root.current-tab == AppTab.thanks;

                ThanksPage {
                    patrons: root.patrons;
                }
            }
        }
    }

    NotificationsOverlay {
        notifications: root.notifications;

        dismissed(id) => {
            root.dismiss-notification(id);
        }
    }

    changed confirmation-open => {
        if root.confirmation-open {
            confirmation-popup.show();
        } else {
            confirmation-popup.close();
        }
    }

    confirmation-popup := ConfirmationPopup {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        text: root.confirmation-text;
        confirm-label: root.confirmation-confirm-label;
        can-skip: root.confirmation-can-skip;
        dont-ask-again <=> root.confirmation-dont-ask-again;

        response(confirmed) => {
            root.confirmation-response(confirmed);
        }

        closed => {
            root.confirmation-open = false;
        }
    }

    details-popup := GameDetailsPopup {
        width: min(Theme.details-popup-width, root.width - Theme.overlay-margin);
        height: min(Theme.details-popup-height, root.height - Theme.overlay-margin);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        game-json: root.details-json;

        closed => {
            root.details-json = "";
        }
    }

    about-popup := AboutPopup {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        app-version: root.app-version;
        renderer-name: root.renderer-name;
    }

    changed url-mod-sources-open => {
        if root.url-mod-sources-open {
            url-mod-sources-popup.show();
        } else {
            url-mod-sources-popup.close();
        }
    }

    changed confirm-mod-source-open => {
        if root.confirm-mod-source-open {
            confirm-mod-source-popup.show();
        } else {
            confirm-mod-source-popup.close();
        }
    }

    changed steam-cache-open => {
        if root.steam-cache-open {
            steam-cache-popup.show();
        } else {
            steam-cache-popup.close();
        }
    }

    changed steam-shortcut-open => {
        if root.steam-shortcut-open {
            steam-shortcut-popup.show();
        } else {
            steam-shortcut-popup.close();
        }
    }

    steam-shortcut-popup := SteamShortcutPopup {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        running: root.steam-shortcut-running;
        success: root.steam-shortcut-success;
        error: root.steam-shortcut-error;

        add-clicked => {
            root.add-steam-shortcut();
        }

        closed => {
            root.steam-shortcut-open = false;
        }
    }

    changed add-game-open => {
        if root.add-game-open {
            add-game-popup.show();
        } else {
            add-game-popup.close();
        }
    }

    add-game-popup := AddGamePopup {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        phase: root.scan-phase;
        selected-path: root.scan-selected-path;
        scanned-dirs: root.scan-scanned-dirs;
        executables-found: root.scan-executables-found;
        current-path: root.scan-current-path;
        games-count: root.scan-games-count;
        duration-text: root.scan-duration-text;
        directories: root.manual-directories;

        select-executable => {
            root.select-game-executable();
        }

        select-directory => {
            root.select-game-directory();
        }

        cancel-scan => {
            root.cancel-game-scan();
        }

        confirm-directory => {
            root.confirm-game-directory();
        }

        remove-directory(path) => {
            root.remove-game-directory(path);
        }

        closed => {
            root.add-game-closed();
            root.add-game-open = false;
        }
    }

    steam-cache-popup := SteamCachePopup {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        running: root.steam-cache-running;
        success: root.steam-cache-success;
        error: root.steam-cache-error;

        reset-clicked => {
            root.reset-steam-cache();
        }

        closed => {
            root.steam-cache-open = false;
        }
    }

    url-mod-sources-popup := UrlModSourcesPopup {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        default-source: root.default-url-mod-source;
        sources: root.url-mod-sources;
        toggling: root.url-mod-sources-toggling;
        error: root.url-mod-sources-error;
        new-url <=> root.new-url-mod-source;

        add-source(url) => {
            root.add-url-mod-source(url);
        }

        set-enabled(url, enabled) => {
            root.set-url-mod-source-enabled(url, enabled);
        }

        remove-source(url) => {
            root.remove-url-mod-source(url);
        }

        closed => {
            root.url-mod-sources-open = false;
        }
    }

    confirm-mod-source-popup := ConfirmModSourcePopup {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        url: root.confirm-mod-source-url;
        loading: root.confirm-mod-source-loading;
        error: root.confirm-mod-source-error;
        mods: root.confirm-mod-source-mods;
        saving: root.confirm-mod-source-saving;

        confirm => {
            root.confirm-url-mod-source();
        }

        closed => {
            root.confirm-mod-source-open = false;
            root.cancel-url-mod-source();
        }
    }
}
