{
	"format_on_save": "on",
	"lsp": {
		"rust-analyzer": {
			"initialization_options": {
				"check": {
					"command": "clippy",
				},
			},
		},
	},
	"languages": {
		"Rust": {
			"prettier": {
				"allowed": false,
			},
			"formatter": {
				"external": {
					"command": "rustup",
					"arguments": [
						"run",
						"nightly",
						"rustfmt",
						"--config-path",
						"./backend",
					],
				},
			},
		},
	},
	"prettier": {
		"allowed": true,
	},
}
