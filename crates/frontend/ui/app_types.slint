export enum AppTab {
    games,
    mods,
    thanks,
}

export enum AppColorScheme {
    auto,
    dark,
    light,
}

export enum AddGamePhase {
    idle,
    scanning,
    confirming,
}

export enum ProviderId {
    none,
    amazon,
    epic,
    gog,
    itch,
    manual,
    steam,
    xbox,
}

export enum EngineId {
    none,
    unity,
    unreal,
    godot,
    game-maker,
}

export enum ProviderAction {
    none,
    start-via-provider,
    start-via-exe,
    install,
    show-in-library,
    show-in-store,
    open-in-browser,
    delete,
}

export struct ProviderActionData {
    action: ProviderAction,
    action-id: string,
}

export enum DownloadPhase {
    pending,
    in-progress,
    finished,
    failed,
}

export enum NotificationKind {
    error,
    success,
    info,
}

export struct DownloadItemData {
    id: string,
    name: string,
    progress: float,
    phase: DownloadPhase,
}

export enum FilterGroupId {
    installed,
    engines,
    mod-families,
    tags,
    providers,
    unity-backends,
    executable-os,
    supported-os,
    architectures,
}

export enum FilterGroupLabel {
    status,
    engine,
    mod,
    tag,
    provider,
    unity-backend,
    executable-os,
    supported-os,
    architecture,
}

export enum FilterValueLabel {
    none,
    unknown,
    arch-64,
    arch-32,
    tag-demo,
    tag-vr,
    tag-untagged,
    status-installed,
    status-not-installed,
    provider-manual,
}

export enum FilterValueNote {
    none,
    engine-godot-not-fully-supported,
    engine-game-maker-not-fully-supported,
    provider-xbox-only-installed,
}

export struct FilterValueData {
    value: string,
    label: FilterValueLabel,
    display: string,
    note: FilterValueNote,
    enabled: bool,
    locked: bool,
}

export struct FilterGroupData {
    key: FilterGroupId,
    label: FilterGroupLabel,
    values: [FilterValueData],
    has-changes: bool,
    has-locked: bool,
    expanded: bool,
}

export struct GameModData {
    mod-id: string,
    title: string,
    description: string,
    family: string,
    version-text: string,
    release-date: string,
    author: string,
    engine-text: string,
    installed: bool,
    outdated: bool,
    incompatible: bool,
    deprecated: bool,
    has-remote-config: bool,
    show-status: bool,
    can-install: bool,
    can-update: bool,
    can-run: bool,
    can-show-actions: bool,
    can-edit-config: bool,
    can-open-mod-folder: bool,
    can-download-config: bool,
    can-reinstall: bool,
    can-uninstall: bool,
    has-installed-dependants: bool,
}

export struct GameRowData {
    provider: ProviderId,
    game-id: string,
    title: string,
    thumbnail: image,
    has-thumbnail: bool,
    installed: bool,
    tags: [string],
    loaded: bool,
    engine: EngineId,
    engine-name: string,
    engine-version: string,
    engine-details: string,
    release-day: string,
    release-month: string,
    release-year: string,
}

export struct ModsTabModData {
    id: string,
    title: string,
    description: string,
    version-text: string,
    release-date: string,
    author: string,
    engine-text: string,
    deprecated: bool,
    source-code: string,
    can-run: bool,
    can-install: bool,
}

export struct ModsTabItemData {
    is-family: bool,
    family-title: string,
    family-description: string,
    mods: [ModsTabModData],
    single-mod: ModsTabModData,
}

export struct NotificationData {
    id: int,
    message: string,
    kind: NotificationKind,
}

export struct PatronData {
    ranking: int,
    name: string,
    initials: string,
    has-avatar: bool,
    avatar: image,
}

export struct PotentialModData {
    title: string,
    description: string,
}

export struct UrlModSourceData {
    url: string,
    enabled: bool,
    is-default: bool,
}
