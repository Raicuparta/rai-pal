    edit-path,
    reinstall,
    uninstall,
    uninstall-all,
    reinstall-all,
    website,
    show-game,
    debug-data,
}

export struct ModActionData {
    kind: ModActionKind,
    action-key: ActionKey,
    mod-id: string,
    subject: string,
    target: string,
    provider: ProviderId,
    enabled: bool,
    separator-before: bool,
    open-folder: bool,
}

export enum ProviderAction {
