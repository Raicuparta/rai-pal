import { Button } from "button.slint";
import { Icon } from "svg_icon.slint";
import { MessageData } from "../app_types.slint";
import { Theme } from "../theme.slint";
import { Modal } from "modal.slint";
import { ActionState } from "../action_state.slint";
import { DialogActions } from "../actions.slint";
import { Tr } from "../translations.slint";
import { ErrorMessage } from "message_state.slint";

export global ConfirmModSourceState {
    in-out property <bool> open: false;
    in property <string> url: "";
    in property <ActionState> state: idle;
    in-out property <MessageData> error;
    in property <[string]> mods;
}

export component ConfirmModSourcePopup inherits Modal {
    open: ConfirmModSourceState.open;
    title: @tr("urlModSources" => "Confirm Mod Source");

    closed => {
        ConfirmModSourceState.open = false;
        DialogActions.cancel-url-mod-source();
    }

    Text {
        text: ConfirmModSourceState.url;
        font-size: Theme.font-sm;
        opacity: 0.7;
        wrap: word-wrap;
    }

    if ConfirmModSourceState.state == ActionState.loading && ConfirmModSourceState.mods.length == 0: Text {
        text: @tr("urlModSources" => "Loading mods...");
    }

    if Tr.has-message(ConfirmModSourceState.error): ErrorMessage {
        message: ConfirmModSourceState.error;
    }

    if (ConfirmModSourceState.state != ActionState.loading || ConfirmModSourceState.mods.length > 0) && !Tr.has-message(ConfirmModSourceState.error): VerticalLayout {
        spacing: Theme.space-2xs;
        alignment: start;

        Text {
            text: @tr("urlModSources" => "{0} mods found in this source", ConfirmModSourceState.mods.length);
        }

        for mod-title in ConfirmModSourceState.mods: Text {
            text: mod-title;
            font-size: Theme.font-sm;
            wrap: word-wrap;
        }
    }

    HorizontalLayout {
        alignment: end;
        spacing: Theme.space-sm;

        Button {
            text: @tr("urlModSources" => "Cancel");
            icon: Icon.close;
            tint: Theme.surface-background;
            enabled: ConfirmModSourceState.state != ActionState.loading || ConfirmModSourceState.mods.length == 0;

            clicked => {
                root.closed();
            }
        }

        Button {
            text: @tr("urlModSources" => "Add Source");
            icon: Icon.plus;
            tint: Theme.primary;
            enabled: ConfirmModSourceState.state != ActionState.loading && !Tr.has-message(ConfirmModSourceState.error);

            clicked => {
                DialogActions.confirm-url-mod-source();
            }
        }
    }
}
