import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Refresh } from "refresh_button.slint";
import { Tr } from "../translations.slint";
import { Contrast } from "contrast.slint";

export component SidebarSection inherits VerticalLayout {
    vertical-stretch: 0;
    alignment: start;
    padding-left: Theme.space-md;
    padding-right: Theme.space-md;

    @children
}

export component SidebarScroll inherits ScrollView {
    vertical-stretch: 1;

    VerticalLayout {
        alignment: start;
        padding-bottom: Theme.space-md;

        @children
    }
}

export component Sidebar inherits Rectangle {
    in property <string> status-text;

    width: 220px;
    background: Theme.background;

    private property <bool> loading: Refresh.refreshing && Refresh.tasks.length > 0;
    private property <length> font-size: 10px;
    private property <brush> status-background: root.loading ? Theme.primary.darker(1) : Theme.surface-background;
    private property <brush> status-color: Contrast.ink(root.status-background);

    VerticalLayout {
        padding-top: Theme.space-md;

        @children

        Rectangle {
            background: root.status-background;
            height: self.preferred-height;

            VerticalLayout {
                Rectangle {
                    width: 100%;
                    height: Theme.border-width;
                    background: Theme.border;
                }

                HorizontalLayout {
                    alignment: start;
                    spacing: Theme.space-xs;
                    padding: Theme.space-xs;

                    if !loading: Text {
                        text: root.status-text;
                        color: root.status-color;
                        width: 100%;
                        font-size: root.font-size;
                    }

                    if loading: Text {
                        text: @tr("sidebar" => "Loading:");
                        color: root.status-color;
                        font-size: root.font-size;
                    }

                    for task[index] in Refresh.tasks: Text {
                        text: index < Refresh.tasks.length - 1 ? "\{Tr.refresh-task(task)} |" : Tr.refresh-task(task);
                        color: root.status-color;
                        font-size: root.font-size;
                    }
                }
            }
        }
    }

    Rectangle {
        x: parent.width - self.width;
        width: Theme.border-width;
        height: parent.height;
        background: Theme.border;
    }
}
