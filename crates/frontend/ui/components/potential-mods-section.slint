import { PotentialModData } from "../app-types.slint";
import { Theme } from "../theme.slint";
import { RowDivider } from "row-divider.slint";
import { SectionHeader } from "section-header.slint";

component PotentialModRow inherits VerticalLayout {
    in property <PotentialModData> potential-mod;

    vertical-stretch: 0;
    alignment: start;
    spacing: 0px;

    Rectangle {
        height: row-layout.preferred-height;

        row-layout := VerticalLayout {
            padding: Theme.space-sm;
            alignment: start;
            spacing: Theme.space-2xs;

            Text {
                text: potential-mod.title;
                font-weight: Theme.weight-semibold;
                overflow: elide;
            }

            if potential-mod.description != "" : Text {
                height: self.preferred-height;
                text: potential-mod.description;
                font-size: Theme.font-sm;
                opacity: 0.75;
                wrap: word-wrap;
                color: Theme.foreground;
            }
        }
    }

    RowDivider { }
}

export component PotentialModsSection inherits VerticalLayout {
    in property <string> label;
    in property <string> description;
    in property <[PotentialModData]> mods;

    vertical-stretch: 0;
    alignment: start;
    spacing: Theme.space-2xs;

    SectionHeader {
        label: root.label;
        description: root.description;
    }

    for row in root.mods : PotentialModRow {
        potential-mod: row;
    }
}
