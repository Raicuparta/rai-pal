import { GameModData } from "../app_types.slint";
import { Theme } from "../theme.slint";
import { GameModRow } from "game_mod_row.slint";
import { SectionHeader } from "section_header.slint";

export component ModsSection inherits VerticalLayout {
    in property <string> label;
    in property <string> description;
    in property <[GameModData]> mods;

    vertical-stretch: 0;
    alignment: start;
    spacing: Theme.space-2xs;

    SectionHeader {
        label: root.label;
        description: root.description;
    }

    for mod-row in root.mods : GameModRow {
        game-mod: mod-row;
    }
}
