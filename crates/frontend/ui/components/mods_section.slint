import { GameModData } from "../app_types.slint";
import { Theme } from "../theme.slint";
import { GameModRow } from "game_mod_row.slint";
import { LabeledDivider } from "labeled_divider.slint";

export component ModsSection inherits VerticalLayout {
    in property <string> label;
    in property <string> description;
    in property <[GameModData]> mods;

    vertical-stretch: 0;
    alignment: start;
    padding-top: Theme.space-md;


      LabeledDivider {
          label: root.label;
          padding-left: Theme.space-sm;
          padding-right: Theme.space-sm;
          strong: true;
      }

      if root.description != "" : HorizontalLayout {
          height: self.preferred-height;
          padding-left: Theme.space-sm;
          padding-right: Theme.space-sm;

          Text {
              text: root.description;
              opacity: 0.5;
              font-size: Theme.font-sm;
              wrap: word-wrap;
              horizontal-stretch: 1;
          }
      }

    for mod-row in root.mods : GameModRow {
        game-mod: mod-row;
    }
}
