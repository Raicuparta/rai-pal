import { GameModData, ModStatus } from "../app_types.slint";
import { Theme } from "../theme.slint";
import { IconButton } from "icon_button.slint";
import { ModActionsMenu, ModSpecialActionButton } from "mod_actions.slint";
import { ModSummaryView } from "mod_summary.slint";
import { RowDivider } from "row_divider.slint";
import { Icon } from "svg_icon.slint";

export component GameModRow inherits VerticalLayout {
    in property <GameModData> game-mod;

    private property <length> menu-x: root.width - Theme.menu-width;
    private property <length> menu-y: root.height;

    vertical-stretch: 0;
    alignment: start;
    accessible-role: list-item;
    accessible-label: root.game-mod.title;

    menu := ModActionsMenu {
        x: root.menu-x;
        y: root.menu-y;
        actions: root.game-mod.actions;
    }

    Rectangle {
        height: row-layout.preferred-height;
        background: row-touch.has-hover ? Theme.hover-background : transparent;

        row-touch := TouchArea {
            mouse-cursor: pointer;

            clicked => {
                if !(root.game-mod.status == ModStatus.broken) {
                    root.open-menu(
                        max(0px, min(row-touch.pressed-x, root.width - Theme.menu-width)),
                        row-touch.pressed-y,
                    );
                }
            }

            pointer-event(event) => {
                if !(root.game-mod.status == ModStatus.broken)
                    && event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.right {
                    root.open-menu(
                        max(0px, min(row-touch.pressed-x, root.width - Theme.menu-width)),
                        row-touch.pressed-y,
                    );
                }
            }
        }

        row-layout := HorizontalLayout {
            padding: Theme.space-sm;
            spacing: Theme.space-sm;
            cross-axis-alignment: center;

            ModSummaryView {
                horizontal-stretch: 1;
                title: game-mod.title;
                description: game-mod.status == ModStatus.broken ? @tr("gameModRow" => "Broken mod. Uninstall all mods before continuing.") : game-mod.description;
                version-text: game-mod.version-text;
                release-date: game-mod.release-date;
                author: game-mod.author;
                engine-text: game-mod.engine-text;
                deprecated: game-mod.deprecated;
                show-status: true;
                status: game-mod.status;
            }

            HorizontalLayout {
                horizontal-stretch: 0;
                alignment: end;
                spacing: Theme.space-xs;
                min-width: self.preferred-width;

                for action in root.game-mod.special-actions: ModSpecialActionButton {
                    action: action;
                }

                if !(root.game-mod.status == ModStatus.broken): IconButton {
                    icon: Icon.more;
                    icon-size: 22px;
                    tooltip: @tr("gameModRow" => "Mod actions");

                    clicked => {
                        root.open-menu(root.width - Theme.menu-width, root.height);
                    }
                }
            }
        }
    }

    RowDivider { }

    function open-menu(x: length, y: length) {
        root.menu-x = x;
        root.menu-y = y;
        menu.show();
    }
}
