import { ActionKind } from "../action_state.slint";
import { ModActions } from "../actions.slint";
import { GameModData } from "../app_types.slint";
import { Theme } from "../theme.slint";
import { ActionButton } from "action_button.slint";
import { IconButton } from "icon_button.slint";
import { ModSummaryView } from "mod_summary.slint";
import { PopupMenu, PopupMenuItem, PopupMenuSeparator } from "menu.slint";
import { RowDivider } from "row_divider.slint";
import { Icon } from "svg_icon.slint";

export component GameModRow inherits VerticalLayout {
    in property <GameModData> game-mod;

    private property <length> menu-x: 0;
    private property <length> menu-y: 0;

    vertical-stretch: 0;
    alignment: start;
    spacing: 0px;

    menu := PopupMenu {
        x: root.menu-x;
        y: root.menu-y;

        if game-mod.can-edit-config: PopupMenuItem {
            text: @tr("gameModRow" => "Edit Mod Config");
            icon: Icon.settings;

            clicked => {
                ModActions.configure(game-mod.mod-id);
                menu.close();
            }
        }

        if game-mod.can-edit-config: PopupMenuItem {
            text: @tr("gameModRow" => "Open folder containing this mod's config files");
            icon: Icon.folder-mods;

            clicked => {
                ModActions.configure-folder(game-mod.mod-id);
                menu.close();
            }
        }

        if game-mod.can-edit-config: PopupMenuSeparator { }

        if game-mod.can-open-mod-folder: PopupMenuItem {
            text: @tr("gameModRow" => "Open Mod Folder");
            icon: Icon.folder-mods;

            clicked => {
                ModActions.open-folder(game-mod.mod-id);
                menu.close();
            }
        }

        if game-mod.can-download-config: PopupMenuItem {
            text: @tr("gameModRow" => "Download Recommended Config");
            icon: Icon.download;

            clicked => {
                ModActions.download-config(game-mod.mod-id);
                menu.close();
            }
        }

        if game-mod.can-download-config: PopupMenuSeparator { }

        if game-mod.can-reinstall: PopupMenuItem {
            text: @tr("gameModRow" => "Reinstall");
            icon: Icon.reinstall;

            clicked => {
                ModActions.reinstall(game-mod.mod-id);
                menu.close();
            }
        }

        if game-mod.can-uninstall: PopupMenuItem {
            text: @tr("gameModRow" => "Uninstall");
            icon: Icon.uninstall;
            enabled: !game-mod.has-installed-dependants;

            clicked => {
                ModActions.uninstall(game-mod.mod-id);
                menu.close();
            }
        }
    }

    Rectangle {
        height: row-layout.preferred-height;
        background: !game-mod.incompatible && row-touch.has-hover ? Theme.hover-background : transparent;

        row-touch := TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                    root.menu-x = max(0px, min(row-touch.pressed-x, root.width - Theme.menu-width));
                    root.menu-y = row-touch.pressed-y;
                    menu.show();
                }
            }
        }

        row-layout := HorizontalLayout {
            padding: Theme.space-sm;
            spacing: Theme.space-sm;
            cross-axis-alignment: center;

        ModSummaryView {
            horizontal-stretch: 1;
            title: game-mod.title;
            description: game-mod.description;
            version-text: game-mod.version-text;
            release-date: game-mod.release-date;
            author: game-mod.author;
            engine-text: game-mod.engine-text;
            deprecated: game-mod.deprecated;
            has-remote-config: game-mod.has-remote-config;
            show-status: game-mod.show-status;
            installed: game-mod.installed;
            outdated: game-mod.outdated;
        }

        if game-mod.can-show-actions: HorizontalLayout {
            horizontal-stretch: 0;
            alignment: end;
            spacing: Theme.space-xs;
            min-width: self.preferred-width;

            if game-mod.can-install: ActionButton {
                text: @tr("gameModRow" => "Install");
                icon: Icon.install;
                action-key: { kind: ActionKind.game-mod-install, target: game-mod.mod-id };

                clicked => {
                    ModActions.request-install(
                        game-mod.mod-id,
                        @tr("gameModRow" => "Attention: be careful when installing mods on multiplayer games! Anticheat can detect some mods and get you banned, even if the mods seem harmless."),
                        @tr("gameModRow" => "Install"),
                        "install-mod-confirm",
                    );
                }
            }

            if game-mod.can-update: ActionButton {
                text: @tr("gameModRow" => "Update");
                icon: Icon.update;
                tint: Theme.status-success;
                action-key: { kind: ActionKind.game-mod-install, target: game-mod.mod-id };

                clicked => {
                    ModActions.update(game-mod.mod-id);
                }
            }

            if game-mod.can-run: ActionButton {
                text: @tr("gameModRow" => "Run");
                icon: Icon.play;
                action-key: { kind: ActionKind.game-mod-run, target: game-mod.mod-id };

                clicked => {
                    ModActions.run(game-mod.mod-id);
                }
            }

            actions-button := IconButton {
                visible: game-mod.can-edit-config || game-mod.can-open-mod-folder || game-mod.can-download-config || game-mod.can-reinstall || game-mod.can-uninstall;
                icon: Icon.more;
                icon-size: 22px;
                tooltip: @tr("gameModRow" => "Mod actions");

                clicked => {
                    root.menu-x = actions-button.absolute-position.x - root.absolute-position.x + actions-button.width - Theme.menu-width;
                    root.menu-y = actions-button.absolute-position.y - root.absolute-position.y + actions-button.height;
                    menu.show();
                }
            }
        }
    }

    }

    RowDivider { }
}
