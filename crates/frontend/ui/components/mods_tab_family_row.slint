import { ModsTabItemData } from "../app_types.slint";
import { Theme } from "../theme.slint";
import { ModsTabRow } from "mods_tab_row.slint";
import { Chevron, ChevronDirection } from "chevron.slint";
import { RowDivider } from "row_divider.slint";

export component ModsTabFamilyRow inherits Rectangle {
    in property <ModsTabItemData> item;

    property <bool> expanded: false;

    vertical-stretch: 0;

    VerticalLayout {
        alignment: start;

        VerticalLayout {
            alignment: start;

            Rectangle {
                background: header-touch.has-hover ? Theme.hover-background : transparent;
                forward-focus: header-focus;
                accessible-role: button;
                accessible-label: root.item.family-title;
                accessible-action-default => {
                    root.expanded = !root.expanded;
                };

                HorizontalLayout {
                padding: Theme.space-sm;
                spacing: Theme.space-sm;
                cross-axis-alignment: center;

                Chevron {
                    direction: root.expanded ? ChevronDirection.down : ChevronDirection.right;
                    size: Theme.space-lg;
                    color: Theme.dimmed-foreground;
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: start;
                    spacing: Theme.space-2xs;

                    Text {
                        text: root.item.family-title;
                        font-size: Theme.font-lg;
                        font-weight: Theme.weight-bold;
                        overflow: elide;
                    }

                    if root.item.family-description != "": Text {
                        height: self.preferred-height;
                        text: root.item.family-description;
                        font-size: Theme.font-sm;
                        opacity: 0.75;
                        wrap: word-wrap;
                    }
                }
            }

                if header-focus.has-focus: Rectangle {
                    border-width: Theme.border-width * 2;
                    border-color: Theme.primary;
                    border-radius: Theme.radius-sm;
                }

                header-touch := TouchArea {
                    mouse-cursor: pointer;

                    clicked => {
                        root.expanded = !root.expanded;
                    }
                }

                header-focus := FocusScope {
                    width: 0;
                    height: 0;
                    key-pressed(event) => {
                        if event.text == Key.Space || event.text == Key.Return {
                            root.expanded = !root.expanded;
                            return accept;
                        }
                        return reject;
                    }
                }
            }

            RowDivider { }
        }

        if root.expanded: VerticalLayout {
            alignment: start;

            for mod-row in root.item.mods: ModsTabRow {
                mod-data: mod-row;
                indented: true;
            }
        }
    }
}
