import { ActionKind } from "../action_state.slint";
import { ScrollView } from "std-widgets.slint";
import { ModActions } from "../actions.slint";
import { Theme } from "../theme.slint";
import { ActionButton } from "action_button.slint";
import { GameRow } from "game_row.slint";
import { GameSidebar } from "game_sidebar.slint";
import { ModsSection } from "mods_section.slint";
import { PotentialModsSection } from "potential_mods_section.slint";
import { Icon } from "svg_icon.slint";
import { GameModData, GameRowData, PotentialModData } from "../app_types.slint";
import { GamesActions } from "../actions.slint";

export global GameMods {
    in property <[GameModData]> installed;
    in property <[GameModData]> available;
    in property <[GameModData]> hidden;
    in property <[GameModData]> incompatible;
    in property <[PotentialModData]> potential;
}

export component GameDetailsPage inherits HorizontalLayout {
    in property <GameRowData> game-row;
    in property <bool> show-thumbnail: true;

    GameSidebar { }

    ScrollView {
        VerticalLayout {
            alignment: start;
            spacing: Theme.space-sm;

            GameRow {
                vertical-stretch: 0;
                game-row: root.game-row;
                show-thumbnail: root.show-thumbnail;

                selected(index) => {
                    GamesActions.back();
                }
            }

            if GameMods.installed.length + GameMods.available.length + GameMods.hidden.length + GameMods.incompatible.length + GameMods.potential.length == 0: HorizontalLayout {
                height: self.preferred-height;
                padding-left: Theme.space-sm;
                padding-right: Theme.space-sm;

                Text {
                    text: @tr("gameModal" => "Nothing! None of the available mods are of any use for this game. Try something else.");
                    opacity: 0.75;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }

            if !root.game-row.installed && GameMods.potential.length > 0: PotentialModsSection {
                label: @tr("gameModal" => "Potentially compatible mods");
                description: @tr("gameModal" => "Install this game to see more detailed information about which mods are compatible");
                mods: GameMods.potential;
            }

            if root.game-row.installed: VerticalLayout {
                alignment: start;
                vertical-stretch: 0;
                spacing: Theme.space-sm;

                if GameMods.installed.length > 0: VerticalLayout {
                    alignment: start;
                    vertical-stretch: 0;
                    spacing: Theme.space-xs;

                    ModsSection {
                        label: @tr("gameModal" => "Installed Mods");
                        mods: GameMods.installed;
                    }

                    HorizontalLayout {
                        padding-left: Theme.space-sm;
                        padding-right: Theme.space-sm;
                        alignment: start;

                        ActionButton {
                            vertical-stretch: 0;
                            text: @tr("gameModal" => "Uninstall all mods");
                            icon: Icon.delete;
                            action-key: { kind: ActionKind.game-mod-uninstall-all, target: "" };
                            tint: Theme.danger;

                            clicked => {
                                ModActions.request-uninstall-all();
                            }
                        }
                    }
                }

                if GameMods.available.length > 0: ModsSection {
                    label: @tr("gameModal" => "Available Mods");
                    mods: GameMods.available;
                }

                if GameMods.hidden.length > 0: ModsSection {
                    label: @tr("gameModal" => "Other things");
                    description: @tr("gameModal" => "These are mostly dependencies and other stuff that you don't usually need to mess with directly.");
                    mods: GameMods.hidden;
                }

                if GameMods.incompatible.length > 0: ModsSection {
                    label: @tr("gameModal" => "Incompatible Mods");
                    description: @tr("gameModal" => "The mods listed here can't be installed because they aren't compatible with this game's engine version.");
                    mods: GameMods.incompatible;
                }
            }
        }
    }
}
