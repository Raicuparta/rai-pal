import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { IconButton } from "icon_button.slint";
import { Icon } from "svg_icon.slint";
import { EscapeScope } from "escape_scope.slint";
import { FocusState } from "focus_ring.slint";

export global Viewport {
    in-out property <length> width: 0;
    in-out property <length> height: 0;
}

export enum ModalSize {
    small,
    big,
    ginormous,
}

export component Modal inherits Rectangle {
    in property <string> title;
    in property <ModalSize> size: small;
    in property <bool> fill-height: false;
    in property <bool> grow-width: false;
    in-out property <bool> open: false;
    in property <bool> close-on-click-outside: true;
    in property <bool> show-close-button: true;
    in property <bool> default-action-enabled: false;
    callback closed;
    callback default-action;

    width: 0;
    height: 0;

    private property <length> modal-margin: Theme.space-2xl;
    private property <length> modal-padding: Theme.space-xl;

    function dismiss() {
        root.closed();
    }

    pure function modal-width(natural-width: length, available-width: length) -> length {
        if root.size == ModalSize.ginormous {
            return available-width;
        }
        if root.grow-width {
            return max(360px, natural-width);
        }
        if root.size == ModalSize.small {
            return min(natural-width, 360px);
        }
        if root.size == ModalSize.big {
            return 700px;
        }
        return available-width;
    }

    init => {
        if root.open {
            popup.show();
        }
    }

    changed open => {
        if root.open {
            popup.show();
        } else {
            popup.close();
        }
    }

    private property <bool> popup-open: popup.is-open;

    changed popup-open => {
        FocusState.popup-open = root.popup-open;
    }

    popup := PopupWindow {
        x: 0;
        y: 0;
        width: Viewport.width > 0 ? Viewport.width : 800px;
        height: Viewport.height > 0 ? Viewport.height : 500px;
        close-policy: no-auto-close;
        forward-focus: modal-scope;

        Rectangle {
            background: Theme.overlay;

            TouchArea {
                clicked => {
                    if root.close-on-click-outside {
                        root.dismiss();
                    }
                }
            }
        }

        Rectangle {
            private property <length> available-width: parent.width - root.modal-margin * 2;
            private property <length> natural-width: max(header.preferred-width, body-layout.preferred-width) + root.modal-padding * 2;

            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(root.modal-width(self.natural-width, self.available-width), self.available-width);
            height: root.fill-height ? parent.height - root.modal-margin * 2 : min(header.preferred-height + body-layout.preferred-height + root.modal-padding * 2 + Theme.space-md, parent.height - root.modal-margin * 2);
            background: Theme.background;
            border-width: Theme.border-width;
            border-color: Theme.border;
            border-radius: Theme.radius-md;
            clip: true;

            TouchArea { }

            modal-scope := EscapeScope {
                escape-enabled: root.show-close-button;
                default-action-enabled: root.default-action-enabled;

                escaped => {
                    root.dismiss();
                }

                default-action => {
                    root.default-action();
                }

                VerticalLayout {
                    padding: root.modal-padding;
                    spacing: Theme.space-md;

                    header := HorizontalLayout {
                        spacing: Theme.space-sm;
                        cross-axis-alignment: center;

                        Text {
                            text: root.title;
                            font-size: Theme.font-xl;
                            font-weight: Theme.weight-bold;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        if root.show-close-button: IconButton {
                            icon: Icon.close;
                            icon-size: Theme.font-xl;
                            tooltip: @tr("debugData" => "Close");

                            clicked => {
                                root.dismiss();
                            }
                        }
                    }

                    body-scroll := ScrollView {
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                        body-layout := VerticalLayout {
                            width: body-scroll.visible-width;
                            height: max(self.preferred-height, body-scroll.visible-height);
                            cross-axis-alignment: stretch;
                            spacing: Theme.space-md;
                            @children
                        }
                    }
                }
            }
        }
    }
}
