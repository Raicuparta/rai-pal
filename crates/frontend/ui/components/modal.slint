import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { IconButton } from "icon_button.slint";
import { Icon } from "svg_icon.slint";

export global Viewport {
    in-out property <length> width: 0;
    in-out property <length> height: 0;
}

export component Modal inherits Rectangle {
    in property <string> title;
    in property <bool> big: false;
    in-out property <bool> open: false;
    in property <bool> close-on-click-outside: true;
    in property <bool> show-close-button: true;
    in property <Icon> header-action-icon: Icon.none;
    in property <string> header-action-tooltip: "";

    callback closed;
    callback header-action-clicked;

    width: 0;
    height: 0;

    private property <length> modal-max-width: root.big ? 700px : 360px;
    private property <length> modal-margin: Theme.space-2xl;
    private property <length> modal-padding: Theme.space-xl;

    function dismiss() {
        root.closed();
    }

    init => {
        if root.open {
            popup.show();
        }
    }

    changed open => {
        if root.open {
            popup.show();
        } else {
            popup.close();
        }
    }

    popup := PopupWindow {
        x: 0;
        y: 0;
        width: Viewport.width > 0 ? Viewport.width : 800px;
        height: Viewport.height > 0 ? Viewport.height : 500px;
        close-policy: no-auto-close;

        Rectangle {
            background: Theme.overlay;

            TouchArea {
                clicked => {
                    if root.close-on-click-outside {
                        root.dismiss();
                    }
                }
            }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(root.big ? root.modal-max-width : max(header.preferred-width, body-layout.preferred-width) + root.modal-padding * 2, root.modal-max-width, parent.width - root.modal-margin * 2);
            height: root.big ? parent.height - root.modal-margin * 2 : min(header.preferred-height + body-layout.preferred-height + root.modal-padding * 2 + Theme.space-md, parent.height - root.modal-margin * 2);
            background: Theme.background;
            border-width: Theme.border-width;
            border-color: Theme.border;
            border-radius: Theme.radius-md;
            clip: true;

            TouchArea { }

            VerticalLayout {
                padding: root.modal-padding;
                spacing: Theme.space-md;

                header := HorizontalLayout {
                    spacing: Theme.space-sm;
                    cross-axis-alignment: center;

                    Text {
                        text: root.title;
                        font-size: Theme.font-xl;
                        font-weight: Theme.weight-bold;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    if root.header-action-icon != Icon.none : IconButton {
                        icon: root.header-action-icon;
                        tooltip: root.header-action-tooltip;

                        clicked => {
                            root.header-action-clicked();
                        }
                    }

                    if root.show-close-button : IconButton {
                        icon: Icon.close;
                        icon-size: Theme.font-xl;
                        tooltip: @tr("debugData" => "Close");

                        clicked => {
                            root.dismiss();
                        }
                    }
                }

                body-scroll := ScrollView {
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                    body-layout := VerticalLayout {
                        width: body-scroll.visible-width;
                        height: max(self.preferred-height, body-scroll.visible-height);
                        cross-axis-alignment: stretch;
                        spacing: Theme.space-md;
                        @children
                    }
                }
            }
        }
    }
}
