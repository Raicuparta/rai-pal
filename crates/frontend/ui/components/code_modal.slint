import { ActionKind, ActionKey } from "../action_state.slint";
import { TextEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ActionButton } from "action_button.slint";
import { Button } from "button.slint";
import { Icon } from "svg_icon.slint";
import { Modal } from "modal.slint";

component CodeEditor inherits Rectangle {
    in-out property <string> text;
    in property <bool> read-only: false;
    in property <int> scroll-revision: 0;
    in property <int> reset-scroll-revision: 0;
    in property <TextWrap> wrap: no-wrap;

    callback edited(text: string);
    callback key-pressed(event: KeyEvent) -> EventResult;
    callback key-released(event: KeyEvent) -> EventResult;

    private property <bool> auto-scroll: false;
    private property <bool> external-update: false;
    private property <length> last-scroll-y: 0px;
    private property <length> copy-scroll-y: 0px;
    private property <length> current-scroll-y: edit.content-y;
    private property <length> total-content-height: edit.content-height;

    function scroll-to-bottom() {
        edit.content-y = min(0px, edit.visible-height - root.total-content-height);
    }

    pure function at-bottom() -> bool {
        return root.total-content-height <= edit.visible-height + 1px
            || root.current-scroll-y <= edit.visible-height - root.total-content-height + 1px;
    }

    public function copy-all() {
        root.copy-scroll-y = edit.content-y;
        edit.select-all();
        edit.copy();
        edit.clear-selection();
        edit.content-y = root.copy-scroll-y;
    }

    changed reset-scroll-revision => {
        edit.content-y = 0px;
        root.last-scroll-y = 0px;
        root.auto-scroll = false;
        root.external-update = false;
    }

    changed scroll-revision => {
        root.external-update = true;
    }

    Timer {
        interval: 100ms;
        running: root.external-update;

        triggered => {
            root.external-update = false;
        }
    }

    changed current-scroll-y => {
        if root.external-update {
            if root.auto-scroll {
                root.scroll-to-bottom();
            } else {
                edit.content-y = root.last-scroll-y;
            }
        } else {
            root.last-scroll-y = root.current-scroll-y;
            root.auto-scroll = root.at-bottom();
        }
    }

    changed total-content-height => {
        if root.auto-scroll {
            root.scroll-to-bottom();
        } else if root.external-update {
            edit.content-y = root.last-scroll-y;
        }
    }

    edit := TextEdit {
        width: 100%;
        height: 100%;
        text <=> root.text;
        read-only: root.read-only;
        wrap: root.wrap;
        font-size: Theme.font-sm;

        edited(text) => {
            root.edited(text);
        }

        key-pressed(event) => {
            root.key-pressed(event)
        }

        key-released(event) => {
            root.key-released(event)
        }
    }
}

export component CodeModal inherits Modal {
    in-out property <string> text;
    in property <bool> read-only: false;
    in property <TextWrap> wrap: no-wrap;
    in property <bool> has-folder-actions: false;
    in property <bool> has-copy-action: false;
    in property <bool> has-save-action: false;
    in property <bool> save-enabled: false;
    in property <ActionKey> save-action-key: { kind: ActionKind.none, target: "" };
    in property <int> scroll-revision: 0;
    in property <int> reset-scroll-revision: 0;

    callback request-open-folder;
    callback request-open-file;
    callback request-save;
    callback text-changed(text: string);

    big: true;
    fill-height: true;

    private property <bool> copied: false;

    Timer {
        interval: 2s;
        running: root.copied;

        triggered => {
            root.copied = false;
        }
    }

    VerticalLayout {
        spacing: Theme.space-md;
        vertical-stretch: 1;

        editor := CodeEditor {
            text <=> root.text;
            read-only: root.read-only;
            wrap: root.wrap;
            scroll-revision: root.scroll-revision;
            reset-scroll-revision: root.reset-scroll-revision;
            vertical-stretch: 1;

            edited(text) => {
                root.text-changed(text);
            }
        }

        HorizontalLayout {
            spacing: Theme.space-sm;

            if root.has-copy-action: Button {
                text: @tr("debugData" => "Copy");
                icon: root.copied ? Icon.copied : Icon.copy;
                tint: Theme.surface-background;

                clicked => {
                    editor.copy-all();
                    root.copied = true;
                }
            }

            if root.has-folder-actions: Button {
                text: @tr("gameModRow" => "Open folder");
                icon: Icon.folder;
                tint: Theme.surface-background;

                clicked => {
                    root.request-open-folder();
                }
            }

            if root.has-folder-actions: Button {
                text: @tr("gameModRow" => "Open file");
                icon: Icon.file;
                tint: Theme.surface-background;

                clicked => {
                    root.request-open-file();
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            if root.has-save-action: ActionButton {
                text: @tr("commandButton" => "Save");
                icon: Icon.check;
                action-key: root.save-action-key;
                enabled: root.save-enabled;
                tint: Theme.primary;

                clicked => {
                    root.request-save();
                }
            }
        }
    }
}
