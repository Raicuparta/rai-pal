import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { LabeledDivider } from "labeled_divider.slint";
import { ListRow } from "list_row.slint";
import { Icon, SvgIcon } from "svg_icon.slint";

export component PopupMenu inherits PopupWindow {
    in property <length> menu-width: Theme.menu-width;
    in property <length> max-menu-height: 600px;

    close-policy: PopupClosePolicy.close-on-click-outside;
    width: root.menu-width;
    height: menu-surface.height;

    menu-surface := Rectangle {
        width: 100%;
        height: min(menu-layout.preferred-height + Theme.border-width * 2, root.max-menu-height);
        background: Theme.background;
        border-width: Theme.border-width;
        border-color: Theme.border;
        border-radius: Theme.radius-sm;
        clip: true;
        drop-shadow-offset-y: 5px;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000066;

        ScrollView {
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;

            menu-layout := VerticalLayout {
                spacing: 0px;

                @children
            }
        }
    }
}

export component PopupMenuItem inherits ListRow {
    in property <string> text;
    in property <Icon> icon: Icon.none;
    in property <bool> checkable: false;
    in property <bool> checked: false;

    accessible-label: root.text;

    SvgIcon {
        icon: root.checked ? Icon.check : root.icon;
        color: root.enabled ? Theme.foreground : Theme.dimmed-foreground;
    }

    Text {
        text: root.text;
        color: root.enabled ? Theme.foreground : Theme.dimmed-foreground;
        vertical-alignment: center;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

export component PopupMenuSeparator inherits Rectangle {
    vertical-stretch: 0;
    height: Theme.space-sm;
    background: transparent;

    Rectangle {
        x: Theme.space-sm;
        width: parent.width - Theme.space-lg;
        y: (parent.height - self.height) / 2;
        height: Theme.border-width;
        background: Theme.border;
    }
}

export component PopupMenuSectionTitle inherits LabeledDivider {
    padding-left: Theme.space-xs;
    padding-right: Theme.space-xs;
    padding-top: Theme.space-xs;
    padding-bottom: Theme.space-xs;
}
