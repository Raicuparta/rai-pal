import { Theme } from "../theme.slint";
import { ActivationScope } from "activation_scope.slint";
import { FocusState } from "focus_ring.slint";
import { Chevron } from "chevron.slint";
import { Icon, SvgIcon } from "svg_icon.slint";
import { PopupMenu, PopupMenuItem } from "menu.slint";

export struct SelectOption {
    label: string,
    value: string,
}

export component SelectMenu inherits Rectangle {
    in property <[SelectOption]> options;
    in property <string> leading-label: "";
    in-out property <int> selected-index: 0;
    in property <Icon> icon;

    callback selected(index: int);

    horizontal-stretch: 1;
    height: Theme.control-height;
    border-width: Theme.border-width;
    border-color: focus-scope.has-focus && FocusState.keyboard-navigation ? Theme.primary : Theme.border;
    border-radius: Theme.radius-sm;
    background: touch-area.pressed ? Theme.pressed-background : touch-area.has-hover ? Theme.hover-background : Theme.surface-background;
    forward-focus: focus-scope;
    accessible-role: combobox;
    accessible-label: root.current-label;
    accessible-action-default => {
        menu.show();
    };

    private property <string> current-label: root.selected-index < 0 ? root.leading-label : root.selected-index < root.options.length ? root.options[root.selected-index].label : "";

    HorizontalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;
        spacing: Theme.space-xs;
        cross-axis-alignment: center;

        SvgIcon {
            icon: root.icon;
        }

        Text {
            text: root.current-label;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Chevron {
            color: Theme.dimmed-foreground;
        }
    }

    touch-area := TouchArea {
        mouse-cursor: pointer;

        clicked => {
            menu.show();
        }
    }

    focus-scope := ActivationScope {
        activated => {
            menu.show();
        }
    }

    menu := PopupMenu {
        x: 0;
        y: root.height;
        menu-width: root.width;

        if root.leading-label != "": PopupMenuItem {
            text: root.leading-label;
            checked: root.selected-index < 0;

            clicked => {
                root.selected(-1);
                menu.close();
            }
        }

        for option[index] in root.options: PopupMenuItem {
            text: option.label;
            checked: index == root.selected-index;

            clicked => {
                root.selected(index);
                menu.close();
            }
        }
    }
}
