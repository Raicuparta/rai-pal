import { Theme } from "../theme.slint";
import { Icon, SvgIcon } from "svg_icon.slint";

component MetaItem inherits HorizontalLayout {
    in property <Icon> icon: Icon.none;
    in property <string> text;
    in property <string> tooltip: "";
    in property <brush> color: Theme.foreground;

    spacing: Theme.space-2xs;
    horizontal-stretch: 0;
    cross-axis-alignment: center;

    SvgIcon {
        icon: root.icon;
        size: Theme.font-xs;
        color: root.color;
    }

    Text {
        text: root.text;
        font-size: Theme.font-xs;
        color: root.color;
        overflow: elide;

        if root.tooltip != "": Tooltip {
            text: @markdown("\{root.tooltip}");
        }
    }
}

export component ModSummaryView inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    in property <string> version-text;
    in property <string> release-date;
    in property <string> author;
    in property <string> engine-text;
    in property <bool> deprecated: false;
    in property <bool> show-status: false;
    in property <bool> installed: false;
    in property <bool> outdated: false;
    in property <bool> link-only: false;

    property <bool> has-details: deprecated || version-text != "" || release-date != "" || author != "" || engine-text != "";

    private property <string> deprecated-tooltip: @tr("modsPage" => "This mod is deprecated. You should uninstall it and install a newer alternative.");

    spacing: Theme.space-sm;
    cross-axis-alignment: center;

    if show-status: SvgIcon {
        icon: link-only ? Icon.external-link : outdated ? Icon.outdated : installed ? Icon.success : Icon.mod-not-installed;
        size: 22px;
        color: link-only ? Theme.highlight : outdated ? Theme.status-warning : installed ? Theme.status-success : Theme.dimmed-foreground;
    }

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: start;
        spacing: Theme.space-2xs;

        HorizontalLayout {
            spacing: Theme.space-sm;
            cross-axis-alignment: center;

            Text {
                text: root.title;
                font-weight: Theme.weight-semibold;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        if root.has-details: FlexboxLayout {
            height: self.preferred-height;
            spacing-horizontal: Theme.space-md;
            spacing-vertical: Theme.space-2xs;
            cross-axis-alignment: center;

            if root.deprecated: MetaItem {
                icon: Icon.deprecated;
                text: @tr("modsPage" => "Deprecated");
                tooltip: root.deprecated-tooltip;
                color: Theme.deprecated-foreground;
            }

            if root.version-text != "": Text {
                text: root.version-text;
                font-size: Theme.font-xs;
                color: Theme.foreground;
                opacity: 0.4;
                horizontal-stretch: 0;
                overflow: elide;
            }

            if root.release-date != "": MetaItem {
                icon: Icon.calendar;
                text: root.release-date;
                opacity: 0.4;
            }

            if root.author != "": MetaItem {
                icon: Icon.user;
                text: root.author;
                opacity: 0.4;
            }

            if root.engine-text != "": MetaItem {
                icon: Icon.engine;
                text: root.engine-text;
                opacity: 0.4;
            }
        }

        if root.description != "": Text {
            height: self.preferred-height;
            text: root.description;
            font-size: Theme.font-sm;
            opacity: 0.75;
            overflow: elide;
            color: Theme.foreground;
        }
    }
}
