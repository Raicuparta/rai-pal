import { Theme } from "../theme.slint";
import { Tr } from "../translations.slint";
import { Icon } from "svg-icon.slint";
import { Button } from "button.slint";

export global Refresh {
    in-out property <bool> refreshing: false;
    in property <string> task-names: "";

    callback refresh-all;
}

export component RefreshButton inherits Button {
    text: Refresh.refreshing ? Tr.refresh-loading(Refresh.task-names) : @tr("refresh" => "Refresh");
    icon: Refresh.refreshing ? Icon.refreshing : Icon.refresh;
    tint: Theme.primary;
    enabled: !Refresh.refreshing;

    clicked => {
        Refresh.refresh-all();
    }
}
