import {
    ActionKind,
    ActionKey,
    ActionState,
    ActionStates,
} from "../action_state.slint";
import { Theme } from "../theme.slint";
import { ActionStatusIcon } from "action_status_icon.slint";
import { Contrast } from "contrast.slint";
import { ListRow } from "list_row.slint";
import { Icon } from "svg_icon.slint";

export component SidebarAction inherits ListRow {
    in property <string> text;
    in property <Icon> icon: Icon.none;
    in property <ActionKey> action-key: { kind: ActionKind.none, target: "" };
    in property <bool> highlighted: false;

    private property <ActionState> action-state: ActionState.idle;
    private property <int> state-version: ActionStates.version;
    private property <ActionState> current-state: root.action-state;
    private property <brush> highlighted-ink: Contrast.ink(Theme.primary);
    private property <brush> highlighted-background: root.enabled ? Theme.primary : transparent;
    private property <brush> highlighted-hover-background: Contrast.hover-fill(Theme.primary);
    private property <brush> highlighted-pressed-background: Contrast.pressed-fill(Theme.primary);
    private property <brush> content-color: !root.enabled ? Theme.dimmed-foreground : root.current-state == ActionState.success ? Theme.status-success : root.current-state == ActionState.error ? Theme.status-error : root.highlighted ? root.highlighted-ink : Theme.strong-foreground;

    background-color: root.highlighted ? root.highlighted-background : transparent;
    hover-background: root.highlighted ? root.highlighted-hover-background : Theme.hover-background;
    pressed-background: root.highlighted ? root.highlighted-pressed-background : Theme.pressed-background;
    interactive: root.enabled && root.current-state != ActionState.loading;
    accessible-label: root.text;

    changed action-key => {
        root.update-state();
    }

    changed state-version => {
        root.update-state();
    }

    init => {
        root.update-state();
    }

    function update-state() {
        root.action-state = root.action-key.kind == ActionKind.none ? ActionState.idle : ActionStates.lookup(root.action-key);
    }

    HorizontalLayout {
        padding-left: Theme.space-md;
        spacing: Theme.space-sm;

        ActionStatusIcon {
            state: root.current-state;
            base-icon: root.icon;
            reserve-slot: true;
            color: root.content-color;
        }

        Text {
            text: root.text;
            font-size: Theme.font-sm;
            color: root.content-color;
            overflow: elide;
            horizontal-stretch: 1;
            font-weight: Theme.weight-semibold;
        }
    }
}
