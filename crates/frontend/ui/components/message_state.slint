import { MessageData } from "../app_types.slint";
import { Tr } from "../translations.slint";
import { Theme } from "../theme.slint";

export component MessageState inherits Rectangle {
    in property <string> message;

    background: Theme.tag-background;
    border-radius: Theme.radius-md;

    VerticalLayout {
        padding: Theme.space-md;

        Text {
            text: root.message;
            wrap: word-wrap;
            color: Theme.foreground;
        }
    }
}

export component ErrorMessage inherits Text {
    in property <MessageData> message;

    text: Tr.message(root.message);
    color: Theme.status-error;
    font-size: Theme.font-sm;
    wrap: word-wrap;
    height: self.preferred-height;
}
