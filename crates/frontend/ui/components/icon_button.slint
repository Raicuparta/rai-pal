import { BaseButton } from "base_button.slint";
import { Icon, SvgIcon } from "svg_icon.slint";

export component IconButton inherits BaseButton {
    in property <Icon> icon: Icon.none;
    in property <length> icon-size: 14px;

    private property <length> size: icon-size * 1.2;

    width: size;
    height: size;
    border-radius: size / 2;

    accessible-label: root.tooltip;

    if root.icon != Icon.none: SvgIcon {
        icon: root.icon;
        size: root.icon-size;
        color: root.ink-color;
    }
}
