import {
    FilterGroupData,
    FilterGroupId,
    FilterValueData,
    FilterValueLabel,
    FilterValueNote,
} from "../app_types.slint";
import { Tr } from "../translations.slint";
import { Theme } from "../theme.slint";
import { Button } from "button.slint";
import { IconButton } from "icon_button.slint";
import { BaseButton } from "base_button.slint";
import { ResetButton } from "reset_button.slint";
import { Chevron, ChevronDirection } from "chevron.slint";
import { Icon, SvgIcon } from "svg_icon.slint";
import { CheckBoxMark } from "check_box.slint";
import { LabeledDivider } from "labeled_divider.slint";
import { SidebarScroll } from "sidebar.slint";

component FilterValueRow inherits BaseButton {
    in property <FilterValueData> item;

    private property <bool> checked: root.item.enabled && root.item.available;
    private property <bool> show-actions: root.hovered || root.focused || only-button.focused || lock-button.focused;

    callback toggled(checked: bool);
    callback lock-toggled;
    callback only;

    extra-hovered: only-button.hovered || lock-button.hovered;
    inset: Theme.space-sm;
    enabled: root.item.available;
    accessible-label: root.item.label == FilterValueLabel.none ? root.item.display : Tr.filter-value(root.item.label);

    clicked => {
        if !root.item.locked && root.item.available {
            root.toggled(!root.item.enabled);
        }
    }

    filter-content := Rectangle {
        horizontal-stretch: 1;
        height: label-row.preferred-height;

        label-row := HorizontalLayout {
            horizontal-stretch: 1;
            padding-left: root.inset + Theme.space-lg;
            padding-right: root.inset + Theme.space-sm;
            padding-top: Theme.space-xs;
            padding-bottom: Theme.space-xs;
            spacing: Theme.space-sm;
            cross-axis-alignment: center;
            alignment: start;
            opacity: root.item.available ? 1 : 0.5;

            CheckBoxMark {
                checked: root.checked;
            }

            Text {
                text: root.item.label == FilterValueLabel.none ? root.item.display : Tr.filter-value(root.item.label);
                color: root.item.available ? Theme.foreground : Theme.dimmed-foreground;
                horizontal-stretch: 0;
                overflow: elide;
            }

            if root.item.note != FilterValueNote.none: Rectangle {
                width: 12px;
                height: 12px;
                horizontal-stretch: 0;

                SvgIcon {
                    icon: Icon.help;
                    size: 12px;
                    color: Theme.dimmed-foreground;
                }

                Tooltip {
                    text: @markdown("\{Tr.filter-value-note(root.item.note)}");
                }
            }
        }

        HorizontalLayout {
            x: parent.width - self.width - root.inset - Theme.space-sm;
            y: (parent.height - self.height) / 2;
            width: self.preferred-width;
            height: self.preferred-height;
            spacing: Theme.space-xs;
            cross-axis-alignment: center;

            only-button := Button {
                tint: Theme.background;
                text: @tr("filterMenu" => "Only");
                text-size: Theme.font-2xs;
                tooltip: @tr("filterMenu" => "Only show this value");
                visible: !root.item.locked;
                enabled: !root.item.locked && root.item.available;
                opacity: root.show-actions ? 1 : 0;
                reserve-icon-space: false;

                clicked => {
                    root.only();
                }
            }

            lock-button := IconButton {
                icon: root.item.locked ? Icon.locked : Icon.unlocked;
                tooltip: root.item.locked ? @tr("filterMenu" => "Unlock") : @tr("filterMenu" => "Disable and lock");
                opacity: root.item.locked || root.show-actions ? 1 : 0;
                enabled: root.item.available;
                tint: root.item.locked ? Theme.highlight : Theme.background;

                clicked => {
                    root.lock-toggled();
                }
            }
        }
    }
}

component FilterSection inherits Rectangle {
    in property <FilterGroupData> group;

    callback toggled(value: string, checked: bool);
    callback lock-toggled(value: string);
    callback only(value: string);
    callback reset;
    callback expanded-changed(expanded: bool);

    VerticalLayout {
        alignment: start;
        spacing: Theme.border-width;

        filter-row := BaseButton {
            extra-hovered: reset-button.hovered;
            inset: Theme.space-sm;
            accessible-label: Tr.filter-property(root.group.key);

            clicked => {
                root.expanded-changed(!root.group.expanded);
            }

            HorizontalLayout {
                padding-left: filter-row.inset + Theme.space-sm;
                padding-right: filter-row.inset + Theme.space-sm;
                padding-top: Theme.space-xs;
                padding-bottom: Theme.space-xs;
                spacing: Theme.space-sm;
                cross-axis-alignment: center;

                Chevron {
                    direction: root.group.expanded ? ChevronDirection.down : ChevronDirection.right;
                    color: Theme.dimmed-foreground;
                }

                HorizontalLayout {
                    alignment: start;
                    cross-axis-alignment: center;
                    spacing: Theme.space-xs;

                    Text {
                        text: Tr.filter-property(root.group.key);
                        font-weight: Theme.weight-bold;
                        overflow: elide;
                        color: Theme.strong-foreground;
                    }

                    if root.group.has-locked: Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 6px / 2;
                        background: Theme.highlight;
                    }
                }

                reset-button := ResetButton {
                    tooltip: @tr("filterMenu" => "Reset");
                    visible: root.group.has-changes;

                    clicked => {
                        root.reset();
                    }
                }
            }
        }

        if root.group.expanded: VerticalLayout {
            for value in root.group.values: FilterValueRow {
                item: value;

                toggled(checked) => {
                    root.toggled(value.value, checked);
                }

                lock-toggled => {
                    root.lock-toggled(value.value);
                }

                only => {
                    root.only(value.value);
                }
            }
        }
    }
}

export component FilterPanel inherits VerticalLayout {
    in property <[FilterGroupData]> groups;
    in property <bool> have-changes: false;
    in property <bool> have-expanded: false;

    callback filter-toggled(group: FilterGroupId, value: string, checked: bool);
    callback filter-lock-toggled(group: FilterGroupId, value: string);
    callback filter-only(group: FilterGroupId, value: string);
    callback filter-reset(group: FilterGroupId);
    callback filters-reset;
    callback filters-collapse-all;
    callback filters-expand-all;
    callback filter-expanded-changed(group: FilterGroupId, expanded: bool);

    HorizontalLayout {
        vertical-stretch: 0;
        padding-left: Theme.space-lg;
        padding-right: Theme.space-lg;
        padding-bottom: Theme.space-xs;
        spacing: Theme.space-xs;
        cross-axis-alignment: center;

        IconButton {
            icon: root.have-expanded ? Icon.chevron-down : Icon.chevron-right;
            tooltip: root.have-expanded ? @tr("filterMenu" => "Collapse all filters") : @tr("filterMenu" => "Expand all filters");

            clicked => {
                if root.have-expanded {
                    root.filters-collapse-all();
                } else {
                    root.filters-expand-all();
                }
            }
        }

        LabeledDivider {
            label: @tr("filterMenu" => "Filters");
            horizontal-stretch: 1;
        }

        ResetButton {
            tooltip: @tr("filterMenu" => "Reset all filters");
            enabled: root.have-changes;

            clicked => {
                root.filters-reset();
            }
        }
    }

    SidebarScroll {
        for group in root.groups: FilterSection {
            group: group;

            toggled(value, checked) => {
                root.filter-toggled(group.key, value, checked);
            }

            lock-toggled(value) => {
                root.filter-lock-toggled(group.key, value);
            }

            only(value) => {
                root.filter-only(group.key, value);
            }

            reset => {
                root.filter-reset(group.key);
            }

            expanded-changed(expanded) => {
                root.filter-expanded-changed(group.key, expanded);
            }
        }
    }
}
