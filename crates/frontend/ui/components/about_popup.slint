import { Modal } from "modal.slint";

export global AppInfo {
    in property <string> version: "";
    in property <string> renderer: "";
    in property <string> platform: "";
}

export component AboutPopup inherits Modal {
    title: @tr("about" => "About Rai Pal");

    Text {
        text: @tr("about" => "Version: {0}", AppInfo.version);
    }

    Text {
        text: @tr("about" => "Rendering backend: {0}", AppInfo.renderer);
    }

    Text {
        text: @tr("about" => "Platform: {0}", AppInfo.platform);
    }
}
