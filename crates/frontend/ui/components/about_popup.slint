import { Modal } from "modal.slint";

export global AppInfo {
    in property <string> version: "";
    in property <string> renderer: "";
    in property <string> platform: "";
}

export component AboutPopup inherits Modal {
    title: "About Rai Pal";

    Text {
        text: "Version: \{AppInfo.version}";
    }

    Text {
        text: "Rendering backend: \{AppInfo.renderer}";
    }

    Text {
        text: "Platform: \{AppInfo.platform}";
    }
}
