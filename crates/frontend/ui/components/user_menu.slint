import { Theme } from "../theme.slint";
import { NavButton } from "nav_button.slint";
import { Icon, SvgIcon } from "svg_icon.slint";
import { PopupMenu, PopupMenuItem } from "menu.slint";
import { AppActions } from "../actions.slint";
import { ActionState } from "../action_state.slint";

export global UserState {
    in property <bool> logged-in: false;
    in property <ActionState> state: idle;
    in property <string> name: "";
    in property <string> initials: "";
    in property <bool> has-avatar: false;
    in property <image> avatar;
}

export component UserMenu inherits Rectangle {
    private property <string> menu-tooltip: @tr("userMenu" => "User menu");
    private property <length> avatar-size: 24px;

    NavButton {
        clicked => {
            menu.show();
        }

        HorizontalLayout {
            cross-axis-alignment: center;

            if UserState.logged-in: Rectangle {
                width: root.avatar-size;
                height: root.avatar-size;
                border-radius: root.avatar-size / 2;
                background: Theme.foreground;
                clip: true;

                Rectangle {
                    x: Theme.border-width * 2;
                    y: Theme.border-width * 2;
                    width: root.avatar-size - Theme.border-width * 4;
                    height: root.avatar-size - Theme.border-width * 4;
                    border-radius: (root.avatar-size - Theme.border-width * 4) / 2;
                    background: Theme.background;
                    clip: true;

                    if UserState.has-avatar: Image {
                        source: UserState.avatar;
                        width: 100%;
                        height: 100%;
                    }

                    if !UserState.has-avatar: Text {
                        text: UserState.initials;
                        font-size: Theme.font-sm;
                        font-weight: Theme.weight-bold;
                        color: Theme.foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            if !UserState.logged-in: SvgIcon {
                icon: Icon.account;
                size: root.avatar-size;
                color: Theme.foreground;
            }
        }
    }

    menu := PopupMenu {
        x: root.width - Theme.menu-width;
        y: root.height;

        if UserState.logged-in: PopupMenuItem {
            text: UserState.name == "" ? @tr("userMenu" => "Unknown user") : UserState.name;
            enabled: false;
        }

        if UserState.logged-in: PopupMenuItem {
            text: @tr("userMenu" => "Log out");
            enabled: UserState.state != ActionState.loading;

            clicked => {
                AppActions.log-out();
                menu.close();
            }
        }

        if !UserState.logged-in: PopupMenuItem {
            text: @tr("userMenu" => "Sign in with Discord");
            enabled: UserState.state != ActionState.loading;

            clicked => {
                AppActions.log-in();
                menu.close();
            }
        }

        if !UserState.logged-in: PopupMenuItem {
            text: @tr("userMenu" => "Mods can use this to access your Discord username, avatar, roles, etc.");
            enabled: false;
        }
    }

    Tooltip {
        text: @markdown("\{root.menu-tooltip}");
    }
}
