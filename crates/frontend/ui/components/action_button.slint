import { ActionKind, ActionKey, ActionState, ActionStates } from "../action_state.slint";
import { Button } from "button.slint";

export component ActionButton inherits Button {
    in property <ActionKey> action-key: { kind: ActionKind.none, target: "" };

    private property <ActionState> action-state: ActionState.idle;
    private property <int> state-version: ActionStates.version;

    state: root.action-state;

    changed action-key => {
        root.update-state();
    }

    changed state-version => {
        root.update-state();
    }

    init => {
        root.update-state();
    }

    function update-state() {
        root.action-state = ActionStates.lookup(root.action-key);
    }
}
