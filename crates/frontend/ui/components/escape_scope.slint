export component EscapeScope inherits FocusScope {
    in property <bool> escape-enabled: true;
    in property <bool> default-action-enabled: false;

    callback escaped;
    callback default-action;

    key-pressed(event) => {
        if root.escape-enabled && event.text == Key.Escape {
            root.escaped();
            return accept;
        }
        if root.default-action-enabled && event.text == Key.Return {
            root.default-action();
            return accept;
        }
        return reject;
    }
}
