import { Theme } from "../theme.slint";

export component NavButton inherits Rectangle {
    in property <bool> selected;

    callback clicked;

    background: touch-area.pressed ? Theme.pressed-background : touch-area.has-hover ? Theme.hover-background : transparent;
    forward-focus: focus-scope;
    accessible-role: button;
    accessible-action-default => {
        root.clicked();
    };

    HorizontalLayout {
        cross-axis-alignment: center;
        padding: Theme.space-sm;

        @children
    }

    if root.selected: Rectangle {
        y: parent.height - self.height;
        height: 2px;
        background: Theme.primary;
    }

    if focus-scope.has-focus: Rectangle {
        border-width: Theme.border-width * 2;
        border-color: Theme.primary;
        border-radius: Theme.radius-sm;
    }

    touch-area := TouchArea {
        mouse-cursor: pointer;

        clicked => {
            root.clicked();
        }
    }

    focus-scope := FocusScope {
        width: 0;
        height: 0;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}
