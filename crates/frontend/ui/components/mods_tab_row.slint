import { ModsTabModData } from "../app_types.slint";
import { Theme } from "../theme.slint";
import { IconButton } from "icon_button.slint";
import { ModActionsMenu } from "mod_actions.slint";
import { ModSummaryView } from "mod_summary.slint";
import { RowDivider } from "row_divider.slint";
import { Icon } from "svg_icon.slint";

export component ModsTabRow inherits VerticalLayout {
    in property <ModsTabModData> mod-data;

    private property <length> menu-x: root.width - Theme.menu-width;
    private property <length> menu-y: root.height;

    vertical-stretch: 0;
    alignment: start;
    accessible-role: list-item;
    accessible-label: root.mod-data.title;

    menu := ModActionsMenu {
        x: root.menu-x;
        y: root.menu-y;
        actions: root.mod-data.actions;
    }

    Rectangle {
        height: row-layout.preferred-height;
        background: row-touch.has-hover ? Theme.hover-background : transparent;

        row-touch := TouchArea {
            mouse-cursor: pointer;

            clicked => {
                root.open-menu(
                    max(0px, min(row-touch.pressed-x, root.width - Theme.menu-width)),
                    row-touch.pressed-y,
                );
            }

            pointer-event(event) => {
                if event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.right {
                    root.open-menu(
                        max(0px, min(row-touch.pressed-x, root.width - Theme.menu-width)),
                        row-touch.pressed-y,
                    );
                }
            }
        }

        row-layout := HorizontalLayout {
            padding: Theme.space-sm;
            spacing: Theme.space-sm;
            cross-axis-alignment: center;

            ModSummaryView {
                horizontal-stretch: 1;
                title: mod-data.title;
                description: mod-data.description;
                version-text: mod-data.version-text;
                release-date: mod-data.release-date;
                author: mod-data.author;
                engine-text: mod-data.engine-text;
                deprecated: mod-data.deprecated;
            }

            IconButton {
                horizontal-stretch: 0;
                icon: Icon.more;
                icon-size: 22px;
                tooltip: @tr("gameModRow" => "Mod actions");

                clicked => {
                    root.open-menu(root.width - Theme.menu-width, root.height);
                }
            }
        }
    }

    RowDivider { }

    function open-menu(x: length, y: length) {
        root.menu-x = x;
        root.menu-y = y;
        menu.show();
    }
}
