import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { GameRow } from "game_row.slint";
import { MessageState } from "message_state.slint";
import { GameRowData, FilterGroupData } from "../app_types.slint";
import { AppSettings } from "../settings.slint";
import { Refresh, RefreshButton } from "refresh_button.slint";
import { GamesActions } from "../actions.slint";
import { AddGamePopup } from "add_game_popup.slint";
import { IconButton } from "icon_button.slint";
import { LabeledDivider } from "labeled_divider.slint";
import { ResetButton } from "reset_button.slint";
import { FilterGroup } from "filter_group.slint";
import { Sidebar, SidebarScroll, SidebarSection } from "sidebar.slint";
import { SidebarAction } from "sidebar_action.slint";
import { RowDivider } from "row_divider.slint";
import { SearchInput } from "search_input.slint";
import { SelectOption } from "select_menu.slint";
import { SortMenu } from "sort_menu.slint";
import { AddGameState } from "add_game_popup.slint";
import { DialogActions, GamesActions } from "../actions.slint";
import { Icon } from "svg_icon.slint";

export global GamesList {
    in property <[GameRowData]> rows;
    in property <int> total-count: 0;
    in-out property <length> scroll-y: 0px;
    in-out property <int> rows-revision: 0;
}

export global GamesQuery {
    in-out property <string> search-text: "";
    in property <[SelectOption]> sort-options: [
        { label: @tr("gamesSort" => "Name A-Z"), value: "" },
        { label: @tr("gamesSort" => "Name Z-A"), value: "" },
        { label: @tr("gamesSort" => "Engine A-Z"), value: "" },
        { label: @tr("gamesSort" => "Engine Z-A"), value: "" },
        { label: @tr("gamesSort" => "Date Ascending"), value: "" },
        { label: @tr("gamesSort" => "Date Descending"), value: "" },
    ];
    in-out property <int> sort-index: 0;
    in property <[FilterGroupData]> filter-groups;
    in property <bool> filters-have-changes: false;
    in property <bool> filters-have-expanded: false;
}

export component GamesPage inherits Rectangle {
    property <length> list-content-y <=> game-list.content-y;
    property <length> list-visible-height <=> game-list.visible-height;
    private property <length> row-height: Theme.game-row-height + Theme.border-width;
    private property <length> shared-scroll-y <=> GamesList.scroll-y;
    private property <[GameRowData]> rows: GamesList.rows;
    private property <int> rows-revision: GamesList.rows-revision;

    function empty-message() -> string {
        if GamesList.total-count == 0 {
            if Refresh.refreshing {
                return @tr("gamesPage" => "Finding your games...");
            }
        }
        if GamesList.total-count == 0 {
            return @tr("gamesPage" => "Rai Pal didn't find any games at all. Remember Rai Pal needs to find installed apps from other game providers, like Steam, Epic, etc.");
        }
        return @tr("gamesPage" => "Nothing! All of your games are hidden because of the filters you selected. Clear your filters to see your beautiful games again.");
    }

    function notify-visible-range() {
        if (GamesList.rows.length == 0) {
            GamesActions.visible-range-changed(0, -1);
            return;
        }
        let first = max(0, floor(-root.list-content-y / root.row-height));
        let last = min(GamesList.rows.length - 1, max(first, floor((-root.list-content-y + root.list-visible-height - Theme.border-width) / root.row-height)));

        GamesActions.visible-range-changed(first, last);
    }

    init => {
        GamesList.scroll-y = game-list.content-y;
    }

    changed shared-scroll-y => {
        game-list.content-y = root.shared-scroll-y;
    }

    changed rows => {
        root.notify-visible-range();
    }

    changed rows-revision => {
        root.notify-visible-range();
    }

    changed list-content-y => {
        GamesList.scroll-y = game-list.content-y;
        root.notify-visible-range();
    }

    changed list-visible-height => {
        root.notify-visible-range();
    }

    HorizontalLayout {
        Sidebar {
            status-text: @tr("gamesPage" => "{} games", GamesList.rows.length == GamesList.total-count ? GamesList.total-count : "\{GamesList.rows.length} / \{GamesList.total-count}");

            VerticalLayout {
                height: self.preferred-height;
                spacing: Theme.space-sm;
                padding-bottom: Theme.space-sm;

                SidebarSection {
                    spacing: Theme.space-sm;

                    RefreshButton { }
                }

                SidebarAction {
                    text: @tr("manualGames" => "Add games");
                    clicked => {
                        AddGameState.open = true;
                        DialogActions.request-add-game();
                    }
                    icon: Icon.games;
                }

                RowDivider { }

                SidebarSection {
                    spacing: Theme.space-sm;

                    HorizontalLayout {
                        spacing: Theme.space-xs;
                        cross-axis-alignment: center;

                        SearchInput {
                            text <=> GamesQuery.search-text;

                            edited(text) => {
                                GamesActions.search-changed(text);
                            }
                        }

                        SortMenu {
                            options: GamesQuery.sort-options;
                            sort-index <=> GamesQuery.sort-index;

                            sort-changed(index) => {
                                GamesActions.sort-changed(index);
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                vertical-stretch: 0;
                padding-left: Theme.space-sm;
                padding-right: Theme.space-lg;
                padding-bottom: Theme.space-xs;
                spacing: Theme.space-xs;
                cross-axis-alignment: center;

                IconButton {
                    icon: Icon.chevron-up;
                    tooltip: @tr("filterMenu" => "Collapse all filters");
                    enabled: GamesQuery.filters-have-expanded;

                    clicked => {
                        GamesActions.filters-collapse-all();
                    }
                }

                LabeledDivider {
                    label: @tr("filterMenu" => "Filters");
                    horizontal-stretch: 1;
                }

                ResetButton {
                    tooltip: @tr("filterMenu" => "Reset all filters");
                    enabled: GamesQuery.filters-have-changes;

                    clicked => {
                        GamesActions.filters-reset();
                    }
                }
            }

            SidebarScroll {
                for group in GamesQuery.filter-groups: FilterGroup {
                    group: group;
                }
            }
        }

        Rectangle {
            if GamesList.rows.length == 0: VerticalLayout {
                padding: Theme.space-xl;
                alignment: center;

                MessageState {
                    message: root.empty-message();
                }
            }

            game-list := ListView {
                visible: GamesList.rows.length > 0;
                for item[index] in GamesList.rows: GameRow {
                    game-row: item;
                    row-index: index;
                    show-thumbnail: !AppSettings.hide-game-thumbnails;

                    selected(index) => {
                        GamesActions.select-game(index);
                    }

                    init => {
                        GamesActions.request-game(index);
                    }
                }
            }
        }
    }

    AddGamePopup { }
}
