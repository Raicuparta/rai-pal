import { Theme } from "../theme.slint";

export component ListRow inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> interactive: root.enabled;
    in property <bool> extra-hovered: false;
    in property <string> tooltip: "";
    in property <brush> background-color: transparent;
    in property <brush> hover-background: Theme.hover-background;
    in property <brush> pressed-background: Theme.pressed-background;

    out property <bool> hovered: row-touch.has-hover || root.extra-hovered;

    callback clicked;

    vertical-stretch: 0;
    background: !root.enabled ? transparent : row-touch.pressed ? root.pressed-background : root.hovered ? root.hover-background : root.background-color;
    forward-focus: focus-scope;

    accessible-role: button;
    accessible-enabled: root.interactive;
    accessible-action-default => {
        if root.interactive {
            root.clicked();
        }
    }

    row-touch := TouchArea {
        enabled: root.interactive;
        mouse-cursor: pointer;

        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-lg;
        padding-top: Theme.space-xs;
        padding-bottom: Theme.space-xs;
        spacing: Theme.space-sm;
        cross-axis-alignment: center;

        @children
    }

    focus-scope := FocusScope {
        width: 0;
        height: 0;
        enabled: root.interactive;

        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    if root.tooltip != "": Tooltip {
        text: @markdown("\{root.tooltip}");
    }
}
