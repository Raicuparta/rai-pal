import { FilterGroupLabel, FilterValueLabel, FilterValueNote, ProviderAction } from "app_types.slint";
import { AppSettings } from "settings.slint";

export global HostStrings {
    in property <string> select-executable-title: @tr("fileDialog" => "Select the game executable");
    in property <string> windows-executable-filter: @tr("fileDialog" => "Windows executable");
    in property <string> other-executable-filter: @tr("fileDialog" => "Other executable");
    in property <string> select-directory-title: @tr("fileDialog" => "Select a game directory");
    in property <string> refresh-mods-task: @tr("refresh" => "mods");
    in property <string> refresh-remote-data-task: @tr("refresh" => "remote data");
    in property <string> auto-language-label: @tr("appDropdownMenu" => "Auto-detected - {0}", AppSettings.detected-language-name);
    in property <string> sort-name-asc: @tr("gamesSort" => "Name A-Z");
    in property <string> sort-name-desc: @tr("gamesSort" => "Name Z-A");
    in property <string> sort-engine-asc: @tr("gamesSort" => "Engine A-Z");
    in property <string> sort-engine-desc: @tr("gamesSort" => "Engine Z-A");
    in property <string> sort-date-asc: @tr("gamesSort" => "Date Ascending");
    in property <string> sort-date-desc: @tr("gamesSort" => "Date Descending");
}

export global Tr {
    public pure function refresh-loading(items: string) -> string {
        return @tr("refresh" => "Loading {0}...", items);
    }

    public pure function filter-property(label: FilterGroupLabel) -> string {
        if label == FilterGroupLabel.provider {
            return @tr("filterProperty" => "Provider");
        }
        if label == FilterGroupLabel.tag {
            return @tr("filterProperty" => "Tag");
        }
        if label == FilterGroupLabel.architecture {
            return @tr("filterProperty" => "Architecture");
        }
        if label == FilterGroupLabel.executable-os {
            return @tr("filterProperty" => "Executable OS");
        }
        if label == FilterGroupLabel.supported-os {
            return @tr("filterProperty" => "Supported OS");
        }
        if label == FilterGroupLabel.unity-backend {
            return @tr("filterProperty" => "Unity Backend");
        }
        if label == FilterGroupLabel.engine {
            return @tr("filterProperty" => "Engine");
        }
        if label == FilterGroupLabel.status {
            return @tr("filterProperty" => "Install status");
        }
        return @tr("filterProperty" => "Mod");
    }

    public pure function filter-value(label: FilterValueLabel) -> string {
        if label == FilterValueLabel.unknown {
            return @tr("filterValue" => "Unknown");
        }
        if label == FilterValueLabel.arch-64 {
            return @tr("filterValue" => "64-bit");
        }
        if label == FilterValueLabel.arch-32 {
            return @tr("filterValue" => "32-bit");
        }
        if label == FilterValueLabel.tag-demo {
            return @tr("filterValue" => "Demo");
        }
        if label == FilterValueLabel.tag-vr {
            return @tr("filterValue" => "Native VR");
        }
        if label == FilterValueLabel.tag-untagged {
            return @tr("filterValue" => "Untagged");
        }
        if label == FilterValueLabel.status-installed {
            return @tr("filterValue" => "Installed");
        }
        if label == FilterValueLabel.status-not-installed {
            return @tr("filterValue" => "Not installed");
        }
        return @tr("filterValue" => "Manual");
    }

    public pure function filter-value-note(note: FilterValueNote) -> string {
        if note == FilterValueNote.provider-xbox-only-installed {
            return @tr("filterValueNote" => "Only shows PC Xbox games if they're installed.");
        }
        if note == FilterValueNote.engine-godot-not-fully-supported {
            return @tr("filterValueNote" => "Godot games are not fully supported yet.");
        }
        if note == FilterValueNote.engine-game-maker-not-fully-supported {
            return @tr("filterValueNote" => "GameMaker games are not fully supported yet.");
        }
        return "";
    }

    public pure function provider-command(action: ProviderAction) -> string {
        if action == ProviderAction.install {
            return @tr("providerCommand" => "Install");
        }
        if action == ProviderAction.show-in-library {
            return @tr("providerCommand" => "Show In Library");
        }
        if action == ProviderAction.show-in-store {
            return @tr("providerCommand" => "Open Store Page");
        }
        if action == ProviderAction.start-via-provider {
            return @tr("providerCommand" => "Start Game");
        }
        if action == ProviderAction.start-via-exe {
            return @tr("providerCommand" => "Run Game Executable");
        }
        if action == ProviderAction.open-in-browser {
            return @tr("providerCommand" => "Open In Browser");
        }
        return @tr("gameModal" => "Remove from Rai Pal");
    }
}
