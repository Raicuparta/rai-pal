import { Theme } from "../theme.slint";
import { LabeledDivider } from "labeled-divider.slint";

export component SectionHeader inherits VerticalLayout {
    in property <string> label;
    in property <string> description;

    vertical-stretch: 0;
    alignment: start;
    spacing: Theme.space-2xs;

    LabeledDivider {
        label: root.label;
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;
    }

    if root.description != "" : HorizontalLayout {
        height: self.preferred-height;
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;

        Text {
            text: root.description;
            opacity: 0.5;
            font-size: Theme.font-sm;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
}
