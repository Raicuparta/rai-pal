import { FilterGroupData } from "../app-types.slint";
import { Theme } from "../theme.slint";
import { FilterGroup } from "filter-group.slint";
import { IconButton } from "icon-button.slint";
import { LabeledDivider } from "labeled-divider.slint";
import { RefreshButton } from "refresh-button.slint";
import { ResetButton } from "reset-button.slint";
import { SearchInput } from "search-input.slint";
import { Sidebar, SidebarSection } from "sidebar.slint";
import { SortMenu } from "sort-menu.slint";
import { Icon } from "svg-icon.slint";

export component GamesSidebar inherits Sidebar {
    in property <bool> refreshing;
    in property <string> refresh-task-names;
    in-out property <string> search-text: "";
    in-out property <int> sort-index: 0;
    in property <[FilterGroupData]> filter-groups;
    in property <bool> filters-have-changes;
    in property <bool> filters-have-expanded;

    callback refresh-all;
    callback search-changed(text: string);
    callback sort-changed(index: int);
    callback filter-toggled(group: string, value: string, checked: bool);
    callback filter-lock-toggled(group: string, value: string);
    callback filter-only(group: string, value: string);
    callback filter-reset(group: string);
    callback filters-reset;
    callback filters-collapse-all;
    callback filter-expanded-changed(group: string, expanded: bool);

    SidebarSection {
        spacing: Theme.space-sm;

        RefreshButton {
            refreshing: root.refreshing;
            task-names: root.refresh-task-names;

            clicked => {
                root.refresh-all();
            }
        }

        SearchInput {
            text <=> root.search-text;
            placeholder-text: @tr("filterMenu" => "Search...");

            edited(text) => {
                root.search-changed(text);
            }
        }

        SortMenu {
            sort-index <=> root.sort-index;

            sort-changed(index) => {
                root.sort-changed(index);
            }
        }
    }

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 0;
            padding-left: Theme.space-sm;
            padding-right: Theme.space-lg;
            spacing: Theme.space-xs;
            cross-axis-alignment: center;

            IconButton {
                icon: Icon.collapse-all;
                tooltip: @tr("filterMenu" => "Collapse all filters");
                enabled: root.filters-have-expanded;

                clicked => {
                    root.filters-collapse-all();
                }
            }

            LabeledDivider {
                label: @tr("filterMenu" => "Filters");
                horizontal-stretch: 1;
            }

            ResetButton {
                tooltip: @tr("filterMenu" => "Reset all filters");
                enabled: root.filters-have-changes;

                clicked => {
                    root.filters-reset();
                }
            }
        }

        for group in root.filter-groups: FilterGroup {
            group: group;

            toggled(value, checked) => {
                root.filter-toggled(group.key, value, checked);
            }

            lock-toggled(value) => {
                root.filter-lock-toggled(group.key, value);
            }

            only(value) => {
                root.filter-only(group.key, value);
            }

            reset => {
                root.filter-reset(group.key);
            }

            expanded-changed(expanded) => {
                root.filter-expanded-changed(group.key, expanded);
            }
        }
    }
}
