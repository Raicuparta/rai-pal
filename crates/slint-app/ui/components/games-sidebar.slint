import { Theme } from "../theme.slint";
import { FilterGroup } from "filter-group.slint";
import { IconButton } from "icon-button.slint";
import { LabeledDivider } from "labeled-divider.slint";
import { RefreshButton } from "refresh-button.slint";
import { ResetButton } from "reset-button.slint";
import { SearchInput } from "search-input.slint";
import { Sidebar, SidebarSection } from "sidebar.slint";
import { SortMenu } from "sort-menu.slint";
import { Icon } from "svg-icon.slint";
import { SidebarAction } from "sidebar-action.slint";
import { RowDivider } from "row-divider.slint";
import { FilterGroupData } from "../app-types.slint";
import { GamesActions } from "../actions.slint";

export global GamesQuery {
    in-out property <string> search-text: "";
    in-out property <int> sort-index: 0;
    in property <[FilterGroupData]> filter-groups;
    in property <bool> filters-have-changes: false;
    in property <bool> filters-have-expanded: false;
}

export component GamesSidebar inherits Sidebar {
    callback add-game-clicked;

    SidebarSection {
        spacing: Theme.space-sm;

        RefreshButton { }
    }

    SidebarAction {
        text: @tr("manualGames" => "Add games");
        clicked => {
            root.add-game-clicked();
        }
        icon: Icon.games;
    }

    RowDivider { }

    SidebarSection {
        spacing: Theme.space-sm;

        SearchInput {
            text <=> GamesQuery.search-text;
            placeholder-text: @tr("filterMenu" => "Search...");

            edited(text) => {
                GamesActions.search-changed(text);
            }
        }

        SortMenu {
            sort-index <=> GamesQuery.sort-index;

            sort-changed(index) => {
                GamesActions.sort-changed(index);
            }
        }
    }

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 0;
            padding-left: Theme.space-sm;
            padding-right: Theme.space-lg;
            padding-bottom: Theme.space-xs;
            spacing: Theme.space-xs;
            cross-axis-alignment: center;

            IconButton {
                icon: Icon.collapse-all;
                tooltip: @tr("filterMenu" => "Collapse all filters");
                enabled: GamesQuery.filters-have-expanded;

                clicked => {
                    GamesActions.filters-collapse-all();
                }
            }

            LabeledDivider {
                label: @tr("filterMenu" => "Filters");
                horizontal-stretch: 1;
            }

            ResetButton {
                tooltip: @tr("filterMenu" => "Reset all filters");
                enabled: GamesQuery.filters-have-changes;

                clicked => {
                    GamesActions.filters-reset();
                }
            }
        }

        for group in GamesQuery.filter-groups: FilterGroup {
            group: group;
        }
    }
}
