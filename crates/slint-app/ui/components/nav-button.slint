import { Theme } from "../theme.slint";

export component NavButton inherits Rectangle {
    in property <string> title: "";
    in property <image> icon;
    in property <length> icon-size: 24px;
    in property <brush> icon-color: Theme.foreground;
    in property <string> icon-text: "";
    in property <length> icon-border-radius: 0px;
    in property <length> icon-border-width: 0px;
    in property <brush> icon-border-color: Theme.foreground;
    in property <bool> selected;

    callback clicked;

    private property <bool> has-title: root.title != "";

    horizontal-stretch: 0;
    vertical-stretch: 0;
    background: touch-area.pressed ? Theme.pressed-background : touch-area.has-hover ? Theme.hover-background : transparent;

    HorizontalLayout {
        padding-left: root.has-title ? Theme.space-16 : Theme.space-10;
        padding-right: root.has-title ? Theme.space-16 : Theme.space-10;
        padding-top: Theme.space-10;
        padding-bottom: Theme.space-10;
        spacing: root.has-title ? Theme.space-10 : 0;
        cross-axis-alignment: center;

        Rectangle {
            width: root.icon-size;
            height: root.icon-size;
            border-radius: root.icon-border-radius;
            border-width: root.icon-border-width;
            border-color: root.icon-border-color;
            clip: root.icon-border-radius > 0;

            Image {
                source: root.icon;
                width: 100%;
                height: 100%;
                colorize: root.icon-color;
            }

            if root.icon-text != "" : Text {
                text: root.icon-text;
                font-size: Theme.font-12;
                font-weight: Theme.weight-bold;
                color: Theme.foreground;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.has-title : Text {
            text: root.title;
            color: Theme.foreground;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    if root.selected : Rectangle {
        y: parent.height - self.height;
        height: 2px;
        background: Theme.primary;
    }

    touch-area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}
