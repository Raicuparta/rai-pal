import { Theme } from "../theme.slint";

export component NavButton inherits Rectangle {
    in property <length> content-padding-left: Theme.space-10;
    in property <length> content-padding-right: Theme.space-10;
    in property <length> content-padding-top: Theme.space-10;
    in property <length> content-padding-bottom: Theme.space-10;
    in property <length> content-spacing: 0px;
    in property <bool> selected;

    callback clicked;

    horizontal-stretch: 0;
    vertical-stretch: 0;
    background: touch-area.pressed ? Theme.pressed-background : touch-area.has-hover ? Theme.hover-background : transparent;

    HorizontalLayout {
        padding-left: root.content-padding-left;
        padding-right: root.content-padding-right;
        padding-top: root.content-padding-top;
        padding-bottom: root.content-padding-bottom;
        spacing: root.content-spacing;
        cross-axis-alignment: center;

        @children
    }

    if root.selected: Rectangle {
        y: parent.height - self.height;
        height: 2px;
        background: Theme.primary;
    }

    touch-area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}
