import { ProgressIndicator } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icon, SvgIcon } from "svg-icon.slint";
import { PopupMenu, PopupMenuItem, PopupMenuSeparator } from "menu.slint";
import { DownloadsState } from "../state.slint";
import { AppActions } from "../actions.slint";

export component DownloadProgress inherits Rectangle {
    width: Theme.control-height + Theme.space-sm;
    height: Theme.control-height;
    visible: DownloadsState.items.length > 0;

    private property <string> menu-tooltip: @tr("downloadStatusMenu" => "Downloads");

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-sm;
        background: touch-area.pressed ? Theme.pressed-background : touch-area.has-hover ? Theme.hover-background : transparent;

        SvgIcon {
            icon: Icon.download;
            size: 18px;
            color: Theme.foreground;
        }

        ProgressIndicator {
            x: Theme.space-sm;
            width: parent.width - Theme.space-md;
            y: parent.height - Theme.space-sm;
            progress: DownloadsState.overall-progress;
        }

        touch-area := TouchArea {
            clicked => {
                menu.show();
            }
        }
    }

    menu := PopupMenu {
        x: root.width - Theme.menu-width;
        y: root.height;

        PopupMenuItem {
            text: @tr("downloadStatusMenu" => "Clear completed");

            clicked => {
                AppActions.clear-downloads();
                menu.close();
            }
        }

        if DownloadsState.items.length > 0 : PopupMenuSeparator { }

        for item in DownloadsState.items : PopupMenuItem {
            enabled: false;
            text: "\{item.name}: \{round(item.progress)}%";
        }
    }

    Tooltip {
        text: @markdown("\{root.menu-tooltip}");
    }
}
