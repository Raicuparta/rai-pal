import { Theme } from "../theme.slint";
import { Tr } from "../translations.slint";
import { SidebarAction } from "sidebar-action.slint";
import { Icon } from "svg-icon.slint";
import { Button } from "button.slint";

export component RefreshButton inherits Button {
    in property <bool> refreshing;
    in property <string> task-names;

    text: root.refreshing ? Tr.refresh-loading(root.task-names) : @tr("refresh" => "Refresh");
    icon: root.refreshing ? Icon.refreshing : Icon.refresh;
    tint: Theme.primary;
    enabled: !root.refreshing;
}
