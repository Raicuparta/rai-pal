import { Theme } from "../theme.slint";
import { NavButton } from "nav-button.slint";
import { Icon, SvgIcon } from "svg-icon.slint";
import { PopupMenu, PopupMenuItem } from "menu.slint";

export component UserMenu inherits Rectangle {
    in property <bool> logged-in;
    in property <bool> busy;
    in property <string> user-name;
    in property <string> user-initials;
    in property <bool> has-avatar;
    in property <image> avatar;

    callback log-in;
    callback log-out;

    private property <string> menu-tooltip: @tr("userMenu" => "User menu");
    private property <length> avatar-size: 24px;

    NavButton {
        clicked => {
            menu.show();
        }

        if root.logged-in: Rectangle {
            width: root.avatar-size;
            height: root.avatar-size;
            border-radius: root.avatar-size / 2;
            background: Theme.foreground;
            clip: true;

            Rectangle {
                x: Theme.border-width * 2;
                y: Theme.border-width * 2;
                width: root.avatar-size - Theme.border-width * 4;
                height: root.avatar-size - Theme.border-width * 4;
                border-radius: (root.avatar-size - Theme.border-width * 4) / 2;
                background: Theme.background;
                clip: true;

                if root.has-avatar: Image {
                    source: root.avatar;
                    width: 100%;
                    height: 100%;
                }

                if !root.has-avatar: Text {
                    text: root.user-initials;
                    font-size: Theme.font-12;
                    font-weight: Theme.weight-bold;
                    color: Theme.foreground;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if !root.logged-in: SvgIcon {
            icon: Icon.account;
            size: root.avatar-size;
            color: Theme.foreground;
        }
    }

    menu := PopupMenu {
        x: root.width - Theme.menu-width;
        y: root.height;

        if root.logged-in: PopupMenuItem {
            text: root.user-name == "" ? @tr("userMenu" => "Unknown user") : root.user-name;
            enabled: false;
        }

        if root.logged-in: PopupMenuItem {
            text: @tr("userMenu" => "Log out");
            enabled: !root.busy;

            clicked => {
                root.log-out();
                menu.close();
            }
        }

        if !root.logged-in: PopupMenuItem {
            text: @tr("userMenu" => "Sign in with Discord");
            enabled: !root.busy;

            clicked => {
                root.log-in();
                menu.close();
            }
        }

        if !root.logged-in: PopupMenuItem {
            text: @tr("userMenu" => "Mods can use this to access your Discord username, avatar, roles, etc.");
            enabled: false;
        }
    }

    Tooltip {
        text: @markdown("\{root.menu-tooltip}");
    }
}
