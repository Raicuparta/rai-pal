import { Theme } from "../theme.slint";
import { NavButton } from "nav-button.slint";
import { PopupMenu, PopupMenuItem } from "menu.slint";

export component UserMenu inherits Rectangle {
    in property <bool> logged-in;
    in property <bool> busy;
    in property <string> user-name;
    in property <string> user-initials;
    in property <bool> has-avatar;
    in property <image> avatar;

    callback log-in;
    callback log-out;

    private property <string> menu-tooltip: @tr("userMenu" => "User menu");
    private property <length> avatar-size: 24px;

    NavButton {
        icon: root.logged-in ? root.avatar : @image-url("../icons/ui/account.svg");
        icon-size: root.avatar-size;
        icon-color: root.logged-in ? transparent : Theme.foreground;
        icon-text: root.logged-in && !root.has-avatar ? root.user-initials : "";
        icon-border-radius: root.logged-in ? root.avatar-size / 2 : 0px;
        icon-border-width: root.logged-in ? Theme.border-width * 2 : 0px;
        icon-border-color: Theme.foreground;

        clicked => {
            menu.show();
        }
    }

    menu := PopupMenu {
        x: root.width - Theme.menu-width;
        y: root.height;

        if root.logged-in : PopupMenuItem {
            text: root.user-name == "" ? @tr("userMenu" => "Unknown user") : root.user-name;
            enabled: false;
        }

        if root.logged-in : PopupMenuItem {
            text: @tr("userMenu" => "Log out");
            enabled: !root.busy;

            clicked => {
                root.log-out();
                menu.close();
            }
        }

        if !root.logged-in : PopupMenuItem {
            text: @tr("userMenu" => "Sign in with Discord");
            enabled: !root.busy;

            clicked => {
                root.log-in();
                menu.close();
            }
        }

        if !root.logged-in : PopupMenuItem {
            text: @tr("userMenu" => "Mods can use this to access your Discord username, avatar, roles, etc.");
            enabled: false;
        }
    }

    Tooltip {
        text: @markdown("\{root.menu-tooltip}");
    }
}
