import { Button } from "button.slint";
import { Theme } from "../theme.slint";
import { Modal } from "modal.slint";
import { ModSourcesState } from "../state.slint";
import { DialogActions } from "../actions.slint";

export component ConfirmModSourcePopup inherits Modal {
    open: ModSourcesState.confirm-open;
    title: @tr("urlModSources" => "Confirm Mod Source");

    closed => {
        ModSourcesState.confirm-open = false;
        DialogActions.cancel-url-mod-source();
    }

    Text {
        text: ModSourcesState.confirm-url;
        font-size: Theme.font-sm;
        opacity: 0.7;
        wrap: word-wrap;
    }

    if ModSourcesState.confirm-loading : Text {
        text: @tr("urlModSources" => "Loading mods...");
    }

    if ModSourcesState.confirm-error != "" : Text {
        text: ModSourcesState.confirm-error;
        color: red;
        font-size: Theme.font-sm;
        wrap: word-wrap;
    }

    if !ModSourcesState.confirm-loading && ModSourcesState.confirm-error == "" : VerticalLayout {
        spacing: Theme.space-2xs;
        alignment: start;

        Text {
            text: @tr("urlModSources" => "{0} mods found in this source", ModSourcesState.confirm-mods.length);
        }

        for mod-title in ModSourcesState.confirm-mods : Text {
            text: mod-title;
            font-size: Theme.font-sm;
            wrap: word-wrap;
        }
    }

    HorizontalLayout {
        alignment: end;
        spacing: Theme.space-sm;

        Button {
            text: @tr("urlModSources" => "Cancel");
            enabled: !ModSourcesState.confirm-saving;

            clicked => {
                root.closed();
            }
        }

        Button {
            text: @tr("urlModSources" => "Add Source");
            enabled: !ModSourcesState.confirm-loading && ModSourcesState.confirm-error == "" && !ModSourcesState.confirm-saving;

            clicked => {
                DialogActions.confirm-url-mod-source();
            }
        }
    }
}
