import { TextEdit } from "std-widgets.slint";
import { Fonts, Theme } from "../theme.slint";
import { Modal } from "modal.slint";
import { Icon } from "svg-icon.slint";

export component GameDetailsPopup inherits Modal {
    in property <string> game-json;

    private property <bool> copied: false;
    private property <length> saved-scroll-y: 0;

    title: @tr("debugData" => "Debug data");
    big: true;
    header-action-icon: root.copied ? Icon.copied : Icon.copy;
    header-action-tooltip: @tr("debugData" => "Copy debug data");

    copy-reset-timer := Timer {
        interval: 2s;
        running: root.copied;

        triggered => {
            root.copied = false;
        }
    }

    header-action-clicked => {
        root.saved-scroll-y = debug-text.content-y;
        debug-text.select-all();
        debug-text.copy();
        debug-text.clear-selection();
        debug-text.content-y = root.saved-scroll-y;
        root.copied = true;
    }

    debug-text := TextEdit {
        text: root.game-json;
        read-only: true;
        wrap: word-wrap;
        font-family: Fonts.monospace-family;
        font-size: Theme.font-sm;
        width: 100%;
        height: 100%;
    }
}
