import { ScrollView } from "std-widgets.slint";
import { ModActions } from "../actions.slint";
import { Theme } from "../theme.slint";
import { ActionButton } from "action-button.slint";
import { GameRow } from "game-row.slint";
import { ModsSection } from "mods-section.slint";
import { PotentialModsSection } from "potential-mods-section.slint";
import { Icon } from "svg-icon.slint";
import { AppState, SelectedGameState } from "../state.slint";
import { GamesActions } from "../actions.slint";

export component GameDetailsPage inherits Rectangle {
    ScrollView {
        VerticalLayout {
            alignment: start;
            spacing: Theme.space-sm;

            GameRow {
                vertical-stretch: 0;
                game-row: SelectedGameState.row;
                row-index: 0;
                show-thumbnail: !AppState.hide-game-thumbnails;

                selected(index) => {
                    GamesActions.back();
                }
            }

            if SelectedGameState.mods-installed.length + SelectedGameState.mods-available.length + SelectedGameState.mods-hidden.length + SelectedGameState.mods-incompatible.length + SelectedGameState.potential-mods.length == 0 : HorizontalLayout {
                height: self.preferred-height;
                padding-left: Theme.space-sm;
                padding-right: Theme.space-sm;

                Text {
                    text: @tr("gameModal" => "Nothing! None of the available mods are of any use for this game. Try something else.");
                    opacity: 0.75;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }

            if !SelectedGameState.row.installed && SelectedGameState.potential-mods.length > 0 : PotentialModsSection {
                label: @tr("gameModal" => "Potentially compatible mods");
                description: @tr("gameModal" => "Install this game to see more detailed information about which mods are compatible");
                mods: SelectedGameState.potential-mods;
            }

            if SelectedGameState.row.installed : VerticalLayout {
                alignment: start;
                vertical-stretch: 0;
                spacing: Theme.space-sm;

                if SelectedGameState.mods-installed.length > 0 : VerticalLayout {
                    alignment: start;
                    vertical-stretch: 0;
                    spacing: Theme.space-xs;

                    ModsSection {
                        label: @tr("gameModal" => "Installed Mods");
                        mods: SelectedGameState.mods-installed;
                    }

                    HorizontalLayout {
                        padding-left: Theme.space-sm;
                        padding-right: Theme.space-sm;
                        alignment: start;

                        ActionButton {
                            vertical-stretch: 0;
                            text: @tr("gameModal" => "Uninstall all mods");
                            icon: Icon.uninstall;
                            action-id: "game-mod-uninstall-all";
                            tint: Theme.danger;

                            clicked => {
                                ModActions.request-uninstall-all(
                                    @tr("gameModal" => "You sure? This will delete all files in this game's mods folder. It won't delete any files from the actual game though."),
                                    @tr("gameModal" => "Uninstall all mods"),
                                );
                            }
                        }
                    }
                }

                if SelectedGameState.mods-available.length > 0 : ModsSection {
                    label: @tr("gameModal" => "Available Mods");
                    mods: SelectedGameState.mods-available;
                }

                if SelectedGameState.mods-hidden.length > 0 : ModsSection {
                    label: @tr("gameModal" => "Other things");
                    description: @tr("gameModal" => "These are mostly dependencies and other stuff that you don't usually need to mess with directly.");
                    mods: SelectedGameState.mods-hidden;
                }

                if SelectedGameState.mods-incompatible.length > 0 : ModsSection {
                    label: @tr("gameModal" => "Incompatible Mods");
                    description: @tr("gameModal" => "The mods listed here can't be installed because they aren't compatible with this game's engine version.");
                    mods: SelectedGameState.mods-incompatible;
                }
            }
        }
    }
}
