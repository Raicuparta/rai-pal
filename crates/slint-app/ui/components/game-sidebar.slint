import { Theme } from "../theme.slint";
import { Tr } from "../translations.slint";
import { LabeledDivider } from "labeled-divider.slint";
import { SidebarAction } from "sidebar-action.slint";
import { Sidebar, SidebarSection } from "sidebar.slint";
import { Icon } from "svg-icon.slint";
import { Button } from "button.slint";
import { SelectedGameState } from "../state.slint";
import { GamesActions } from "../actions.slint";

export component GameSidebar inherits Sidebar {
    pure function provider-command-icon(command: string) -> Icon {
        if command == "StartViaProvider" {
            return Icon.play;
        }
        if command == "StartViaExe" {
            return Icon.play-exe;
        }
        return Icon.none;
    }

    VerticalLayout {
        alignment: start;
        spacing: Theme.space-sm;

        SidebarSection {
            Button {
                text: @tr("subPage" => "Back");
                icon: Icon.back;

                clicked => {
                    GamesActions.back();
                }
            }
        }

        if SelectedGameState.provider-actions.length > 0: VerticalLayout {
            alignment: start;
            spacing: 0px;

            SidebarSection {
                padding-top: Theme.space-xs;
                padding-bottom: Theme.space-xs;

                LabeledDivider {
                    label: SelectedGameState.provider-id;
                    horizontal-stretch: 1;
                }
            }

            for action[index] in SelectedGameState.provider-actions: SidebarAction {
                text: Tr.provider-command(action);
                icon: root.provider-command-icon(action);
                highlighted: index == 0;
                action-id: "provider-action:" + action;

                clicked => {
                    if action == "Delete" {
                        GamesActions.remove-game(
                            @tr("gameModal" => "Are you sure you want to remove this game from Rai Pal?"),
                            @tr("gameModal" => "Remove from Rai Pal"),
                        );
                    } else {
                        GamesActions.run-provider-action(action);
                    }
                }
            }
        }

        if SelectedGameState.has-exe-path: VerticalLayout {
            alignment: start;
            spacing: 0px;

            SidebarSection {
                padding-top: Theme.space-xs;
                padding-bottom: Theme.space-xs;

                LabeledDivider {
                    label: @tr("gameModal" => "Folders");
                    horizontal-stretch: 1;
                }
            }

            SidebarAction {
                text: @tr("gameModal" => "Game Files");
                icon: Icon.folder;
                action-id: "open-game-folder";

                clicked => {
                    GamesActions.open-game-folder();
                }
            }

            SidebarAction {
                text: @tr("gameModal" => "Installed Mods");
                icon: Icon.folder-mods;
                action-id: "open-game-mods-folder";

                clicked => {
                    GamesActions.open-game-mods-folder();
                }
            }

            SidebarAction {
                text: @tr("gameModal" => "Game App Data");
                action-id: "open-game-data-folder";

                clicked => {
                    GamesActions.open-game-data-folder();
                }
            }

            if SelectedGameState.show-wine-folders: SidebarAction {
                text: @tr("gameModal" => "Wine Prefix");
                action-id: "open-wine-prefix-folder";

                clicked => {
                    GamesActions.open-wine-prefix-folder();
                }
            }

            if SelectedGameState.show-wine-folders: SidebarAction {
                text: @tr("gameModal" => "Wine Binary");
                action-id: "open-wine-binary-folder";

                clicked => {
                    GamesActions.open-wine-binary-folder();
                }
            }
        }

        VerticalLayout {
            alignment: start;
            spacing: 0px;

            SidebarSection {
                padding-top: Theme.space-xs;
                padding-bottom: Theme.space-xs;

                LabeledDivider {
                    label: "Data";
                    horizontal-stretch: 1;
                }
            }

            if SelectedGameState.has-exe-path: SidebarAction {
                text: @tr("gameModal" => "Refresh game");
                icon: Icon.refresh;
                action-id: "refresh-game";

                clicked => {
                    GamesActions.refresh-game();
                }
            }

            SidebarAction {
                text: @tr("debugData" => "Debug data");
                icon: Icon.bug;

                clicked => {
                    GamesActions.request-debug-data();
                }
            }
        }
    }
}
