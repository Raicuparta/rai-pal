import { CheckBox } from "std-widgets.slint";
import { Button } from "button.slint";
import { Theme } from "../theme.slint";
import { Modal } from "modal.slint";
import { ConfirmationState } from "../state.slint";
import { DialogActions } from "../actions.slint";

export component ConfirmationPopup inherits Modal {
    open: ConfirmationState.open;
    title: ConfirmationState.confirm-label;

    closed => {
        root.respond(false);
    }

    function respond(confirmed: bool) {
        ConfirmationState.open = false;
        DialogActions.confirmation-response(confirmed);
    }

    Text {
        text: ConfirmationState.text;
        wrap: word-wrap;
    }

    if ConfirmationState.can-skip : CheckBox {
        text: @tr("commandButton" => "Don't ask again");
        checked <=> ConfirmationState.dont-ask-again;
    }

    HorizontalLayout {
        alignment: center;
        spacing: Theme.space-sm;

        Button {
            text: @tr("commandButton" => "Cancel");

            clicked => {
                root.respond(false);
            }
        }

        Button {
            text: ConfirmationState.confirm-label;
            tint: Theme.primary;

            clicked => {
                root.respond(true);
            }
        }
    }
}
