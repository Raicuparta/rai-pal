import { Theme } from "../theme.slint";
import { SelectMenu, SelectOption } from "select-menu.slint";
import { Icon } from "svg-icon.slint";
import { GamesState } from "../state.slint";
import { GamesActions } from "../actions.slint";

export component SortMenu inherits Rectangle {
    horizontal-stretch: 1;
    height: Theme.control-height;

    private property <[SelectOption]> options: [
        { label: @tr("gamesSort" => "Name A-Z"), value: "0" },
        { label: @tr("gamesSort" => "Name Z-A"), value: "1" },
        { label: @tr("gamesSort" => "Engine A-Z"), value: "2" },
        { label: @tr("gamesSort" => "Engine Z-A"), value: "3" },
        { label: @tr("gamesSort" => "Date Ascending"), value: "4" },
        { label: @tr("gamesSort" => "Date Descending"), value: "5" },
    ];

    SelectMenu {
        options: root.options;
        selected-index <=> GamesState.sort-index;
        icon: Icon.sort;

        selected(index) => {
            GamesState.sort-index = index;
            GamesActions.sort-changed(index);
        }
    }
}
