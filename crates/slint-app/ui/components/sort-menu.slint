import { Theme } from "../theme.slint";
import { SvgIcon } from "svg-icon.slint";
import { PopupMenu, PopupMenuItem } from "menu.slint";

export component SortMenu inherits Rectangle {
    in-out property <int> sort-index: 0;

    callback sort-changed(index: int);

    horizontal-stretch: 1;
    height: Theme.control-height;

    private property <string> current-label: root.sort-index == 0 ? @tr("gamesSort" => "Name A-Z") : root.sort-index == 1 ? @tr("gamesSort" => "Name Z-A") : root.sort-index == 2 ? @tr("gamesSort" => "Engine A-Z") : root.sort-index == 3 ? @tr("gamesSort" => "Engine Z-A") : root.sort-index == 4 ? @tr("gamesSort" => "Date Ascending") : @tr("gamesSort" => "Date Descending");

    Rectangle {
        width: 100%;
        height: 100%;
        border-width: Theme.border-width;
        border-color: Theme.border;
        border-radius: Theme.radius-4;
        background: touch-area.pressed ? Theme.pressed-background : touch-area.has-hover ? Theme.hover-background : Theme.background;

        HorizontalLayout {
            padding-left: Theme.space-8;
            padding-right: Theme.space-8;
            spacing: Theme.space-4;
            cross-axis-alignment: center;

            Text {
                text: root.current-label;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
            }

            SvgIcon {
                source: @image-url("../icons/ui/sort-menu.svg");
                color: Theme.dimmed-foreground;
            }
        }

        touch-area := TouchArea {
            clicked => {
                menu.show();
            }
        }
    }

    menu := PopupMenu {
        x: 0;
        y: root.height;

        PopupMenuItem {
            checkable: true;
            checked: root.sort-index == 0;
            text: @tr("gamesSort" => "Name A-Z");

            clicked => {
                root.sort-index = 0;
                root.sort-changed(0);
            }
        }

        PopupMenuItem {
            checkable: true;
            checked: root.sort-index == 1;
            text: @tr("gamesSort" => "Name Z-A");

            clicked => {
                root.sort-index = 1;
                root.sort-changed(1);
            }
        }

        PopupMenuItem {
            checkable: true;
            checked: root.sort-index == 2;
            text: @tr("gamesSort" => "Engine A-Z");

            clicked => {
                root.sort-index = 2;
                root.sort-changed(2);
            }
        }

        PopupMenuItem {
            checkable: true;
            checked: root.sort-index == 3;
            text: @tr("gamesSort" => "Engine Z-A");

            clicked => {
                root.sort-index = 3;
                root.sort-changed(3);
            }
        }

        PopupMenuItem {
            checkable: true;
            checked: root.sort-index == 4;
            text: @tr("gamesSort" => "Date Ascending");

            clicked => {
                root.sort-index = 4;
                root.sort-changed(4);
            }
        }

        PopupMenuItem {
            checkable: true;
            checked: root.sort-index == 5;
            text: @tr("gamesSort" => "Date Descending");

            clicked => {
                root.sort-index = 5;
                root.sort-changed(5);
            }
        }
    }
}
