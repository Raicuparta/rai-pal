import { NotificationView, NotificationKind } from "../notification-view.slint";
import { Theme } from "../theme.slint";
import { IconButton } from "icon-button.slint";
import { SvgIcon } from "svg-icon.slint";

component NotificationToast inherits Rectangle {
    in property <NotificationView> notification;

    callback dismissed(id: int);

    width: 100%;
    background: Theme.background;
    border-width: Theme.border-width * 2;
    border-radius: Theme.radius-8;
    border-color: root.notification.kind == NotificationKind.error ? Theme.status-error : root.notification.kind == NotificationKind.success ? Theme.status-success : Theme.status-info;

    timer := Timer {
        interval: 5s;
        running: true;

        triggered => {
            root.dismissed(root.notification.id);
        }
    }

    HorizontalLayout {
        padding: Theme.space-10;
        spacing: Theme.space-8;
        cross-axis-alignment: center;

        SvgIcon {
            source: root.notification.kind == NotificationKind.error ? @image-url("../icons/ui/error.svg") : root.notification.kind == NotificationKind.success ? @image-url("../icons/ui/success.svg") : @image-url("../icons/ui/info.svg");
            size: 15px;
            color: root.notification.kind == NotificationKind.error ? Theme.status-error : root.notification.kind == NotificationKind.success ? Theme.status-success : Theme.status-info;
        }

        Text {
            horizontal-stretch: 1;
            text: root.notification.message;
            wrap: word-wrap;
        }

        IconButton {
            icon: @image-url("../icons/ui/close.svg");
            tooltip: @tr("debugData" => "Close");

            clicked => {
                root.dismissed(root.notification.id);
            }
        }
    }
}

export component NotificationsOverlay inherits Rectangle {
    in property <[NotificationView]> notifications;
    in property <length> top-offset: 0px;

    callback dismissed(id: int);

    VerticalLayout {
        x: root.width - self.width - Theme.space-16;
        y: root.top-offset + Theme.space-16;
        width: min(360px, root.width - Theme.space-16 * 2);
        spacing: Theme.space-6;
        alignment: start;

        for notification in root.notifications : NotificationToast {
            notification: notification;

            dismissed(id) => {
                root.dismissed(id);
            }
        }
    }
}
