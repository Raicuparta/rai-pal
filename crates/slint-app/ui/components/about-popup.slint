import { Modal } from "modal.slint";
import { AppState } from "../state.slint";

export component AboutPopup inherits Modal {
    title: "About Rai Pal";

    Text {
        text: "Version: \{AppState.app-version}";
    }

    Text {
        text: "Rendering backend: \{AppState.renderer-name}";
    }

    Text {
        text: "Platform: \{AppState.platform-name}";
    }
}
