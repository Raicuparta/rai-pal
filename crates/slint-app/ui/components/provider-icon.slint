import { Branding } from "../branding.slint";
import { Theme } from "../theme.slint";
import { Icon, SvgIcon } from "svg-icon.slint";

export component ProviderIcon inherits Rectangle {
    in property <string> provider-id;
    in property <length> icon-size: Theme.space-lg;

    width: root.icon-size;
    height: root.icon-size;

    pure function icon-source(id: string) -> Icon {
        if id == "Amazon" {
            return Icon.amazon;
        }
        if id == "Steam" {
            return Icon.steam;
        }
        if id == "Epic" {
            return Icon.epic;
        }
        if id == "Gog" {
            return Icon.gog;
        }
        if id == "Itch" {
            return Icon.itch;
        }
        if id == "Xbox" {
            return Icon.xbox;
        }
        if id == "Manual" {
            return Icon.manual;
        }
        return Icon.none;
    }

    SvgIcon {
        icon: root.icon-source(root.provider-id);
        size: root.icon-size;
        color: Branding.provider-foreground(root.provider-id);
    }
}
