import { ModActions } from "../actions.slint";
import { Theme } from "../theme.slint";
import { Icon, SvgIcon } from "svg-icon.slint";

export component ExternalLink inherits Rectangle {
    in property <string> label;
    in property <Icon> icon: Icon.none;
    in property <brush> icon-color: Theme.foreground;
    in property <length> text-size: Theme.font-16;
    in property <string> url;

    horizontal-stretch: 0;
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-action-default => {
        ModActions.open-url(root.url);
    }

    HorizontalLayout {
        alignment: start;
        cross-axis-alignment: center;

        if root.icon != Icon.none: HorizontalLayout {
            padding-right: Theme.space-8;

            SvgIcon {
                icon: root.icon;
                color: root.icon-color;
                size: 20px;
            }
        }

        Rectangle {
            width: label-text.preferred-width;
            height: label-text.preferred-height;

            label-text := Text {
                text: root.label;
                color: Theme.strong-foreground;
                font-size: root.text-size;
                font-weight: Theme.weight-bold;
                vertical-alignment: center;
            }

            Rectangle {
                y: parent.height - Theme.border-width;
                width: parent.width;
                height: Theme.border-width;
                background: touch.has-hover ? Theme.foreground : transparent;
            }
        }

        SvgIcon {
            icon: Icon.external-link;
            size: 12px;
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;

        clicked => {
            ModActions.open-url(root.url);
        }
    }
}
