import { PotentialModView } from "../app-types.slint";
import { Theme } from "../theme.slint";
import { SectionHeader } from "section-header.slint";

component PotentialModRowView inherits Rectangle {
    in property <PotentialModView> potential-mod;

    vertical-stretch: 0;

    VerticalLayout {
        padding: Theme.space-sm;
        alignment: start;
        spacing: Theme.space-2xs;

        Text {
            text: potential-mod.title;
            font-weight: Theme.weight-semibold;
            overflow: elide;
        }

        if potential-mod.description != "" : Text {
            height: self.preferred-height;
            text: potential-mod.description;
            font-size: Theme.font-sm;
            opacity: 0.75;
            wrap: word-wrap;
            color: Theme.foreground;
        }
    }
}

export component PotentialModsSection inherits VerticalLayout {
    in property <string> label;
    in property <string> description;
    in property <[PotentialModView]> mods;

    vertical-stretch: 0;
    alignment: start;
    spacing: Theme.space-2xs;

    SectionHeader {
        label: root.label;
        description: root.description;
    }

    for row in root.mods : PotentialModRowView {
        potential-mod: row;
    }
}
