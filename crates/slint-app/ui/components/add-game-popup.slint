import { Button } from "button.slint";
import { AddGamePhase } from "../app-types.slint";
import { Fonts, Theme } from "../theme.slint";
import { Modal } from "modal.slint";
import { AddGameState } from "../state.slint";
import { DialogActions } from "../actions.slint";

component SavedDirectoryRow inherits Rectangle {
    in property <string> path;

    callback removed;

    HorizontalLayout {
        spacing: Theme.space-sm;
        cross-axis-alignment: center;

        Rectangle {
            horizontal-stretch: 1;
            border-radius: Theme.radius-sm;
            background: Theme.surface-background;

            Text {
                text: root.path;
                font-family: Fonts.monospace-family;
                font-size: Theme.font-sm;
                vertical-alignment: center;
                x: Theme.space-sm;
                width: parent.width - Theme.space-lg;
                overflow: elide;
            }
        }

        Button {
            text: @tr("manualGames" => "Remove");

            clicked => {
                root.removed();
            }
        }
    }
}

export component AddGamePopup inherits Modal {
    open: AddGameState.open;
    title: @tr("manualGames" => "Manually Added Games");

    closed => {
        AddGameState.open = false;
        DialogActions.add-game-closed();
    }

    Text {
        text: @tr("manualGames" => "Note: you can also add your non-Steam games to Steam, and they will still be detected by Rai Pal.");
        font-size: Theme.font-sm;
        opacity: 0.7;
        wrap: word-wrap;
    }

    if AddGameState.phase == AddGamePhase.idle : VerticalLayout {
        spacing: Theme.space-md;

        Button {
            text: @tr("manualGames" => "Select game executable");
            tint: Theme.primary;
            height: Theme.control-height;

            clicked => {
                DialogActions.select-game-executable();
            }
        }

        Button {
            text: @tr("manualGames" => "Select game directory. Can be slow!");
            height: Theme.control-height;

            clicked => {
                DialogActions.select-game-directory();
            }
        }

        Text {
            text: @tr("manualGames" => "You can also just drop game executable files or entire folders anywhere on Rai Pal's window to add them to the library, even without opening this dialog.");
            font-size: Theme.font-sm;
            opacity: 0.7;
            wrap: word-wrap;
        }
    }

    if AddGameState.phase == AddGamePhase.scanning : VerticalLayout {
        spacing: Theme.space-md;
        alignment: start;

        Text {
            text: @tr("manualGames" => "Scanning {0}...", AddGameState.selected-path);
            font-weight: Theme.weight-bold;
            wrap: word-wrap;
        }

        Text {
            text: @tr("manualGames" => "Scanned {0} directories, found {1} executables", AddGameState.scanned-dirs, AddGameState.executables-found);
        }

        Text {
            text: AddGameState.current-path;
            font-family: Fonts.monospace-family;
            font-size: Theme.font-sm;
            opacity: 0.7;
            overflow: elide;
        }

        Button {
            text: @tr("manualGames" => "Cancel");
            height: Theme.control-height;

            clicked => {
                DialogActions.cancel-game-scan();
            }
        }
    }

    if AddGameState.phase == AddGamePhase.confirming : VerticalLayout {
        spacing: Theme.space-md;
        alignment: start;

        Text {
            text: @tr("manualGames" => "Found {0} executables in {1} seconds. Add this folder to Rai Pal?", AddGameState.games-count, AddGameState.duration-text);
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: Theme.space-sm;

            Button {
                text: @tr("manualGames" => "Add folder");
                tint: Theme.primary;

                clicked => {
                    DialogActions.confirm-game-directory();
                }
            }

            Button {
                text: @tr("manualGames" => "Cancel");

                clicked => {
                    DialogActions.cancel-game-scan();
                }
            }
        }
    }

    if AddGameState.phase == AddGamePhase.idle && AddGameState.manual-directories.length > 0 : VerticalLayout {
        spacing: Theme.space-sm;

        Rectangle {
            height: Theme.border-width;
            background: Theme.border;
        }

        Text {
            text: @tr("manualGames" => "These directories will be scanned recursively every time Rai Pal refreshes its data. Large folders may make things significantly slower.");
            font-size: Theme.font-sm;
            opacity: 0.7;
            wrap: word-wrap;
        }

        for directory in AddGameState.manual-directories : SavedDirectoryRow {
            path: directory;

            removed => {
                DialogActions.remove-game-directory(directory);
            }
        }
    }
}
