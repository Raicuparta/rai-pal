import { ActionState, ActionStates } from "../action-state.slint";
import { Theme } from "../theme.slint";
import { ListRow } from "list-row.slint";
import { SvgIcon } from "svg-icon.slint";

export component SidebarAction inherits ListRow {
    in property <string> text;
    in property <image> icon;
    in property <string> action-id: "";
    in property <bool> highlighted: false;
    in property <ActionState> state: ActionState.idle;

    private property <ActionState> action-state: ActionState.idle;
    private property <int> state-version: ActionStates.version;
    private property <ActionState> current-state: root.state != ActionState.idle ? root.state : root.action-state;
    private property <bool> long-loading: false;
    private property <bool> has-status: root.current-state == ActionState.success || root.current-state == ActionState.error;
    private property <bool> shows-spinner: root.current-state == ActionState.loading && root.long-loading;
    private property <bool> has-icon: root.icon.width > 0;
    private property <bool> shows-icon: root.has-icon || root.has-status || root.shows-spinner;
    private property <angle> spinner-angle: mod(animation-tick(), 1s) / 1s * 360deg;
    private property <image> display-icon: root.current-state == ActionState.success ? @image-url("../icons/ui/success.svg") : root.current-state == ActionState.error ? @image-url("../icons/ui/error.svg") : root.shows-spinner ? @image-url("../icons/ui/loading.svg") : root.icon;
    private property <brush> content-color: !root.enabled ? Theme.dimmed-foreground : root.current-state == ActionState.success ? Theme.status-success : root.current-state == ActionState.error ? Theme.status-error : root.highlighted ? Theme.primary : Theme.strong-foreground;

    content-padding-left: Theme.space-12;
    content-padding-right: Theme.space-12;
    content-padding-top: Theme.space-8;
    content-padding-bottom: Theme.space-8;
    spacing: Theme.space-8;
    interactive: root.enabled && root.current-state != ActionState.loading;
    accessible-label: root.text;

    changed action-id => {
        root.update-state();
    }

    changed state-version => {
        root.update-state();
    }

    init => {
        root.update-state();
    }

    function update-state() {
        root.action-state = root.action-id == "" ? ActionState.idle : ActionStates.lookup(root.action-id);
    }

    loading-timer := Timer {
        interval: 500ms;
        running: root.current-state == ActionState.loading && !root.long-loading;

        triggered => {
            root.long-loading = true;
        }
    }

    Rectangle {
        width: Theme.icon-size;
        height: Theme.icon-size;

        if root.shows-icon: SvgIcon {
            width: 100%;
            height: 100%;
            source: root.display-icon;
            color: root.content-color;
            transform-rotation: root.shows-spinner ? root.spinner-angle : 0deg;
        }
    }

    Text {
        text: root.text;
        font-size: Theme.font-12;
        color: root.content-color;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
        font-weight: Theme.weight-semibold;
    }
}
