import { ActionState, ActionStates } from "../action-state.slint";
import { Theme } from "../theme.slint";
import { ListRow } from "list-row.slint";
import { Icon, SvgIcon } from "svg-icon.slint";

export component SidebarAction inherits ListRow {
    in property <string> text;
    in property <Icon> icon: Icon.none;
    in property <string> action-id: "";
    in property <bool> highlighted: false;

    private property <ActionState> action-state: ActionState.idle;
    private property <int> state-version: ActionStates.version;
    private property <ActionState> current-state: root.action-state;
    private property <bool> long-loading: false;
    private property <bool> has-status: root.current-state == ActionState.success || root.current-state == ActionState.error;
    private property <bool> shows-spinner: root.current-state == ActionState.loading && root.long-loading;
    private property <bool> has-icon: root.icon != Icon.none;
    private property <bool> shows-icon: root.has-icon || root.has-status || root.shows-spinner;
    private property <angle> spinner-angle: mod(animation-tick(), 1s) / 1s * 360deg;
    private property <Icon> display-icon: root.current-state == ActionState.success ? Icon.success : root.current-state == ActionState.error ? Icon.error : root.shows-spinner ? Icon.loading : root.icon;
    private property <bool> needs-dark-ink: Theme.primary.to-oklch().lightness > 0.62;
    private property <brush> highlighted-ink: root.needs-dark-ink ? Theme.strong-foreground-light : Theme.strong-foreground-dark;
    private property <brush> highlighted-background: root.enabled ? Theme.primary : transparent;
    private property <brush> highlighted-hover-background: root.needs-dark-ink ? Theme.primary.darker(0.15) : Theme.primary.brighter(0.4);
    private property <brush> highlighted-pressed-background: root.needs-dark-ink ? Theme.primary.darker(0.3) : Theme.primary.brighter(0.7);
    private property <brush> content-color: !root.enabled ? Theme.dimmed-foreground : root.current-state == ActionState.success ? Theme.status-success : root.current-state == ActionState.error ? Theme.status-error : root.highlighted ? root.highlighted-ink : Theme.strong-foreground;

    background-color: root.highlighted ? root.highlighted-background : transparent;
    hover-background: root.highlighted ? root.highlighted-hover-background : Theme.hover-background;
    pressed-background: root.highlighted ? root.highlighted-pressed-background : Theme.pressed-background;
    spacing: Theme.space-sm;
    interactive: root.enabled && root.current-state != ActionState.loading;
    accessible-label: root.text;

    changed action-id => {
        root.update-state();
    }

    changed state-version => {
        root.update-state();
    }

    init => {
        root.update-state();
    }

    function update-state() {
        root.action-state = root.action-id == "" ? ActionState.idle : ActionStates.lookup(root.action-id);
    }

    Timer {
        interval: 500ms;
        running: root.current-state == ActionState.loading && !root.long-loading;

        triggered => {
            root.long-loading = true;
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-md;
        spacing: Theme.space-sm;

        SvgIcon {
            icon: root.display-icon;
            color: root.content-color;
            transform-rotation: root.shows-spinner ? root.spinner-angle : 0deg;
        }

        Text {
            text: root.text;
            font-size: Theme.font-sm;
            color: root.content-color;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            font-weight: Theme.weight-semibold;
        }
    }
}
