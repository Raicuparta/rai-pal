import { AppColorScheme } from "../app-types.slint";
import { Theme } from "../theme.slint";
import { NavButton } from "nav-button.slint";
import { SvgIcon } from "svg-icon.slint";
import { PopupMenu, PopupMenuItem, PopupMenuSeparator } from "menu.slint";
import { SelectMenu, SelectOption } from "select-menu.slint";

export component AppMenu inherits Rectangle {
    in property <string> selected-language: "";
    in property <AppColorScheme> selected-color-scheme: auto;
    in property <string> detected-language-name: "";
    in property <bool> hide-game-thumbnails: false;

    callback about-clicked;
    callback steam-cache-clicked;
    callback steam-shortcut-clicked;
    callback add-game-clicked;
    callback reset-settings-clicked;
    callback open-logs-folder-clicked;
    callback hide-game-thumbnails-changed(hide: bool);
    callback language-changed(value: string);
    callback color-scheme-changed(value: AppColorScheme);

    private property <string> menu-tooltip: @tr("appDropdownMenu" => "App menu");
    private property <bool> has-auto-language: root.detected-language-name != "";
    private property <[SelectOption]> language-options: root.has-auto-language ? [
        {
            label: @tr("appDropdownMenu" => "Auto-detected - {0}", root.detected-language-name),
            value: ""
        },
        { label: "English (US)", value: "en" },
        { label: "Deutsch (Deutschland)", value: "de" },
        { label: "Español (España)", value: "es" },
        { label: "Français (France)", value: "fr" },
        { label: "日本語", value: "ja" },
        { label: "한국어", value: "ko" },
        { label: "Português (Portugal)", value: "pt" },
        { label: "简体中文", value: "zh" },
        { label: "Wario (Waah!)", value: "wa" },
    ] : [
        { label: "English (US)", value: "en" },
        { label: "Deutsch (Deutschland)", value: "de" },
        { label: "Español (España)", value: "es" },
        { label: "Français (France)", value: "fr" },
        { label: "日本語", value: "ja" },
        { label: "한국어", value: "ko" },
        { label: "Português (Portugal)", value: "pt" },
        { label: "简体中文", value: "zh" },
        { label: "Wario (Waah!)", value: "wa" },
    ];
    private property <[SelectOption]> color-scheme-options: [
        { label: @tr("appDropdownMenu" => "Auto"), value: "auto" },
        { label: @tr("appDropdownMenu" => "Dark"), value: "dark" },
        { label: @tr("appDropdownMenu" => "Light"), value: "light" },
    ];

    pure function language-index() -> int {
        if root.selected-language == "" { return 0; }
        if root.selected-language == "en" { return root.has-auto-language ? 1 : 0; }
        if root.selected-language == "de" { return root.has-auto-language ? 2 : 1; }
        if root.selected-language == "es" { return root.has-auto-language ? 3 : 2; }
        if root.selected-language == "fr" { return root.has-auto-language ? 4 : 3; }
        if root.selected-language == "ja" { return root.has-auto-language ? 5 : 4; }
        if root.selected-language == "ko" { return root.has-auto-language ? 6 : 5; }
        if root.selected-language == "pt" { return root.has-auto-language ? 7 : 6; }
        if root.selected-language == "zh" { return root.has-auto-language ? 8 : 7; }
        if root.selected-language == "wa" { return root.has-auto-language ? 9 : 8; }
        return 0;
    }

    pure function color-scheme-index() -> int {
        if root.selected-color-scheme == AppColorScheme.dark { return 1; }
        if root.selected-color-scheme == AppColorScheme.light { return 2; }
        return 0;
    }

    NavButton {
        clicked => {
            menu.show();
        }

        SvgIcon {
            source: @image-url("../icons/ui/menu.svg");
            size: 24px;
            color: Theme.foreground;
        }
    }

    menu := PopupMenu {
        x: root.width - Theme.menu-width;
        y: root.height;

        PopupMenuItem {
            checkable: true;
            checked: !root.hide-game-thumbnails;
            text: @tr("appDropdownMenu" => "Show game thumbnails on list");

            clicked => {
                root.hide-game-thumbnails-changed(!root.hide-game-thumbnails);
                menu.close();
            }
        }

        PopupMenuSeparator { }

        PopupMenuItem {
            text: "About...";

            clicked => {
                root.about-clicked();
                menu.close();
            }
        }

        PopupMenuSeparator { }

        PopupMenuItem {
            text: @tr("steamCache" => "Reset Steam cache");

            clicked => {
                root.steam-cache-clicked();
                menu.close();
            }
        }

        PopupMenuItem {
            text: @tr("steamShortcut" => "Add Rai Pal to Steam library");

            clicked => {
                root.steam-shortcut-clicked();
                menu.close();
            }
        }

        PopupMenuItem {
            text: @tr("manualGames" => "Add games");

            clicked => {
                root.add-game-clicked();
                menu.close();
            }
        }

        PopupMenuSeparator { }

        PopupMenuItem {
            text: @tr("appDropdownMenu" => "Reset Rai Pal settings");

            clicked => {
                root.reset-settings-clicked();
                menu.close();
            }
        }

        PopupMenuItem {
            text: @tr("appDropdownMenu" => "Open Logs Folder");

            clicked => {
                root.open-logs-folder-clicked();
                menu.close();
            }
        }

        PopupMenuSeparator { }

        HorizontalLayout {
            padding-left: Theme.space-4;
            padding-right: Theme.space-4;

            SelectMenu {
                label: @tr("appDropdownMenu" => "Language");
                options: root.language-options;
                selected-index: root.language-index();

                selected(index) => {
                    root.language-changed(root.language-options[index].value);
                }
            }
        }

        PopupMenuSeparator { }

        HorizontalLayout {
            padding-left: Theme.space-4;
            padding-right: Theme.space-4;

            SelectMenu {
                label: @tr("appDropdownMenu" => "Color scheme");
                options: root.color-scheme-options;
                selected-index: root.color-scheme-index();

                selected(index) => {
                    if root.color-scheme-options[index].value == "light" {
                        root.color-scheme-changed(AppColorScheme.light);
                    } else if root.color-scheme-options[index].value == "dark" {
                        root.color-scheme-changed(AppColorScheme.dark);
                    } else {
                        root.color-scheme-changed(AppColorScheme.auto);
                    }
                }
            }
        }
    }

    Tooltip {
        text: @markdown("\{root.menu-tooltip}");
    }
}
