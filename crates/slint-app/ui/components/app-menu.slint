import { AppColorScheme } from "../app-types.slint";
import { Theme } from "../theme.slint";
import { NavButton } from "nav-button.slint";
import { PopupMenu, PopupMenuItem, PopupMenuSectionTitle, PopupMenuSeparator } from "menu.slint";

export component AppMenu inherits Rectangle {
    in property <string> selected-language: "";
    in property <AppColorScheme> selected-color-scheme: auto;
    in property <string> detected-language-name: "";
    in property <bool> hide-game-thumbnails: false;

    callback about-clicked;
    callback steam-cache-clicked;
    callback steam-shortcut-clicked;
    callback add-game-clicked;
    callback reset-settings-clicked;
    callback open-logs-folder-clicked;
    callback hide-game-thumbnails-changed(hide: bool);
    callback language-changed(value: string);
    callback color-scheme-changed(value: AppColorScheme);

    private property <string> menu-tooltip: @tr("appDropdownMenu" => "App menu");

    NavButton {
        icon: @image-url("../icons/ui/menu.svg");

        clicked => {
            menu.show();
        }
    }

    menu := PopupMenu {
        x: root.width - Theme.menu-width;
        y: root.height;

        PopupMenuItem {
            checkable: true;
            checked: !root.hide-game-thumbnails;
            text: @tr("appDropdownMenu" => "Show game thumbnails on list");

            clicked => {
                root.hide-game-thumbnails-changed(!root.hide-game-thumbnails);
            }
        }

        PopupMenuSeparator { }

        PopupMenuItem {
            text: "About...";

            clicked => {
                root.about-clicked();
            }
        }

        PopupMenuSeparator { }

        PopupMenuItem {
            text: @tr("steamCache" => "Reset Steam cache");

            clicked => {
                root.steam-cache-clicked();
            }
        }

        PopupMenuItem {
            text: @tr("steamShortcut" => "Add Rai Pal to Steam library");

            clicked => {
                root.steam-shortcut-clicked();
            }
        }

        PopupMenuItem {
            text: @tr("manualGames" => "Add games");

            clicked => {
                root.add-game-clicked();
            }
        }

        PopupMenuSeparator { }

        PopupMenuItem {
            text: @tr("appDropdownMenu" => "Reset Rai Pal settings");

            clicked => {
                root.reset-settings-clicked();
            }
        }

        PopupMenuItem {
            text: @tr("appDropdownMenu" => "Open Logs Folder");

            clicked => {
                root.open-logs-folder-clicked();
            }
        }

        PopupMenuSeparator { }

        PopupMenuSectionTitle {
            label: @tr("appDropdownMenu" => "Language");
        }

        if root.detected-language-name != "" : PopupMenuItem {
            checkable: true;
            checked: root.selected-language == "";
            text: @tr("appDropdownMenu" => "Auto-detected - {0}", root.detected-language-name);

            clicked => {
                root.language-changed("");
            }
        }

        PopupMenuItem {
            checkable: true;
            checked: root.selected-language == "en";
            text: "English (US)";

            clicked => {
                root.language-changed("en");
            }
        }

        PopupMenuItem {
            checkable: true;
            checked: root.selected-language == "de";
            text: "Deutsch (Deutschland)";

            clicked => {
                root.language-changed("de");
            }
        }

        PopupMenuItem {
            checkable: true;
            checked: root.selected-language == "es";
            text: "Español (España)";

            clicked => {
                root.language-changed("es");
            }
        }

        PopupMenuItem {
            checkable: true;
            checked: root.selected-language == "fr";
            text: "Français (France)";

            clicked => {
                root.language-changed("fr");
            }
        }

        PopupMenuItem {
            checkable: true;
            checked: root.selected-language == "ja";
            text: "日本語";

            clicked => {
                root.language-changed("ja");
            }
        }

        PopupMenuItem {
            checkable: true;
            checked: root.selected-language == "ko";
            text: "한국어";

            clicked => {
                root.language-changed("ko");
            }
        }

        PopupMenuItem {
            checkable: true;
            checked: root.selected-language == "pt";
            text: "Português (Portugal)";

            clicked => {
                root.language-changed("pt");
            }
        }

        PopupMenuItem {
            checkable: true;
            checked: root.selected-language == "zh";
            text: "简体中文";

            clicked => {
                root.language-changed("zh");
            }
        }

        PopupMenuItem {
            checkable: true;
            checked: root.selected-language == "wa";
            text: "Wario (Waah!)";

            clicked => {
                root.language-changed("wa");
            }
        }

        PopupMenuSeparator { }

        PopupMenuSectionTitle {
            label: @tr("appDropdownMenu" => "Color scheme");
        }

        PopupMenuItem {
            checkable: true;
            checked: root.selected-color-scheme == AppColorScheme.auto;
            text: @tr("appDropdownMenu" => "Auto");

            clicked => {
                root.color-scheme-changed(AppColorScheme.auto);
            }
        }

        PopupMenuItem {
            checkable: true;
            checked: root.selected-color-scheme == AppColorScheme.dark;
            text: @tr("appDropdownMenu" => "Dark");

            clicked => {
                root.color-scheme-changed(AppColorScheme.dark);
            }
        }

        PopupMenuItem {
            checkable: true;
            checked: root.selected-color-scheme == AppColorScheme.light;
            text: @tr("appDropdownMenu" => "Light");

            clicked => {
                root.color-scheme-changed(AppColorScheme.light);
            }
        }
    }

    Tooltip {
        text: @markdown("\{root.menu-tooltip}");
    }
}
