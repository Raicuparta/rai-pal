import { AppColorScheme } from "../app-types.slint";
import { Theme } from "../theme.slint";
import { NavButton } from "nav-button.slint";
import { Icon, SvgIcon } from "svg-icon.slint";
import { PopupMenu, PopupMenuItem, PopupMenuSeparator } from "menu.slint";
import { SelectMenu, SelectOption } from "select-menu.slint";
import { AppState, SteamToolsState } from "../state.slint";
import { AppActions } from "../actions.slint";

export component AppMenu inherits Rectangle {
    callback about-clicked;

    private property <string> menu-tooltip: @tr("appDropdownMenu" => "App menu");
    private property <bool> has-auto-language: AppState.detected-language-name != "";
    private property <[SelectOption]> language-options: root.has-auto-language ? [
        {
            label: @tr("appDropdownMenu" => "Auto-detected - {0}", AppState.detected-language-name),
            value: ""
        },
        { label: "English (US)", value: "en" },
        { label: "Deutsch (Deutschland)", value: "de" },
        { label: "Español (España)", value: "es" },
        { label: "Français (France)", value: "fr" },
        { label: "日本語", value: "ja" },
        { label: "한국어", value: "ko" },
        { label: "Português (Portugal)", value: "pt" },
        { label: "简体中文", value: "zh" },
        { label: "Wario (Waah!)", value: "wa" },
    ] : [
        { label: "English (US)", value: "en" },
        { label: "Deutsch (Deutschland)", value: "de" },
        { label: "Español (España)", value: "es" },
        { label: "Français (France)", value: "fr" },
        { label: "日本語", value: "ja" },
        { label: "한국어", value: "ko" },
        { label: "Português (Portugal)", value: "pt" },
        { label: "简体中文", value: "zh" },
        { label: "Wario (Waah!)", value: "wa" },
    ];
    private property <[SelectOption]> color-scheme-options: [
        { label: @tr("appDropdownMenu" => "Auto"), value: "auto" },
        { label: @tr("appDropdownMenu" => "Dark"), value: "dark" },
        { label: @tr("appDropdownMenu" => "Light"), value: "light" },
    ];

    pure function language-index() -> int {
        if AppState.selected-language == "" { return 0; }
        if AppState.selected-language == "en" { return root.has-auto-language ? 1 : 0; }
        if AppState.selected-language == "de" { return root.has-auto-language ? 2 : 1; }
        if AppState.selected-language == "es" { return root.has-auto-language ? 3 : 2; }
        if AppState.selected-language == "fr" { return root.has-auto-language ? 4 : 3; }
        if AppState.selected-language == "ja" { return root.has-auto-language ? 5 : 4; }
        if AppState.selected-language == "ko" { return root.has-auto-language ? 6 : 5; }
        if AppState.selected-language == "pt" { return root.has-auto-language ? 7 : 6; }
        if AppState.selected-language == "zh" { return root.has-auto-language ? 8 : 7; }
        if AppState.selected-language == "wa" { return root.has-auto-language ? 9 : 8; }
        return 0;
    }

    pure function color-scheme-index() -> int {
        if AppState.selected-color-scheme == AppColorScheme.dark { return 1; }
        if AppState.selected-color-scheme == AppColorScheme.light { return 2; }
        return 0;
    }

    NavButton {
        clicked => {
            menu.show();
        }

        SvgIcon {
            icon: Icon.menu;
            size: 24px;
            color: Theme.foreground;
        }
    }

    menu := PopupMenu {
        x: root.width - Theme.menu-width;
        y: root.height;

        VerticalLayout {
            padding-top: Theme.space-xs;
            padding-bottom: Theme.space-xs;

            PopupMenuItem {
                checkable: true;
                checked: !AppState.hide-game-thumbnails;
                text: @tr("appDropdownMenu" => "Show game thumbnails on list");

                clicked => {
                    AppState.hide-game-thumbnails = !AppState.hide-game-thumbnails;
                    AppActions.hide-game-thumbnails-changed(AppState.hide-game-thumbnails);
                    menu.close();
                }
            }

            PopupMenuSeparator { }

            PopupMenuItem {
                text: @tr("steamShortcut" => "Add Rai Pal to Steam library");
                icon: Icon.steam;

                clicked => {
                    SteamToolsState.shortcut-success = false;
                    SteamToolsState.shortcut-error = "";
                    SteamToolsState.shortcut-open = true;
                    menu.close();
                }
            }

            PopupMenuItem {
                text: @tr("steamCache" => "Reset Steam cache");

                clicked => {
                    SteamToolsState.cache-success = false;
                    SteamToolsState.cache-error = "";
                    SteamToolsState.cache-open = true;
                    menu.close();
                }
            }

            PopupMenuSeparator { }

            PopupMenuItem {
                text: @tr("appDropdownMenu" => "Reset Rai Pal settings");

                clicked => {
                    AppActions.reset-settings();
                    menu.close();
                }
            }

            PopupMenuItem {
                text: @tr("appDropdownMenu" => "Open Logs Folder");
                icon: Icon.folder;

                clicked => {
                    AppActions.open-logs-folder();
                    menu.close();
                }
            }

            PopupMenuSeparator { }

            VerticalLayout {
                padding-left: Theme.space-sm;
                padding-right: Theme.space-sm;
                padding-top: Theme.space-xs;
                padding-bottom: Theme.space-xs;
                spacing: Theme.space-2xs;

                Text {
                    text: @tr("appDropdownMenu" => "Language");
                    color: Theme.dimmed-foreground;
                    font-size: Theme.font-sm;
                }

                SelectMenu {
                    options: root.language-options;
                    selected-index: root.language-index();
                    icon: Icon.language;

                    selected(index) => {
                        AppState.selected-language = root.language-options[index].value;
                        AppActions.language-changed(AppState.selected-language);
                    }
                }
            }

            PopupMenuSeparator { }

            VerticalLayout {
                padding-left: Theme.space-sm;
                padding-right: Theme.space-sm;
                padding-top: Theme.space-xs;
                padding-bottom: Theme.space-xs;
                spacing: Theme.space-2xs;

                Text {
                    text: @tr("appDropdownMenu" => "Color scheme");
                    color: Theme.dimmed-foreground;
                    font-size: Theme.font-sm;
                }

                SelectMenu {
                    options: root.color-scheme-options;
                    selected-index: root.color-scheme-index();
                    icon: Theme.dark ? Icon.dark-mode : Icon.light-mode;

                    selected(index) => {
                        if root.color-scheme-options[index].value == "light" {
                            AppState.selected-color-scheme = AppColorScheme.light;
                        } else if root.color-scheme-options[index].value == "dark" {
                            AppState.selected-color-scheme = AppColorScheme.dark;
                        } else {
                            AppState.selected-color-scheme = AppColorScheme.auto;
                        }
                        AppActions.color-scheme-changed(AppState.selected-color-scheme);
                    }
                }
            }

            PopupMenuSeparator { }

            PopupMenuItem {
                text: "About...";
                icon: Icon.info;

                clicked => {
                    root.about-clicked();
                    menu.close();
                }
            }
        }
    }

    Tooltip {
        text: @markdown("\{root.menu-tooltip}");
    }
}
