import { Branding } from "../branding.slint";
import { GameRowView } from "../game-row-view.slint";
import { Fonts, Theme } from "../theme.slint";
import { ProviderIcon } from "provider-icon.slint";
import { SvgIcon } from "svg-icon.slint";
import { EngineIcon } from "engine-icon.slint";
import { HorizontalBox } from "std-widgets.slint";

export component GameRowView inherits Rectangle {
    in property <GameRowView> game-row;
    in property <int> row-index;
    in property <bool> show-thumbnail: true;

    private property <length> thumbnail-size: 60px;

    callback selected(index: int);

    height: Theme.game-row-height;
    background: touch-area.has-hover ? Theme.hover-background : Theme.background;

    HorizontalLayout {
        Rectangle {
            width: 30px;
            background: Branding.provider-background(game-row.provider-id);
            opacity: game-row.installed ? 1 : 0.5;

            VerticalLayout {
                alignment: center;
                cross-axis-alignment: center;
                spacing: Theme.space-2;

                ProviderIcon {
                    provider-id: game-row.provider-id;
                    icon-size: Theme.space-16;
                }

                SvgIcon {
                    source: game-row.installed ? @image-url("../icons/ui/game-installed.svg") : @image-url("../icons/ui/game-not-installed.svg");
                    color: game-row.installed && Theme.dark ? white : Theme.foreground;
                }
            }
        }

        if root.show-thumbnail: Rectangle {
            width: 100px;
            clip: true;
            background: Branding.provider-background(game-row.provider-id);
            opacity: game-row.installed ? 1 : 0.5;

            Image {
                source: @image-url("../images/fallback-thumbnail.png");
                width: root.thumbnail-size;
                height: root.thumbnail-size;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            if game-row.has-thumbnail: Image {
                source: game-row.thumbnail;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }
        }

        FlexboxLayout {
            horizontal-stretch: 1;
            padding: Theme.space-8;
            spacing: Theme.space-3;
            flex-wrap: wrap;
            alignment: start;
            cross-axis-self-alignment: center;

            Text {
                text: game-row.title;
                color: game-row.installed ? Theme.strong-foreground : Theme.foreground;
                font-weight: game-row.installed ? Theme.weight-bold : Theme.weight-normal;
                wrap: word-wrap;
            }

            for tag in game-row.tags: Rectangle {
                width: tag-text.preferred-width + Theme.space-6;
                height: tag-text.preferred-height + Theme.space-4;
                background: Theme.tag-background;
                border-radius: Theme.radius-3;

                tag-text := Text {
                    text: tag;
                    font-size: Theme.font-8;
                    font-weight: Theme.weight-light;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            width: 130px;
            // background: Branding.engine-background(game-row.engine-brand);
            clip: true;

            VerticalLayout {
                alignment: center;
                padding-left: Theme.space-8;
                padding-right: Theme.space-8;

                HorizontalLayout {
                    alignment: center;
                    spacing: Theme.space-4;
                    cross-axis-alignment: center;

                    EngineIcon {
                        engine-brand: game-row.engine-brand;
                    }

                    Text {
                        text: game-row.engine-brand == "" ? "-" : game-row.engine-brand.to-uppercase();
                        color: Branding.engine-foreground(game-row.engine-brand);
                        font-weight: Theme.weight-bold;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }

                if game-row.engine-version != "": Text {
                    text: game-row.engine-version;
                    horizontal-alignment: center;
                    color: Theme.foreground;
                    // opacity: 0.75;
                    font-family: Fonts.monospace-family;
                    font-size: Theme.font-10;
                    overflow: elide;
                }

                if game-row.engine-details != "": Text {
                    text: game-row.engine-details;
                    horizontal-alignment: center;
                    color: Theme.foreground;
                    opacity: 0.5;
                    font-size: Theme.font-10;
                    overflow: elide;
                }
            }
        }

        VerticalLayout {
            width: 80px;
            alignment: center;

            Text {
                text: game-row.release-day;
                font-size: Theme.font-10;
                horizontal-alignment: center;
                color: Theme.foreground;
            }

            Text {
                text: game-row.release-month;
                font-size: Theme.font-10;
                horizontal-alignment: center;
                overflow: elide;
                color: Theme.foreground;
            }

            Text {
                text: game-row.release-year;
                font-size: Theme.font-10;
                horizontal-alignment: center;
                color: Theme.foreground;
            }
        }
    }

    Rectangle {
        y: parent.height - self.height;
        height: 2px;
        background: Theme.row-divider;
    }

    touch-area := TouchArea {
        mouse-cursor: pointer;

        clicked => {
            root.selected(root.row-index);
        }
    }
}
