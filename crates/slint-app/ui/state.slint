import {
    AddGamePhase,
    AppColorScheme,
    AppTab,
    DownloadItemData,
    FilterGroupData,
    GameModData,
    GameRowData,
    ModsTabItemData,
    NotificationData,
    PatronData,
    PotentialModData,
    UrlModSourceData,
} from "app-types.slint";

export global AppState {
    in property <string> app-version: "";
    in property <string> renderer-name: "";
    in property <string> platform-name: "";

    in-out property <AppTab> current-tab: games;
    in-out property <string> selected-language: "";
    in-out property <AppColorScheme> selected-color-scheme: auto;
    in property <string> detected-language-name: "";
    in-out property <bool> hide-game-thumbnails: false;
    in-out property <bool> drop-highlight: false;
}

export global UserState {
    in property <bool> logged-in: false;
    in property <bool> busy: false;
    in property <string> name: "";
    in property <string> initials: "";
    in property <bool> has-avatar: false;
    in property <image> avatar;
}

export global Refresh {
    in-out property <bool> refreshing: false;
    in property <string> task-names: "";

    callback refresh-all;
}

export global GamesState {
    in property <[GameRowData]> rows;
    in property <int> total-count: 0;
    in-out property <string> search-text: "";
    in-out property <int> sort-index: 0;
    in property <[FilterGroupData]> filter-groups;
    in property <bool> filters-have-changes: false;
    in property <bool> filters-have-expanded: false;
}

export global SelectedGameState {
    in-out property <bool> active: false;
    in-out property <GameRowData> row;
    in property <string> provider-id: "";
    in property <bool> has-exe-path: false;
    in property <bool> show-wine-folders: false;
    in property <[string]> provider-actions;
    in property <[GameModData]> mods-installed;
    in property <[GameModData]> mods-available;
    in property <[GameModData]> mods-hidden;
    in property <[GameModData]> mods-incompatible;
    in property <[PotentialModData]> potential-mods;
}

export global ModsState {
    in property <[ModsTabItemData]> items;
}

export global DownloadsState {
    in property <[DownloadItemData]> items;
    in property <float> overall-progress: 0;
}

export global NotificationsState {
    in property <[NotificationData]> notifications;
}

export global ThanksState {
    in property <[PatronData]> patrons;
}

export global DebugState {
    in-out property <string> details-json: "";
}

export global AddGameState {
    in-out property <bool> open: false;
    in property <AddGamePhase> phase: idle;
    in property <string> selected-path: "";
    in property <int> scanned-dirs: 0;
    in property <int> executables-found: 0;
    in property <string> current-path: "";
    in property <int> games-count: 0;
    in property <string> duration-text: "";
    in-out property <string> directory: "";
    in property <[string]> manual-directories;
}

export global ModSourcesState {
    in-out property <bool> open: false;
    in property <UrlModSourceData> default-source;
    in property <[UrlModSourceData]> sources;
    in property <bool> toggling: false;
    in property <string> error: "";
    in-out property <string> new-url: "";

    in-out property <bool> confirm-open: false;
    in property <string> confirm-url: "";
    in property <bool> confirm-loading: false;
    in property <string> confirm-error: "";
    in property <[string]> confirm-mods;
    in property <bool> confirm-saving: false;
}

export global SteamToolsState {
    in-out property <bool> cache-open: false;
    in-out property <bool> cache-running: false;
    in-out property <bool> cache-success: false;
    in-out property <string> cache-error: "";

    in-out property <bool> shortcut-open: false;
    in-out property <bool> shortcut-running: false;
    in-out property <bool> shortcut-success: false;
    in-out property <string> shortcut-error: "";
}

export global UpdateState {
    in-out property <bool> open: false;
    in property <string> version: "";
    in property <string> notes: "";
    in property <bool> installing: false;
}

export global ConfirmationState {
    in-out property <bool> open: false;
    in property <string> text: "";
    in property <string> confirm-label: "";
    in property <bool> can-skip: false;
    in-out property <bool> dont-ask-again: false;
}
