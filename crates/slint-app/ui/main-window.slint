import { Palette } from "std-widgets.slint";
import { ActionState, ActionStates } from "action-state.slint";
import { AddGamePhase, AppColorScheme, AppTab, GameRowData } from "app-types.slint";
import { Fonts } from "theme.slint";
import { ModActions } from "actions.slint";
import { GamesSidebar } from "components/games-sidebar.slint";
import { GameSidebar } from "components/game-sidebar.slint";
import { GamesPage } from "components/games-page.slint";
import { GameDetailsPage } from "components/game-details-page.slint";
import { NavTab } from "components/nav-tab.slint";
import { AppMenu } from "components/app-menu.slint";
import { UserMenu } from "components/user-menu.slint";
import { DownloadProgress } from "components/download-progress.slint";
import { AboutPopup } from "components/about-popup.slint";
import { ModsPage } from "components/mods-page.slint";
import { ThanksPage } from "components/thanks-page.slint";
import { UrlModSourcesPopup } from "components/url-mod-sources-popup.slint";
import { ConfirmModSourcePopup } from "components/confirm-mod-source-popup.slint";
import { SteamCachePopup, SteamCacheState } from "components/steam-cache-popup.slint";
import { SteamShortcutPopup, SteamShortcutState } from "components/steam-shortcut-popup.slint";
import { AddGamePopup } from "components/add-game-popup.slint";
import { AppUpdatePopup } from "components/app-update-popup.slint";
import { ConfirmationPopup } from "components/confirmation-popup.slint";
import { NotificationsOverlay } from "components/notifications.slint";
import { GameDetailsPopup } from "components/game-details-popup.slint";
import { AddGameState } from "components/add-game-popup.slint";
import { AppSettings } from "settings.slint";
import { AppActions, DialogActions } from "actions.slint";
import { Theme } from "theme.slint";
import { Icon } from "components/svg-icon.slint";

export {
    ActionState,
    ActionStates,
    AddGamePhase,
    AppColorScheme,
    AppTab,
    Fonts,
    ModActions,
}
export { AppInfo } from "components/about-popup.slint";
export { AppSettings } from "settings.slint";
export { Refresh } from "components/refresh-button.slint";
export { GamesList } from "components/games-page.slint";
export { GamesQuery } from "components/games-sidebar.slint";
export { GameSidebarState } from "components/game-sidebar.slint";
export { GameMods } from "components/game-details-page.slint";
export { UserState } from "components/user-menu.slint";
export { ModsState } from "components/mods-page.slint";
export { DownloadsState } from "components/download-progress.slint";
export { NotificationsState } from "components/notifications.slint";
export { ThanksState } from "components/thanks-page.slint";
export { DebugState } from "components/game-details-popup.slint";
export { AddGameState } from "components/add-game-popup.slint";
export { ModSourcesState } from "components/url-mod-sources-popup.slint";
export { ConfirmModSourceState } from "components/confirm-mod-source-popup.slint";
export { SteamCacheState } from "components/steam-cache-popup.slint";
export { SteamShortcutState } from "components/steam-shortcut-popup.slint";
export { UpdateState } from "components/app-update-popup.slint";
export { ConfirmationState } from "components/confirmation-popup.slint";
export { AppActions, GamesActions, DialogActions } from "actions.slint";

export component MainWindow inherits Window {
    title: root.window-title;
    in property <string> window-title: "Rai Pal";
    in-out property <AppTab> current-tab: games;
    in-out property <bool> drop-highlight: false;
    in-out property <bool> game-selected: false;
    in-out property <GameRowData> selected-game-row;
    icon: @image-url("../graphics/icon.png");
    preferred-width: 1100px;
    preferred-height: 700px;
    min-width: 800px;
    min-height: 500px;
    background: Theme.background;

    private property <length> content-max-width: 1140px;
    private property <bool> about-open: false;
    private property <bool> url-mod-sources-open: false;
    private property <bool> steam-cache-open: false;
    private property <bool> steam-shortcut-open: false;
    private property <AppColorScheme> color-scheme: AppSettings.selected-color-scheme;

    function select-tab(tab: AppTab) {
        root.current-tab = tab;
        AppActions.tab-changed(tab);
    }

    function apply-color-scheme() {
        if root.color-scheme == AppColorScheme.dark {
            Palette.color-scheme = ColorScheme.dark;
        } else if root.color-scheme == AppColorScheme.light {
            Palette.color-scheme = ColorScheme.light;
        } else {
            Palette.color-scheme = ColorScheme.unknown;
        }
    }

    function open-steam-cache() {
        SteamCacheState.state = ActionState.idle;
        SteamCacheState.error = "";
        root.steam-cache-open = true;
    }

    function open-steam-shortcut() {
        SteamShortcutState.state = ActionState.idle;
        SteamShortcutState.error = "";
        root.steam-shortcut-open = true;
    }

    init => {
        root.apply-color-scheme();
    }

    changed color-scheme => {
        root.apply-color-scheme();
    }

    VerticalLayout {
        Rectangle {
            background: Theme.background;
            vertical-stretch: 0;

            Rectangle {
                y: parent.height - self.height;
                height: Theme.border-width;
                background: Theme.border;
            }

            VerticalLayout {
                cross-axis-alignment: center;

                HorizontalLayout {
                    width: 100%;
                    max-width: root.content-max-width;
                    padding-left: Theme.space-sm;
                    padding-right: Theme.space-sm;
                    spacing: Theme.space-2xs;
                    cross-axis-alignment: center;

                    NavTab {
                        title: @tr("tab" => "Games");
                        icon: Icon.games;
                        selected: root.current-tab == AppTab.games;

                        clicked => {
                            root.select-tab(AppTab.games);
                        }
                    }

                    NavTab {
                        title: @tr("tab" => "Mods");
                        icon: Icon.mods;
                        selected: root.current-tab == AppTab.mods;

                        clicked => {
                            root.select-tab(AppTab.mods);
                        }
                    }

                    NavTab {
                        title: @tr("tab" => "Thanks");
                        icon: Icon.thanks;
                        icon-color: #c92a2a;
                        selected: root.current-tab == AppTab.thanks;

                        clicked => {
                            root.select-tab(AppTab.thanks);
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    DownloadProgress { }

                    UserMenu { }

                    AppMenu {
                        about-clicked => {
                            root.about-open = true;
                        }

                        steam-cache-clicked => {
                            root.open-steam-cache();
                        }

                        steam-shortcut-clicked => {
                            root.open-steam-shortcut();
                        }
                    }
                }
            }
        }

        Rectangle {
            Rectangle {
                visible: root.current-tab == AppTab.games;
                width: min(parent.width, root.content-max-width);
                x: (parent.width - self.width) / 2;

                HorizontalLayout {
                    visible: root.game-selected;

                    GameSidebar { }

                    GameDetailsPage {
                        game-row: root.selected-game-row;
                        show-thumbnail: !AppSettings.hide-game-thumbnails;
                    }
                }

                HorizontalLayout {
                    visible: !root.game-selected;

                    GamesSidebar {
                        add-game-clicked => {
                            AddGameState.open = true;
                            DialogActions.request-add-game();
                        }
                    }

                    GamesPage { }
                }
            }

            Rectangle {
                visible: root.current-tab == AppTab.mods;
                width: min(parent.width, root.content-max-width);
                x: (parent.width - self.width) / 2;

                ModsPage {
                    open-url-mod-sources-clicked => {
                        root.url-mod-sources-open = true;
                        DialogActions.request-url-mod-sources();
                    }
                }
            }

            Rectangle {
                visible: root.current-tab == AppTab.thanks;
                width: min(parent.width, root.content-max-width);
                x: (parent.width - self.width) / 2;

                ThanksPage { }
            }
        }
    }

    NotificationsOverlay { }

    if root.drop-highlight: Rectangle {
        border-width: Theme.border-width * 2;
        border-color: Theme.highlight;
        background: transparent;
    }

    ConfirmationPopup { }

    GameDetailsPopup { }

    AboutPopup {
        open: root.about-open;

        closed => {
            root.about-open = false;
        }
    }

    SteamShortcutPopup {
        open: root.steam-shortcut-open;

        closed => {
            root.steam-shortcut-open = false;
        }
    }

    AppUpdatePopup { }

    AddGamePopup { }

    SteamCachePopup {
        open: root.steam-cache-open;

        closed => {
            root.steam-cache-open = false;
        }
    }

    UrlModSourcesPopup {
        open: root.url-mod-sources-open;

        closed => {
            root.url-mod-sources-open = false;
        }
    }

    ConfirmModSourcePopup { }
}
